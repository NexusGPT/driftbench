import { readFile } from 'node:fs/promises';
import { join } from 'node:path';
import { ClaudeCodeReader, pointer, scanEstate } from '../packages/estate/src/index';
const ROOT = new URL('../examples/estates/', import.meta.url).pathname;
const [dir, needle] = [process.argv[2] as string, process.argv[3] as string];
const sets = pointer.parseLabelSets(pointer.DEFAULT_LABEL_SETS);
if (!sets.ok) throw new Error(sets.message);
const specs = pointer.DEFAULT_LABELER_SPECS.map((t) => { const s = pointer.parseLabelerSpec(t); if (!s.ok) throw new Error(s.message); return s.spec; });
const built = await pointer.buildLabelling(specs, { env: {}, record: false, cwd: join(ROOT, dir) });
if (!built.ok) throw new Error(built.message);
const cassette = pointer.Cassette.parse(await readFile(join(ROOT, dir, 'cassette.jsonl'), 'utf8'));
const r = await scanEstate({ root: join(ROOT, dir), reader: new ClaudeCodeReader(), now: () => new Date('2026-10-11T00:00:00.000Z'), pointer: { sets: sets.sets, labelling: built.labelling, cassette, mode: 'replay' } });
const p = r.pointer as any;
for (const u of p.labelled) if (u.unit.text.includes(needle)) console.log('LABELLED', u.set?.set, u.label, JSON.stringify(u.spans ?? []), JSON.stringify(u.links ?? []), 'target', u.target?.n);
console.log('DECIDED sets of this unit:', p.labelled.filter((u: any) => u.unit.text.includes(needle)).length);
for (const l of [...(p.refusals ?? []), ...(p.atomRefusals ?? []), ...(p.dropped ?? [])]) if (l.includes(needle.slice(0, 20)) || l.includes('SKILL.md')) console.log('NOTE', l.slice(0, 260));
console.log('unlabeled', p.unlabeled);
console.log('KEYS', Object.keys(p).join(','));
for (const k of ['labelled', 'plan', 'cuts', 'split', 'spanSplit', 'voted', 'fellBack']) { const v = p[k]; console.log(k, Array.isArray(v) ? v.length : typeof v === 'object' ? JSON.stringify(v).slice(0, 200) : v); }
const cuts = p.cuts as any[]; 
for (const u of p.labelled) if (u.unit.text.includes(needle)) console.log('ITEM', u.label, JSON.stringify(u.spans ?? []).slice(0,200));
const dec = p.decided as Map<string, unknown> | undefined; console.log('decided type', typeof dec);
const led = p.ledger as any; const ents = (led?.entries ?? []) as any[];
const hit = ents.filter((e) => String(e.quote ?? '').includes(needle));
console.log('LEDGER', JSON.stringify(hit.map((e) => ({ id: e.id, path: e.path, status: e.status }))));
console.log('LABELLED idx near:', p.labelled.filter((u: any) => u.path === 'CLAUDE.md').map((u: any) => u.index + ':' + u.label).join(' '));
const L = p.labelled.find((u: any) => u.id === 'zibad5mquq'); console.log('FJORD', JSON.stringify(L ? { idx: L.index, label: L.label, set: L.set?.set } : null));
const dec2 = p.decided as any; console.log('DEC', typeof dec2, dec2 && dec2.get ? JSON.stringify(dec2.get('zibad5mquq') ?? dec2.get('agent-rules:zibad5mquq')) : JSON.stringify(dec2)?.slice(0, 300));
console.log('REFUSALS', (p.refusals as string[]).filter((x) => x.includes('zibad') ).join(' | '), (p.atomRefusals as string[]).filter((x) => x.includes('zibad')).join(' | '));
console.log('ENTRY', JSON.stringify(hit[0]).slice(0, 300));
