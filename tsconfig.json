{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "benchmarks/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "examples/*/src/**/*.ts",
    "examples/*/test/**/*.ts",
    "examples/variables/conditions/record-frozen3.ts",
    "examples/variables/conditions/round2-dev-final.ts",
    "tools/docs/**/*.ts",
    "tools/browser/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["examples/judge-benchmarks"]
}
