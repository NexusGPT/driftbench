{
  "name": "@agent-nexus/driftbench-estate",
  "version": "0.1.0",
  "description": "Test a code-interpreter agent as a whole estate: atoms, the estate graph, lint, plans, mutants and maintenance.",
  "keywords": [
    "driftbench",
    "ai-agents",
    "evaluation",
    "llm",
    "testing",
    "code-agent",
    "estate",
    "mutation-testing"
  ],
  "homepage": "https://github.com/NexusGPT/driftbench#readme",
  "bugs": {
    "url": "https://github.com/NexusGPT/driftbench/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NexusGPT/driftbench.git",
    "directory": "packages/estate"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./labeler-contract": {
      "types": "./dist/labeler-contract.d.ts",
      "import": "./dist/labeler-contract.js"
    }
  },
  "files": [
    "NOTICE",
    "THIRD_PARTY_LICENSES.md",
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/labeler-contract.ts --format esm --dts --clean --target node22 --external vitest"
  },
  "dependencies": {
    "@agent-nexus/driftbench-core": "workspace:*",
    "@agent-nexus/driftbench-generate": "workspace:*",
    "@agent-nexus/driftbench-sandbox": "workspace:*",
    "@agent-nexus/driftbench-space": "workspace:*",
    "@agent-nexus/driftbench-stats": "workspace:*",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
