{
  "name": "@agent-nexus/driftbench-estate",
  "version": "0.1.0",
  "description": "Test a code-interpreter agent as a whole estate: atoms, the estate graph, lint, plans, mutants and maintenance.",
  "keywords": [
    "driftbench",
    "ai-agents",
    "evaluation",
    "llm",
    "testing",
    "code-agent",
    "estate",
    "mutation-testing"
  ],
  "homepage": "https://github.com/achammah/driftbench#readme",
  "bugs": {
    "url": "https://github.com/achammah/driftbench/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/achammah/driftbench.git",
    "directory": "packages/estate"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --target node22"
  },
  "dependencies": {
    "@agent-nexus/driftbench-core": "workspace:*",
    "@agent-nexus/driftbench-space": "workspace:*",
    "@agent-nexus/driftbench-stats": "workspace:*",
    "zod": "^4.6.5",
    "yaml": "^2.9.1",
    "@agent-nexus/driftbench-generate": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
