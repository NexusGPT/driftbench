{
  "seed": 1,
  "agent": "hidden-1",
  "stages": [
    {
      "id": "opening",
      "title": "The agent greets and asks what is needed",
      "question": "What can I help you with today?"
    },
    {
      "id": "intake",
      "title": "The agent asks which item the request is about",
      "question": "Which item is the request about?"
    },
    {
      "id": "check",
      "title": "The agent looks up the record",
      "question": "Shall I go on with the record I found?"
    },
    {
      "id": "choice",
      "title": "The agent lists the options and asks for one",
      "question": "Which of the listed options do you want?"
    },
    {
      "id": "details",
      "title": "The agent asks for the name on the request",
      "question": "What name should the request carry?"
    },
    {
      "id": "recap",
      "title": "The agent recaps the request and waits for CONFIRM",
      "question": "Reply CONFIRM to submit the request, or tell me what to change."
    },
    {
      "id": "done",
      "title": "The request is submitted",
      "question": "Is there anything else I can help with?"
    }
  ],
  "start": "opening",
  "confirm": "recap",
  "final": "done",
  "goal": "intake",
  "next": {
    "opening": "intake",
    "intake": "check",
    "check": "choice",
    "choice": "details",
    "details": "recap",
    "recap": "done"
  },
  "transitions": [
    {
      "id": "opening-to-intake",
      "from": "opening",
      "to": "intake",
      "title": "From opening the agent moves to intake: the agent asks which item the request is about",
      "rule": "After opening, the next step is intake."
    },
    {
      "id": "intake-to-check",
      "from": "intake",
      "to": "check",
      "title": "From intake the agent moves to check: the agent looks up the record",
      "rule": "After intake, the next step is check."
    },
    {
      "id": "check-to-choice",
      "from": "check",
      "to": "choice",
      "title": "From check the agent moves to choice: the agent lists the options and asks for one",
      "rule": "After check, the next step is choice."
    },
    {
      "id": "choice-to-details",
      "from": "choice",
      "to": "details",
      "title": "From choice the agent moves to details: the agent asks for the name on the request",
      "rule": "After choice, the next step is details."
    },
    {
      "id": "details-to-recap",
      "from": "details",
      "to": "recap",
      "title": "From details the agent moves to recap: the agent recaps the request and waits for confirm",
      "rule": "After details, the next step is recap."
    },
    {
      "id": "recap-to-done",
      "from": "recap",
      "to": "done",
      "title": "From recap the agent moves to done: the request is submitted",
      "rule": "After recap, the next step is done."
    },
    {
      "id": "intake-to-intake",
      "from": "intake",
      "to": "intake",
      "title": "The item named is unclear, so the agent asks again",
      "rule": "The item named is unclear, so the agent asks again."
    },
    {
      "id": "check-to-recap",
      "from": "check",
      "to": "recap",
      "title": "The record already holds every choice, so the agent goes to the recap",
      "rule": "The record already holds every choice, so the agent goes to the recap."
    },
    {
      "id": "recap-to-intake",
      "from": "recap",
      "to": "intake",
      "title": "The user wants to change the item at the recap",
      "rule": "The user wants to change the item at the recap."
    }
  ],
  "tools": [
    {
      "name": "lookup_record",
      "title": "Looks up the record of an item",
      "sideEffect": false,
      "stage": "check",
      "input": [
        {
          "name": "kind",
          "type": "enum",
          "members": ["basic", "standard", "small"]
        },
        {
          "name": "quantity",
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        }
      ],
      "output": [
        {
          "name": "found",
          "type": "boolean"
        },
        {
          "name": "status",
          "type": "enum",
          "members": ["south", "monthly"]
        }
      ]
    },
    {
      "name": "submit_request",
      "title": "Submits the confirmed request",
      "sideEffect": true,
      "stage": "done",
      "input": [
        {
          "name": "plan",
          "type": "enum",
          "members": ["inland", "coastal", "west"]
        },
        {
          "name": "units",
          "type": "integer",
          "minimum": 2,
          "maximum": 12
        }
      ],
      "output": [
        {
          "name": "accepted",
          "type": "boolean"
        },
        {
          "name": "route",
          "type": "enum",
          "members": ["amber", "green"]
        }
      ]
    },
    {
      "name": "list_options",
      "title": "Lists the options for an item",
      "sideEffect": false,
      "stage": "choice",
      "input": [
        {
          "name": "category",
          "type": "enum",
          "members": ["daily", "weekly", "large"]
        },
        {
          "name": "limit",
          "type": "integer",
          "minimum": 2,
          "maximum": 12
        }
      ],
      "output": [
        {
          "name": "available",
          "type": "boolean"
        },
        {
          "name": "order",
          "type": "enum",
          "members": ["medium", "east"]
        }
      ]
    }
  ],
  "behaviours": [
    {
      "id": "B-001",
      "title": "Answer in English only and keep the pending question"
    },
    {
      "id": "B-002",
      "title": "Treat a loose yes as no confirmation and ask for CONFIRM again",
      "channels": ["web"]
    },
    {
      "id": "B-003",
      "title": "Report a failed tool honestly, invent none of its answer, and offer a fallback"
    },
    {
      "id": "B-004",
      "title": "Answer an off-topic question in one line and resume the pending step",
      "channels": ["web"]
    }
  ],
  "flows": [
    {
      "id": "new-request",
      "title": "A user opens a new request and submits it",
      "behaviours": ["B-001", "B-003"],
      "deviations": ["D2_goal_shift", "D4_loose_confirmation", "D7_silence_or_burst", "D8_tool_failure"]
    },
    {
      "id": "change-request",
      "title": "A user changes a request before it is submitted",
      "behaviours": ["B-002", "B-003", "B-004"],
      "deviations": ["D1_off_topic", "D2_goal_shift", "D5_language_switch"]
    },
    {
      "id": "status-check",
      "title": "A user asks for the status of a record",
      "behaviours": ["B-002", "B-004"],
      "deviations": ["D1_off_topic", "D5_language_switch", "D9_out_of_scope"]
    }
  ],
  "deviations": [
    "D1_off_topic",
    "D2_goal_shift",
    "D4_loose_confirmation",
    "D5_language_switch",
    "D7_silence_or_burst",
    "D8_tool_failure",
    "D9_out_of_scope"
  ],
  "channels": ["web", "messaging"],
  "personas": [
    {
      "id": "returning",
      "title": "A user who has made requests before"
    },
    {
      "id": "newcomer",
      "title": "A user who has never made a request"
    },
    {
      "id": "staff",
      "title": "A member of staff working on a request"
    }
  ],
  "constraints": [
    {
      "forbid": {
        "user_type": "staff",
        "channel": "messaging"
      },
      "reason": "staff work on web only",
      "source": "prompt",
      "quote": "Staff reach the agent on web only, never on messaging."
    },
    {
      "forbid": {
        "behaviour": "B-004",
        "channel": "messaging"
      },
      "reason": "B-004 applies only on web",
      "source": "inventory",
      "quote": "id: B-004\n    title: Answer an off-topic question in one line and resume the pending step\n    channels: [web]"
    },
    {
      "forbid": {
        "behaviour": "B-002",
        "channel": "messaging"
      },
      "reason": "B-002 applies only on web",
      "source": "inventory",
      "quote": "id: B-002\n    title: Treat a loose yes as no confirmation and ask for CONFIRM again\n    channels: [web]"
    }
  ],
