{
  "name": "@agent-nexus/driftbench-artifacts",
  "version": "0.1.0",
  "description": "Readers for the files a code agent produces (xlsx, docx, pptx, pdf, csv, json, text, code), answering artifact checks with evidence.",
  "keywords": [
    "driftbench",
    "ai-agents",
    "evaluation",
    "llm",
    "testing",
    "artifacts",
    "xlsx",
    "docx",
    "pptx",
    "pdf"
  ],
  "homepage": "https://github.com/NexusGPT/driftbench#readme",
  "bugs": {
    "url": "https://github.com/NexusGPT/driftbench/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NexusGPT/driftbench.git",
    "directory": "packages/artifacts"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "NOTICE",
    "THIRD_PARTY_LICENSES.md",
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --target node22 --external exceljs --external mammoth"
  },
  "dependencies": {
    "@agent-nexus/driftbench-core": "workspace:*",
    "jszip": "^3.10.2",
    "pdf-parse": "^2.4.5"
  },
  "optionalDependencies": {
    "exceljs": "^4.4.0",
    "mammoth": "^1.13.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
