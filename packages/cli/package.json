{
  "name": "@driftbench/cli",
  "version": "0.1.0",
  "description": "The driftbench command line: validate and run specs, campaigns in teacher-forced, free-running and perturbed modes, reports, generation and validators.",
  "keywords": [
    "driftbench",
    "ai-agents",
    "evaluation",
    "llm",
    "testing",
    "cli",
    "command-line",
    "continuous-integration"
  ],
  "homepage": "https://github.com/achammah/driftbench#readme",
  "bugs": {
    "url": "https://github.com/achammah/driftbench/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/achammah/driftbench.git",
    "directory": "packages/cli"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "driftbench": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm --dts --clean --target node22"
  },
  "dependencies": {
    "@driftbench/core": "workspace:*",
    "commander": "^15.0.0",
    "@driftbench/users": "workspace:*",
    "@driftbench/store": "workspace:*",
    "@driftbench/adapters": "workspace:*",
    "@driftbench/checks": "workspace:*",
    "@driftbench/artifacts": "workspace:*",
    "@driftbench/sandbox": "workspace:*",
    "@driftbench/space": "workspace:*",
    "@driftbench/generate": "workspace:*",
    "@driftbench/estate": "workspace:*",
    "@driftbench/judges": "workspace:*",
    "@driftbench/stats": "workspace:*",
    "@driftbench/validators": "workspace:*",
    "@driftbench/report": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
