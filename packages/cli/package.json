{
  "name": "@agent-nexus/driftbench",
  "version": "0.1.0",
  "description": "The driftbench command line: validate and run specs, campaigns in teacher-forced, free-running and perturbed modes, reports, generation and validators.",
  "keywords": [
    "driftbench",
    "ai-agents",
    "evaluation",
    "llm",
    "testing",
    "cli",
    "command-line",
    "continuous-integration"
  ],
  "homepage": "https://github.com/NexusGPT/driftbench#readme",
  "bugs": {
    "url": "https://github.com/NexusGPT/driftbench/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NexusGPT/driftbench.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "driftbench": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "NOTICE",
    "THIRD_PARTY_LICENSES.md",
    "dist",
    "help"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm --dts --clean --target node22"
  },
  "dependencies": {
    "@agent-nexus/driftbench-adapters": "workspace:*",
    "@agent-nexus/driftbench-artifacts": "workspace:*",
    "@agent-nexus/driftbench-checks": "workspace:*",
    "@agent-nexus/driftbench-core": "workspace:*",
    "@agent-nexus/driftbench-estate": "workspace:*",
    "@agent-nexus/driftbench-generate": "workspace:*",
    "@agent-nexus/driftbench-judges": "workspace:*",
    "@agent-nexus/driftbench-report": "workspace:*",
    "@agent-nexus/driftbench-sandbox": "workspace:*",
    "@agent-nexus/driftbench-space": "workspace:*",
    "@agent-nexus/driftbench-stats": "workspace:*",
    "@agent-nexus/driftbench-store": "workspace:*",
    "@agent-nexus/driftbench-users": "workspace:*",
    "@agent-nexus/driftbench-validators": "workspace:*",
    "commander": "^15.0.0",
    "yaml": "^2.9.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
