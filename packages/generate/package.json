{
  "name": "@agent-nexus/driftbench-generate",
  "version": "0.1.0",
  "description": "Generate driftbench tests from a map of situations: extraction proposal, the deterministic block generator, the validity gate, reference sets and holdout.",
  "keywords": [
    "driftbench",
    "ai-agents",
    "evaluation",
    "llm",
    "testing",
    "test-generation",
    "combinatorial",
    "coverage"
  ],
  "homepage": "https://github.com/NexusGPT/driftbench#readme",
  "bugs": {
    "url": "https://github.com/NexusGPT/driftbench/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NexusGPT/driftbench.git",
    "directory": "packages/generate"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "NOTICE",
    "THIRD_PARTY_LICENSES.md",
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --target node22"
  },
  "dependencies": {
    "@agent-nexus/driftbench-adapters": "workspace:*",
    "@agent-nexus/driftbench-artifacts": "workspace:*",
    "@agent-nexus/driftbench-core": "workspace:*",
    "@agent-nexus/driftbench-space": "workspace:*",
    "@agent-nexus/driftbench-stats": "workspace:*",
    "@agent-nexus/driftbench-users": "workspace:*",
    "smol-toml": "1.3.1",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@agent-nexus/driftbench-checks": "workspace:*",
    "@agent-nexus/driftbench-sandbox": "workspace:*",
    "@agent-nexus/driftbench-store": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
