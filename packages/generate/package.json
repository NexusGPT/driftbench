{
  "name": "@driftbench/generate",
  "version": "0.1.0",
  "description": "Generate driftbench tests from a map of situations: extraction proposal, the deterministic block generator, the validity gate, reference sets and holdout.",
  "keywords": [
    "driftbench",
    "ai-agents",
    "evaluation",
    "llm",
    "testing",
    "test-generation",
    "combinatorial",
    "coverage"
  ],
  "homepage": "https://github.com/achammah/driftbench#readme",
  "bugs": {
    "url": "https://github.com/achammah/driftbench/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/achammah/driftbench.git",
    "directory": "packages/generate"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --target node22"
  },
  "dependencies": {
    "@driftbench/adapters": "workspace:*",
    "@driftbench/artifacts": "workspace:*",
    "@driftbench/checks": "workspace:*",
    "@driftbench/core": "workspace:*",
    "@driftbench/sandbox": "workspace:*",
    "@driftbench/space": "workspace:*",
    "@driftbench/stats": "workspace:*",
    "@driftbench/store": "workspace:*",
    "@driftbench/users": "workspace:*",
    "smol-toml": "1.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
