{
  "name": "@agent-nexus/driftbench-report",
  "version": "0.1.0",
  "description": "Scorecards, run comparisons, spread views, HTML, text and JUnit output from a stored driftbench campaign.",
  "keywords": [
    "driftbench",
    "ai-agents",
    "evaluation",
    "llm",
    "testing",
    "report",
    "scorecard",
    "junit"
  ],
  "homepage": "https://github.com/NexusGPT/driftbench#readme",
  "bugs": {
    "url": "https://github.com/NexusGPT/driftbench/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NexusGPT/driftbench.git",
    "directory": "packages/report"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "NOTICE",
    "THIRD_PARTY_LICENSES.md",
    "dist",
    "fonts"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --target node22"
  },
  "dependencies": {
    "@agent-nexus/driftbench-core": "workspace:*",
    "@agent-nexus/driftbench-stats": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@agent-nexus/driftbench-store": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
