{
  "name": "@agent-nexus/driftbench-sandbox",
  "version": "0.1.0",
  "description": "The workspace a code agent works in for one driftbench run: a local folder or a docker container, with snapshots, diffs and bounded commands.",
  "keywords": [
    "driftbench",
    "ai-agents",
    "evaluation",
    "llm",
    "testing",
    "sandbox",
    "docker",
    "code-agent"
  ],
  "homepage": "https://github.com/NexusGPT/driftbench#readme",
  "bugs": {
    "url": "https://github.com/NexusGPT/driftbench/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NexusGPT/driftbench.git",
    "directory": "packages/sandbox"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "NOTICE",
    "THIRD_PARTY_LICENSES.md",
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --target node22"
  },
  "dependencies": {
    "@agent-nexus/driftbench-core": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
