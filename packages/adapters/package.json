{
  "name": "@agent-nexus/driftbench-adapters",
  "version": "0.1.0",
  "description": "The adapters that connect driftbench to the agent under test: function, http, process, nexus and agent SDKs, with the contract suite every adapter passes.",
  "keywords": [
    "driftbench",
    "ai-agents",
    "evaluation",
    "llm",
    "testing",
    "adapter",
    "agents",
    "openai-agents",
    "langgraph"
  ],
  "homepage": "https://github.com/achammah/driftbench#readme",
  "bugs": {
    "url": "https://github.com/achammah/driftbench/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/achammah/driftbench.git",
    "directory": "packages/adapters"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js"
    }
  },
  "files": [
    "NOTICE",
    "THIRD_PARTY_LICENSES.md",
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/contract.ts --format esm --dts --clean --target node22 --external vitest"
  },
  "dependencies": {
    "@agent-nexus/driftbench-core": "workspace:*",
    "@agent-nexus/driftbench-sandbox": "workspace:*"
  },
  "devDependencies": {
    "@agent-nexus/driftbench-checks": "workspace:*"
  },
  "peerDependencies": {
    "@agent-nexus/driftbench-checks": "workspace:*",
    "@anthropic-ai/sdk": ">=0.133.0",
    "@google/genai": ">=2.28.0",
    "@langchain/langgraph": ">=1.4.21",
    "@openai/agents": ">=0.20.0",
    "ai": ">=7.0.137",
    "openai": ">=7.32.0",
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "@agent-nexus/driftbench-checks": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@google/genai": {
      "optional": true
    },
    "@langchain/langgraph": {
      "optional": true
    },
    "@openai/agents": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "openai": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
