{"key":"5e2c709249bf85cdacfcec4499d86f26e03fbd24086f031b4a98d53df8e50a29#1","quote":"Write them down one by one in the ticket.","text":"{\"limits\": []}","usage":{"input":679,"output":9}}
{"key":"14e5184ce713bd450d5465a3201b5b1703537bb2996ed1aee29d24018711282a#1","quote":"The customer has the original box","text":"{\"limits\": []}","usage":{"input":781,"output":9}}
{"key":"59e23408349c67b7c651beda1c599add79129748b539d0c2e1826471d1e5e60a#1","quote":"The customer lost the power adapter","text":"{\"limits\": []}","usage":{"input":790,"output":9}}
{"key":"13df83fecbac027bf17c6ebfe28d032f2c9e556b9781ddacfaef36dfc3c59d1d#1","quote":"Note it on the ticket and say a fee may apply","text":"{\"limits\": []}","usage":{"input":796,"output":9}}
{"key":"386c33180c864d3fb76981cd1d30ce92f66d58eb409faad796614b65dee0be5c#1","quote":"The customer lost the router","text":"{\"limits\": []}","usage":{"input":791,"output":9}}
{"key":"991a215d5c66f215bc64f04b3baccee3b850ae41d036f84154bffbd77542dd1b#1","quote":"Do not promise to waive the fee; send the ticket to billing","text":"{\"limits\": []}","usage":{"input":804,"output":9}}
{"key":"214d82cfcfffa5e6154aa5a72bbfd893881a8c5a6bae9de4c1d3dfe8be578e4b#1","quote":"Ask for a photo and attach it to the ticket","text":"{\"limits\": []}","usage":{"input":788,"output":9}}
{"key":"36de83a642e34f646b5d1253ca69eeb33675ab093fa69da8f4313c5ba54b7355#1","quote":"Mention them only if the customer asks what happens when equipment is lost.","text":"{\"limits\": []}","usage":{"input":681,"output":9}}
{"key":"2cfd9a7bd1ce6f1f1bb28670eeb5be795756b4f735c468ff3cf27c03cebcf1bc#1","quote":"The router is damaged","text":"{\"limits\": []}","usage":{"input":778,"output":9}}
{"key":"30fd80639fb6ab20aed576ff37bfc87c2dd738f0ae96cbd9eca8af0310e36c12#1","quote":"If the customer asks where it is, look it up.","text":"{\"limits\": []}","usage":{"input":665,"output":9}}
{"key":"7fff5a603c566706dbc77f7bdfcfc1e9e5c285775b2e44f9028a7d986369ad96#1","quote":"Do not quote these amounts as a threat.","text":"{\"limits\": []}","usage":{"input":673,"output":9}}
{"key":"90021d2e8b425fa93d59a36a4ffba04e083dcc76b11e8b68797aaeee919889fb#1","quote":"Do not tell them it is lost until five working days have passed.","text":"{\"limits\": [{\"limit\": 5, \"comparison\": \"ge\", \"role\": \"trigger\", \"unit\": \"working days\"}]}","usage":{"input":669,"output":44}}
{"key":"5fff87ed7f514cfb07a5e8d2e5009cb12c57d77d8e105b87ca6f98c877b4fd9c#1","quote":"If they ask why we want the router back, say plainly that it is ours and that we reuse it.","text":"{\"limits\": []}","usage":{"input":681,"output":9}}
{"key":"9a555303febcd49f5f5fbc65295edbbc6ba2b19d342308d2062b141370d7d0c7#1","quote":"Thank them for their time with us, and never try to talk them out of leaving.","text":"{\"limits\": []}","usage":{"input":678,"output":9}}
{"key":"8cad1d87313355308d1d69e36539e75d047fd6bed506463726f121609d99f069#1","quote":"Before you end the conversation, make sure that:","text":"{\"limits\": []}","usage":{"input":656,"output":9}}
{"key":"6b2c3b1019cc9a1b177ca4d48dbd082a96722a7a12211b62451d1035a2fccbd4#1","quote":"The ticket lists every piece of equipment","text":"{\"limits\": []}","usage":{"input":679,"output":9}}
{"key":"485a432991717477189a038da7f4023189e56b9eaf6203745420c706272827ef#1","quote":"The customer has a label or a drop-off address","text":"{\"limits\": []}","usage":{"input":682,"output":9}}
{"key":"7113ea3540579bebce39066e68164fa2f758e85275e37aa88afb9c393ae835da#1","quote":"You told them the thirty-day limit","text":"{\"limits\": []}","usage":{"input":672,"output":9}}
{"key":"6569bb44f6cdf8887c6a441e0914c4d5d0263dbbd05deb9dea227bfac55090df#1","quote":"Wish them well.","text":"{\"limits\": []}","usage":{"input":664,"output":9}}
{"key":"b5914b81c0ace2d4c0eaa630f2274b2727c83b7ca52d628c83411a0fe46cf101#1","quote":"Hand the conversation to a person when:","text":"{\"limits\": []}","usage":{"input":651,"output":9}}
{"key":"4bfb5820290d8aac11f6b986ee010786ac632c3011f190d9653f32a5c50096fc#1","quote":"The customer asks for a person twice","text":"{\"limits\": [{\"limit\": 2, \"comparison\": \"ge\", \"role\": \"trigger\", \"unit\": \"requests for a person by the customer\"}]}","usage":{"input":683,"output":51}}
{"key":"9ea42ef89c07c6fc4b649515ac720d8a898c241f3412783a3903e9724b60e315#1","quote":"The customer mentions a lawyer, a regulator or the press","text":"{\"limits\": []}","usage":{"input":686,"output":9}}
{"key":"3344459749c340bf4c57a0cace08d75db48812cba3fcb432d5615f319019efea#1","quote":"You have given the same answer three times and the customer still disagrees","text":"{\"limits\": [{\"limit\": 3, \"comparison\": \"ge\", \"role\": \"trigger\", \"unit\": \"times the same answer has been given\"}]}","usage":{"input":699,"output":50}}
{"key":"20c988b990688c06cbe97d1a8a44f81e0a52652243d8912d53123a5ccb770eaa#1","quote":"Do not hand off a conversation just because the customer is angry.","text":"{\"limits\": []}","usage":{"input":664,"output":9}}
{"key":"3b0c33dd0192f161996562ba4ff2bb535c12de108364387aebdff689baa331df#1","quote":"You do not close return tickets by hand.","text":"{\"limits\": []}","usage":{"input":661,"output":9}}
{"key":"94ffa903069d57b3913527f313388e264fd7a511b2477eb4ac55dd89359e283f#1","quote":"The ticket has been open for ten days with no fix","text":"{\"limits\": [{\"limit\": 10, \"comparison\": \"gt\", \"role\": \"trigger\", \"unit\": \"days\"}]}","usage":{"input":694,"output":43}}
{"key":"ab6a7983b0e1c997c4040a6d132fb6fab00737e29fb80d04dc2daab1bf838af7#1","quote":"Do not hand off to a person who is off shift.","text":"{\"limits\": []}","usage":{"input":669,"output":9}}
{"key":"65b3ba020f5883a3c7c158b225766f8ba456721dfdf917b557f4029da2ae608a#1","quote":"It must stand alone.","text":"{\"limits\": []}","usage":{"input":644,"output":9}}
{"key":"4982f7f06b54c41fb085c247fc4a4152e0dd1cd1e877cb800f860fd685d2bc90#1","quote":"Tell the customer who will contact them, how, and by when.","text":"{\"limits\": []}","usage":{"input":678,"output":9}}
{"key":"7e7d39041a3d38b07cd47cd00ff1f8f3d7ca6d03c81637ea2e680ce9966316c8#1","quote":"Use the deadline in the table above and not a shorter one.","text":"{\"limits\": []}","usage":{"input":678,"output":9}}
{"key":"6fd65f56856b0373c0f0c13965ed65206c75a2afb157d15781345bb2434503b3#1","quote":"Keep the note under one hundred and twenty words.","text":"{\"limits\": [{\"limit\": 120, \"comparison\": \"lt\", \"role\": \"constraint\", \"unit\": \"words\"}]}","usage":{"input":687,"output":43}}
{"key":"f3e2b6bd8c8ffd55adcca2f0d5e1fbf9108f610d941f189dc31a0c49a1d80c5c#1","quote":"Say \"a colleague in the billing team will email you within five working days\", not \"someone will be in touch\".","text":"{\"limits\": [{\"limit\": 5, \"comparison\": \"le\", \"role\": \"constraint\", \"unit\": \"working days\"}]}","usage":{"input":710,"output":43}}
{"key":"1db8e83aef8d797416c1bdaad6e148789215652b12f7926bdd9bf7c532aa64d3#1","quote":"You do not edit the ticket again unless the customer writes in.","text":"{\"limits\": []}","usage":{"input":663,"output":9}}
{"key":"fbc384d84dfe45b4a13a4f2ee647c5ed12b0ec447474b4f80737754fa5b537ff#1","quote":"Never copy a handoff note into an email to the customer.","text":"{\"limits\": []}","usage":{"input":666,"output":9}}
{"key":"b9bf591f2a761991c8d8220c3f8ef38487085d9debde4d6efd868722297b0fcb#1","quote":"Before you send the note, check that it names the account, the request and the deadline.","text":"{\"limits\": []}","usage":{"input":664,"output":9}}
{"key":"4af2a9cfc614fd58d2fe063c46a9284a03a710425867cae25b54623f32c2388a#1","quote":"Never say \"I am transferring you\" if no one is on the line.","text":"{\"limits\": []}","usage":{"input":682,"output":9}}
{"key":"f2ecd96b0e4df26e63ae54320157697c78d7628b621eac129a4006a9f8f574ac#1","quote":"Put the answer in the first line and the reason in the second.","text":"{\"limits\": []}","usage":{"input":690,"output":9}}
{"key":"a0cfbc3d0032dd2977e8e837e3a80551fe845092fefd332ac8df93eeb1c41fe6#1","quote":"Ask what they were doing when it slowed down.","text":"{\"limits\": []}","usage":{"input":658,"output":9}}
{"key":"70e5f5a29fb6787cb30b92e8add564d4b67b8382177c5dcbe1852e4705cbdadf#1","quote":"Repeat the customer's own words when you name the fault.","text":"{\"limits\": []}","usage":{"input":653,"output":9}}
{"key":"2211e327d3fbecf75269eb96acccdec1c0afa5ad35027565d93e3d929288af3f#1","quote":"Do not use the word \"ticket\" in the first message to an anxious customer.","text":"{\"limits\": []}","usage":{"input":698,"output":9}}
{"key":"0c5ed11a353844c156491be26dea8c6d20387d71b74731217c66f1fb6467ef03#1","quote":"Give one next step, never three.","text":"{\"limits\": [{\"limit\": 1, \"comparison\": \"le\", \"role\": \"constraint\", \"unit\": \"next steps\"}]}","usage":{"input":697,"output":44}}
{"key":"803663858636f973a63b4363a89f4ada8315d9a72d42b536db101ec43233acc7#1","quote":"Do not add a new offer.","text":"{\"limits\": []}","usage":{"input":655,"output":9}}
{"key":"74a4199557c3fe0d5d1f4ef35bba9a04941babbf7ca760df9fca045ca8489131#1","quote":"Say \"visit\" and not \"appointment\".","text":"{\"limits\": []}","usage":{"input":670,"output":9}}
{"key":"f12a91e2f9e6a466a64e44824e7710b80986bbe160921a78327ffe00e348396a#1","quote":"Say \"connection\" and not \"service\".","text":"{\"limits\": []}","usage":{"input":668,"output":9}}
{"key":"da024c2deeb5ac395b24311ef4dd45df97420c9f2380f66bb18ff0d9d6a935ee#1","quote":"Say \"we\" for Quillfisher and \"you\" for the customer.","text":"{\"limits\": []}","usage":{"input":678,"output":9}}
{"key":"7da348d78debd62cc036ecf92d129b1dd3aa2eb524d9acf55d34c11e96216e69#1","quote":"If a customer's request is not in your instructions, do not invent a policy.","text":"{\"limits\": []}","usage":{"input":668,"output":9}}
{"key":"9843608a92b57fb9ff58969fd7902d8bd0b6a6e785ab6ccc4064958f3044ddf0#1","quote":"If two instructions seem to conflict, follow the safer one.","text":"{\"limits\": []}","usage":{"input":663,"output":9}}
{"key":"77515951cbfceabab40d4f0f3be195bc374c7fe0d857a720545a736658a13ff8#1","quote":"Tell the duty manager about the conflict in your handoff note.","text":"{\"limits\": []}","usage":{"input":664,"output":9}}
{"key":"f5dee136019aeb351aa6448a0575eb706aecdbd9cdd36425ffb3fbcfb48985e7#1","quote":"Open the line monitor for the customer's address before you ask them to do anything.","text":"{\"limits\": []}","usage":{"input":681,"output":9}}
{"key":"4d0e37f68fdb1f4b592d024dc0dc80e891909c88c55ead90befdbe1ecb15f8ef#1","quote":"If the monitor shows down and the network team has a known outage for the street, tell the customer at once.","text":"{\"limits\": []}","usage":{"input":710,"output":9}}
{"key":"708a11bd78a675739d5f2fa398c21b92e81134abfd9babdaccc22a63f6ac034b#1","quote":"Give the outage reference and the estimated fix time from the network team's note.","text":"{\"limits\": []}","usage":{"input":703,"output":9}}
