{"key":"766f756fb771edd45ed846427169e11bd396fd2fe28ead91db70c16510a84a51#1","quote":"Before you end the conversation, make sure that:","text":"{\"limits\": []}","usage":{"input":848,"output":9}}
{"key":"772638c66fcbb85d6372c88e195a658977b1896d1f4239fb8de7c60d50e9bd02#1","quote":"Wish them well.","text":"{\"limits\": []}","usage":{"input":856,"output":9}}
{"key":"80aaef9f20de325a8b9375f9bc5f1703814668088c6b8985b187df7613147739#1","quote":"You told them the thirty-day limit","text":"{\"limits\": [{\"limit\": 30, \"comparison\": \"le\", \"role\": \"constraint\", \"unit\": \"days\"}]}","usage":{"input":864,"output":42}}
{"key":"315021e0347c650a924fb83c9d678734b80aabf601de7c01f64854b74086e2a2#1","quote":"Hand the conversation to a person when:","text":"{\"limits\": []}","usage":{"input":843,"output":9}}
{"key":"499f8166ed2acd0a0cca249a0b9ec3b6174dc744355a71ea347c6b69a9968c9a#1","quote":"The customer asks for a person twice","text":"{\"limits\": [{\"limit\": 2, \"comparison\": \"ge\", \"role\": \"trigger\", \"unit\": \"requests for a person\"}]}","usage":{"input":875,"output":47}}
{"key":"d11acfdffdaf9e5625bb3872b679c0c5b9a80457f1ac8814e872a8842920d47b#1","quote":"The ticket has been open for ten days with no fix","text":"{\"limits\": [{\"limit\": 10, \"comparison\": \"ge\", \"role\": \"trigger\", \"unit\": \"days\"}]}","usage":{"input":886,"output":43}}
{"key":"5f8160d0ef50e6d82a11b19e928ec8e48dd437ee3500d6f236749818600e1078#1","quote":"Do not hand off a conversation just because the customer is angry.","text":"{\"limits\": []}","usage":{"input":856,"output":9}}
