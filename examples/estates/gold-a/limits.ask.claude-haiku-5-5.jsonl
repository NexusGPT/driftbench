{"key":"f1f3562083a68a90ece779583855b4121da154e7ae1278c754ceea1f319b06a6#1","quote":"Do not guess which line the customer means.","text":"{\"limits\": []}","usage":{"input":655,"output":9}}
{"key":"239635dfffe0b4584e3708b4f524e9375b039e4a1b949115a59ced5b44558b4a#1","quote":"Thank the customer for the details and say you are looking at the bill.","text":"{\"limits\": []}","usage":{"input":676,"output":9}}
{"key":"e1b7dc82dc06db63556d053e0c5cf7301ee8c05032ab4b0051dd532afad3f8cd#1","quote":"Read the bill line by line before you answer.","text":"{\"limits\": []}","usage":{"input":656,"output":9}}
{"key":"2244b7d3a8152145aff7c056c7fe50d65fbb9fd4d0ee883445c846bcffc7e5fb#1","quote":"Do not use it for a price quote on a new plan; that goes to sales.","text":"{\"limits\": []}","usage":{"input":639,"output":9}}
{"key":"a0242d06908285aaad35cd717f86319bad3d47b58462cd4f7736d6ad472d9d7b#1","quote":"If the line is a charge the customer agreed to, explain it in one or two sentences.","text":"{\"limits\": [{\"limit\": 2, \"comparison\": \"le\", \"role\": \"constraint\", \"unit\": \"sentences\"}]}","usage":{"input":707,"output":44}}
{"key":"d2b9da6dcdf0a252b7492cc3956065b2491ff0b188cf763e9bdd0d461a8648ed#1","quote":"Name the line you are checking, so they know you read it.","text":"{\"limits\": []}","usage":{"input":672,"output":9}}
{"key":"441ffa7ccfe8deac29269340dcf7b103536c24cdd7c7d89c2da560598ceeb682#1","quote":"Say when they agreed to it and where it is written down.","text":"{\"limits\": []}","usage":{"input":697,"output":9}}
{"key":"45f3702322ab8457bbc03db6f992d76d9e31c46e437d92caa7e8194831000f47#1","quote":"If the line looks wrong, do not argue and do not promise a refund.","text":"{\"limits\": []}","usage":{"input":671,"output":9}}
