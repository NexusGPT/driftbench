{"key":"8e33333099683485a66ef87ca7d684f98208edcbb620c28090f703c0941c7429#1","quote":"Do not ask the customer to reset the router to factory settings.","text":"{\"limits\": []}","usage":{"input":662,"output":9}}
{"key":"cf7b9023a92fbbd35bdfc910c69ee60c0a191c81bc512143d085a627de003983#1","quote":"Add the address, the time the fault began and the answers you already have.","text":"{\"limits\": []}","usage":{"input":667,"output":9}}
{"key":"2b0e3b487a023c19a5dc3abfc574ee6ff273f2e14dd96bd22f5f9fc5f9d269dc#1","quote":"Wait for the customer's reply before you ask the next question.","text":"{\"limits\": []}","usage":{"input":665,"output":9}}
{"key":"0ca2fc3d6c95dc836dbe672bf4ed00c405d76e74168fc75231582f69412fddd2#1","quote":"If the lights show steady red, open a network ticket.","text":"{\"limits\": []}","usage":{"input":664,"output":9}}
{"key":"56747becb963c63ec1fe50efb6ce619d6c484d11d9dbea91cc050e2c419cb922#1","quote":"Ask one question per message.","text":"{\"limits\": [{\"limit\": 1, \"comparison\": \"le\", \"role\": \"constraint\", \"unit\": \"questions per message\"}]}","usage":{"input":682,"output":45}}
{"key":"93ecb3ba43df4d995a6c6b0f417739c1770e5ac0fc60313918ff41c4f5eca88a#1","quote":"If the lights are off, ask the customer to try another wall socket.","text":"{\"limits\": []}","usage":{"input":707,"output":9}}
{"key":"508b9b4d68fbc0c494809084c690b15241836ef3bfb9ef4294ed95ffcc5049da#1","quote":"Book a technician only after the restart and the socket test have failed.","text":"{\"limits\": []}","usage":{"input":669,"output":9}}
{"key":"80ece21d35fefb9c5b999b27717a3f91d25e60654a779fcda7c3a2ddc74f091a#1","quote":"If every light is normal and the internet is still slow, run the speed check in the line monitor.","text":"{\"limits\": []}","usage":{"input":675,"output":9}}
