{"key":"79901976a2790241f36d342ddb042177e59fcf389fd89023623098b1354e6cd4","quote":"Tell the duty manager about the conflict in your handoff note.","text":"{\"limits\": []}","usage":{"input":629,"output":9}}
{"key":"2dc1d2180037d4dcb203f598289f631c0f626506b54ab7603a6b88053ac32bbc","quote":"If a customer's request is not in your instructions, do not invent a policy.","text":"{\"limits\": []}","usage":{"input":631,"output":9}}
{"key":"3edc9c29eb4b856a18ac419aa663298961b71ecfbe30db9b6acbee295eab3d4d","quote":"If two instructions seem to conflict, follow the safer one.","text":"{\"limits\": []}","usage":{"input":628,"output":9}}
{"key":"cdb2f11c20c5692fe5190e13b6a2b12f60ef13ee07d27ad83312498be9b9e78d","quote":"Open the line monitor for the customer's address before you ask them to do anything.","text":"{\"limits\": []}","usage":{"input":634,"output":9}}
{"key":"6f513a64a694760c120e9b1ef170582dfd45358f2b7c1ff11bd53aaa45e9d923","quote":"If the monitor shows down and the network team has a known outage for the street, tell the customer at once.","text":"{\"limits\": []}","usage":{"input":640,"output":9}}
