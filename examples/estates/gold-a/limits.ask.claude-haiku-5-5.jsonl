{"key":"2990534948ab5f6f09ea3b07d1f57869dc3f78b35fb4b174f8ed754c3f656262#1","quote":"Do not tell them it is lost until five working days have passed.","text":"{\"limits\": [{\"limit\": 5, \"comparison\": \"ge\", \"role\": \"constraint\", \"unit\": \"working days\"}]}","usage":{"input":861,"output":44}}
{"key":"3f27e5fa747a097496e14954fdb4d26edcb7dfa28145d63105e14be1c5b952d4#1","quote":"If they ask why we want the router back, say plainly that it is ours and that we reuse it.","text":"{\"limits\": []}","usage":{"input":873,"output":9}}
