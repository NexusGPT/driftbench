{"key":"ea901e41842350724cbc5dddc68d641defced008803134cbbed64722612a764b#1","quote":"Do not paste the whole conversation into the ticket.","text":"{\"limits\": []}","usage":{"input":856,"output":9}}
{"key":"010cf7bbdb71c5062c4e669ebf6964ed08c38a42d5c9b1b4848a917fe1707881#1","quote":"Write a summary of three lines at most.","text":"{\"limits\": [{\"limit\": 3, \"comparison\": \"le\", \"role\": \"constraint\", \"unit\": \"lines\"}]}","usage":{"input":851,"output":43}}
{"key":"8c3a0516a4120a73a3981e122424a7decaad0e67a5e7fc3e09789757649e85b1#1","quote":"Explain this if they ask why their bill is lower than a neighbour's.","text":"{\"limits\": []}","usage":{"input":904,"output":9}}
{"key":"c42cf37fc78f5dc70537664593e391dfe05e76c02cb4fc1937f53e3fca8e0747#1","quote":"You never say a refund is approved.","text":"{\"limits\": []}","usage":{"input":849,"output":9}}
{"key":"a73062ff2960df3d3739514a930880528736cee63018b425bdba21ba750eacb1#1","quote":"Close with the next step and who owns it.","text":"{\"limits\": []}","usage":{"input":859,"output":9}}
{"key":"217d01a584e2b27f106a3e3e66c49f7488d0a3fbd876e90cca9ed11802c48b2d#1","quote":"In that case check the move date before you open a ticket.","text":"{\"limits\": []}","usage":{"input":886,"output":9}}
{"key":"cb43aebfa78f93a84e3b80b1146d99d5e5a5c7b25e4e0c81a9fcf76c214214e6#1","quote":"Ask which pieces of equipment they still have at home.","text":"{\"limits\": []}","usage":{"input":875,"output":9}}
{"key":"21dbc1cbd76731f28bf83735efd66b65bd4137fd73b47a81ff640bed81c8b2c8#1","quote":"Never start a return because a customer sounds unhappy.","text":"{\"limits\": []}","usage":{"input":853,"output":9}}
{"key":"f8c42f8aeb77342a0e558deb9d1efb8d50362f0c6d6a1bf87171e98de802be87#1","quote":"Write them down one by one in the ticket.","text":"{\"limits\": []}","usage":{"input":871,"output":9}}
{"key":"0cdd5e49ea10a15387e28191f9652a38c50423abe34bb8c404e60c2b0cefdda9#1","quote":"Tell the customer to pack the equipment in the original box if they have it.","text":"{\"limits\": []}","usage":{"input":876,"output":9}}
