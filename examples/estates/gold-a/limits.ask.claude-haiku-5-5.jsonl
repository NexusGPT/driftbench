{"key":"626f632381e937429e4d2d39ab8338e6cc2cbdf45e67056da0e453a2e64b819a","quote":"Never say \"I am transferring you\" if no one is on the line.","text":"{\"limits\": []}","usage":{"input":392,"output":9}}
{"key":"942da2a0f3301cbf4bdc3c2145eb02ba10be6a059427700f8025ccd63a1fb4c2","quote":"Say \"a colleague in the billing team will email you within five working days\", not \"someone will be in touch\".","text":"{\"limits\": [{\"limit\": 5, \"comparison\": \"le\", \"unit\": \"working days\"}]}","usage":{"input":403,"output":35}}
{"key":"4c1315fc76fe2c87c74c62ebf4c98c27f1228e7a75d81f5f46157d1fec2a9802","quote":"Tell the customer who will contact them, how, and by when.","text":"{\"limits\": []}","usage":{"input":391,"output":9}}
{"key":"3295ff0b7938825784b74f805ac0fb847954e1a370ee37a1dd4ab9ff788f2f3a","quote":"You do not edit the ticket again unless the customer writes in.","text":"{\"limits\": []}","usage":{"input":391,"output":9}}
{"key":"86d4e9fa6156f25375dd6ab94826675f21f43859a1f927d7fb2adddead92fa80","quote":"Before you send the note, check that it names the account, the request and the deadline.","text":"{\"limits\": []}","usage":{"input":392,"output":9}}
{"key":"81e834773b3e5bcc878bb6a0b6c4e0cfea32281616cc57823e3027902a38c99d","quote":"Never copy a handoff note into an email to the customer.","text":"{\"limits\": []}","usage":{"input":394,"output":9}}
