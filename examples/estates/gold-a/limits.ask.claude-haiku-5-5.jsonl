{"key":"254ed124bdd0b260d5e143482957eb5d80c71cd7e7439beaceb8aa7b95a19450#1","quote":"Tell the customer who will contact them, how, and by when.","text":"{\"limits\": []}","usage":{"input":870,"output":9}}
{"key":"390d1bb74d369baba33cf6c9a0e941cdb007177e9471f257a561e13298c0fb18#1","quote":"Keep the note under one hundred and twenty words.","text":"{\"limits\": [{\"limit\": 120, \"comparison\": \"lt\", \"role\": \"constraint\", \"unit\": \"words\"}]}","usage":{"input":879,"output":43}}
{"key":"f12b877e59ad7f94f79277d02e3d980d70b3957a23f9d62e6048b54b58c8675f#1","quote":"Use the deadline in the table above and not a shorter one.","text":"{\"limits\": []}","usage":{"input":870,"output":9}}
{"key":"f060cc8367cab69c2c26f8b503dc70ce005c3aa529b3416cc7f835fdf173c68f#1","quote":"It must stand alone.","text":"{\"limits\": []}","usage":{"input":836,"output":9}}
{"key":"726695b90833a86417ce2084a44c932a3788fe2737be83ae8e0a03be20a6f4ff#1","quote":"Say \"a colleague in the billing team will email you within five working days\", not \"someone will be in touch\".","text":"{\"limits\": [{\"limit\": 5, \"comparison\": \"le\", \"role\": \"constraint\", \"unit\": \"working days\"}]}","usage":{"input":902,"output":43}}
{"key":"4248d3b9b470247ebfdd6357885fb1f578d047e98a0bc0080bf6b538ea11c953#1","quote":"Never say \"I am transferring you\" if no one is on the line.","text":"{\"limits\": []}","usage":{"input":874,"output":9}}
{"key":"4b3d8912bc4c5a04da8875a1d3264260afacf45ca5ee9f3359347d4f62db7a59#1","quote":"You do not edit the ticket again unless the customer writes in.","text":"{\"limits\": []}","usage":{"input":855,"output":9}}
{"key":"b1e575cc9e42cf6bc252ffbbb7c081b1a332871fec956034219bbc177be3fd87#1","quote":"Before you send the note, check that it names the account, the request and the deadline.","text":"{\"limits\": []}","usage":{"input":856,"output":9}}
{"key":"d3d1188c7e981dcdbcfadf07ac2389c9b2d4164d47e9571cf111f76ddf8111aa#1","quote":"Ask what they were doing when it slowed down.","text":"{\"limits\": []}","usage":{"input":850,"output":9}}
{"key":"75656b526d367ccfd5c2f6bd09494c75253e0b4ef4cee879f5c50a2d9fb2416b#1","quote":"Never copy a handoff note into an email to the customer.","text":"{\"limits\": []}","usage":{"input":858,"output":9}}
