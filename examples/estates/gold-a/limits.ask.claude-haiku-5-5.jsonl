{"key":"003facf2854f15598ea5f4bc32a5e54c0d6e0fbc6ec4aac48c197428c120aebc","quote":"The ticket has been open for ten days with no fix","text":"{\"limits\": [{\"limit\": 10, \"comparison\": \"ge\", \"unit\": \"days\"}]}","usage":{"input":387,"output":35}}
{"key":"e18cfadbadc7b21c9218cb77c42be68d404de73ff2443fe7af434a86da58329c","quote":"Do not hand off to a person who is off shift.","text":"{\"limits\": []}","usage":{"input":388,"output":9}}
