{"key":"a2c8fd1a981c8944d9938dbfa0f77281e0b297dbb423ba9e22c1928e63bd76ba#1","quote":"A charge appears twice","text":"{\"limits\": [{\"limit\": 5, \"comparison\": \"le\", \"role\": \"constraint\", \"unit\": \"working days\"}]}","usage":{"input":816,"output":43}}
{"key":"87d065fcb3dbb95438988e1c683a180057bfcd21626a928c4793f9721665395b#1","quote":"Explain the line and offer to send a copy of the plan terms","text":"{\"limits\": []}","usage":{"input":817,"output":9}}
{"key":"14dc8608b8c0dc578335ec2ec342c7f79546601f5b70f432d1e17873017b4c8a#1","quote":"A credit is missing","text":"{\"limits\": []}","usage":{"input":823,"output":9}}
{"key":"d662e39c1bdacc6b0774e405b6441b35b1cdb4ae179eb51d5f87facfecb2ae59#1","quote":"Say it looks like a duplicate and that billing will check it within five working days","text":"{\"limits\": [{\"limit\": 5, \"comparison\": \"le\", \"role\": \"constraint\", \"unit\": \"working days\"}]}","usage":{"input":831,"output":43}}
{"key":"5e7287f1086c329c9edf9b3ca0992ddadea4023897c59f2902748b994a147a6c#1","quote":"Say you have asked billing to look for it and give the ticket number","text":"{\"limits\": []}","usage":{"input":836,"output":9}}
