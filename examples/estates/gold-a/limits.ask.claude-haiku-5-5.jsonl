{"key":"fa57fd03e037eea07d4a74d4c9832bb468964bd223e688ec2346ce88564305a0","quote":"Do not guess which line the customer means.","text":"{\"limits\": []}","usage":{"input":258,"output":9}}
{"key":"393ec9708a60f570df4a380eb140610834975c46fbc3d2398747bcfad910ca52","quote":"Do not use it for a price quote on a new plan; that goes to sales.","text":"{\"limits\": []}","usage":{"input":269,"output":9}}
{"key":"e05b1c04a67c4c48c36768f4ebcf8a571ed7777db397f55a7ab88962c5e2a2a5","quote":"Read the bill line by line before you answer.","text":"{\"limits\": []}","usage":{"input":259,"output":9}}
{"key":"1a4af777984df8ab7f7b22f983cce9fc890ff05312863e0adf29a43001a343cc","quote":"Thank the customer for the details and say you are looking at the bill.","text":"{\"limits\": []}","usage":{"input":266,"output":9}}
{"key":"6be0a1b0984a90b56dd6bcc7129d732ca31282ccf3082cefb86143d9d2767a82","quote":"Name the line you are checking, so they know you read it.","text":"{\"limits\": []}","usage":{"input":262,"output":9}}
{"key":"742350ef1ce3e09c52e53fe282911db7a41a18fea9194ae2c1cc52be4cbd8191","quote":"Say when they agreed to it and where it is written down.","text":"{\"limits\": []}","usage":{"input":262,"output":9}}
{"key":"c1cdfc9dfa0b6db25b8f767cd62ded5abbf3cc46bca220b24d94c4c833ea437c","quote":"If the line is a charge the customer agreed to, explain it in one or two sentences.","text":"{\"limits\": [{\"limit\": 2, \"comparison\": \"le\", \"unit\": \"sentences\"}]}","usage":{"input":272,"output":36}}
{"key":"3a321d8285f28eea428e88098129a9304b8ba6bfd1d4f78ec6cb6bc85f4c2789","quote":"If the line looks wrong, do not argue and do not promise a refund.","text":"{\"limits\": []}","usage":{"input":268,"output":9}}
{"key":"1e22ad109d6e5a33e5b277a569fda8ffe3090b6fc7e0029cd103b8acd5ca5802","quote":"The charge matches the plan","text":"{\"limits\": []}","usage":{"input":254,"output":9}}
{"key":"d8c61a03d03690ad23c1ed61568dcb82d0421de93c87f9ce21a2250955d57899","quote":"A charge appears twice","text":"{\"limits\": []}","usage":{"input":253,"output":9}}
{"key":"f66f7db5b0bfdb2ff6b969b0572aa5be2fe11a4528ffa072a1df5e5026e7e815","quote":"Explain the line and offer to send a copy of the plan terms","text":"{\"limits\": []}","usage":{"input":265,"output":9}}
{"key":"9e5c5eb0066c26fc9aebd236c7058b4c033121d0d8047e55d64142ce81de58c2","quote":"Say it looks like a duplicate and that billing will check it within five working days","text":"{\"limits\": [{\"limit\": 5, \"comparison\": \"le\", \"unit\": \"working days\"}]}","usage":{"input":268,"output":35}}
{"key":"dd30c14b82bcdb20d85b7ec9ec13239c24dea4b6ff87ae70a90252af3f496503","quote":"Say you have asked billing to look for it and give the ticket number","text":"{\"limits\": []}","usage":{"input":265,"output":9}}
{"key":"38a28867f4761311729cbf981c7ad118bfd7aa1cd345d5e070bd42a9c37fa71c","quote":"A credit is missing","text":"{\"limits\": []}","usage":{"input":252,"output":9}}
{"key":"33e8604ef260293f01571ce9069b82a0223063809e2a94656b00f639ed850132","quote":"Do not discuss the price; say the billing team will contact them","text":"{\"limits\": []}","usage":{"input":264,"output":9}}
{"key":"e14b4f7813f715f8d8fa80b662fa44469a77b73eadd86e8d2e4a62d6580cafad","quote":"The customer disputes the plan fee","text":"{\"limits\": []}","usage":{"input":257,"output":9}}
{"key":"51f63f937d6332337f8431ff735c5fc9d8b80efd042c5da7487f3c321ded054f","quote":"Answer the worry, not the tone.","text":"{\"limits\": []}","usage":{"input":258,"output":9}}
{"key":"282926ddeeb7ab94be758961c4e64cfb421ace07d9a463de9a24c9a9e410b347","quote":"If the customer swears, stay polite and carry on.","text":"{\"limits\": []}","usage":{"input":262,"output":9}}
{"key":"84c45bb925969deaaac85c7fe40ee689ffe08c8f302b715fbf98a78cde654f05","quote":"Say what the bill shows and what you will do.","text":"{\"limits\": []}","usage":{"input":260,"output":9}}
{"key":"26225ef3f10d67603b9119ea9b7110b56cd2d65c10cf38952493ba0e0972ae00","quote":"A good billing ticket has five fields:","text":"{\"limits\": [{\"limit\": 5, \"comparison\": \"le\", \"unit\": \"fields\"}]}","usage":{"input":258,"output":35}}
{"key":"99c7ebf264c794769675102c6ded8e95c615ca1c6f80ed304a2f332828a8c7ef","quote":"Never say the customer is wrong.","text":"{\"limits\": []}","usage":{"input":257,"output":9}}
{"key":"4c01a4739f39697134da01c1c8dcbf427d20a335e737cf74ea820ff2c17856e3","quote":"The invoice number","text":"{\"limits\": []}","usage":{"input":251,"output":9}}
{"key":"3e6844913ba563c558d56f90aa9f445e9f19d783641b99c7b5eab6b016f07892","quote":"The line in dispute","text":"{\"limits\": []}","usage":{"input":252,"output":9}}
{"key":"9abaf90a04f75f24bf22968b4b3630a7180fc56ff529a01f64410efba5c4b7f7","quote":"What you already told them","text":"{\"limits\": []}","usage":{"input":251,"output":9}}
{"key":"a192b1347112e872d6ebecfaff64b9757cb9e13f7401c272b52a7543e737cf14","quote":"What the customer expects","text":"{\"limits\": []}","usage":{"input":252,"output":9}}
{"key":"bf1457b7d6dcde94d53edbdfe3e50af4e9e08c52c8cd5bc575ca799e850ac0df","quote":"Copy the invoice number exactly as printed.","text":"{\"limits\": []}","usage":{"input":261,"output":9}}
{"key":"99550d41d186f654809050a79f98eab1a4a2be70e1b9df6953592afc47274e74","quote":"The date of the first complaint","text":"{\"limits\": []}","usage":{"input":254,"output":9}}
{"key":"c7e34cf4acfa29e877007c5e2d0d60e00e8ac11dbc47d795666ef4c42820293b","quote":"Do not paste the whole conversation into the ticket.","text":"{\"limits\": []}","usage":{"input":263,"output":9}}
{"key":"556b65f27aa963d6e11cc171d4f740abfa17dc4b9f1fb760d1b2e502a3fc6b26","quote":"Write a summary of three lines at most.","text":"{\"limits\": [{\"limit\": 3, \"comparison\": \"le\", \"unit\": \"lines\"}]}","usage":{"input":258,"output":35}}
{"key":"4a200cabf232765a89d6276e8adb7ec2675de7bf1c7afd7cb137d04905eaeee6","quote":"In that case check the move date before you open a ticket.","text":"{\"limits\": []}","usage":{"input":261,"output":9}}
{"key":"079dcdc782e78ab1d72b0010eb40fe4fad0beb3e00719298004fc15af0e61de3","quote":"Explain this if they ask why their bill is lower than a neighbour's.","text":"{\"limits\": []}","usage":{"input":269,"output":9}}
{"key":"488cc0f8442d86fc5aa2c2b85f67741f49edaf635d1dc657cb21756c80e20bee","quote":"Close with the next step and who owns it.","text":"{\"limits\": []}","usage":{"input":258,"output":9}}
{"key":"e806fdb3cdae909ccd19dd86533a77eac837bf27c8f6a2806838ee3754ac3dd0","quote":"You never say a refund is approved.","text":"{\"limits\": []}","usage":{"input":256,"output":9}}
{"key":"4ebcd3a95ba64849de47b390316072d7a57dd3c53f63ee92ea0cd365491e9906","quote":"Never start a return because a customer sounds unhappy.","text":"{\"limits\": []}","usage":{"input":263,"output":9}}
{"key":"4ba7c70d9170dc6bb25558d5033747d1abebcc18c60807c3214d5b1aefaefdd9","quote":"Ask which pieces of equipment they still have at home.","text":"{\"limits\": []}","usage":{"input":263,"output":9}}
{"key":"08215629c9eb06970d3be6c94c1759be0514175b6202431fea95eb533f67dcae","quote":"Tell the customer to pack the equipment in the original box if they have it.","text":"{\"limits\": []}","usage":{"input":268,"output":9}}
{"key":"3c1e95d101f74e6d007733a5d149ab849dfd5a16dbbf7d9c8d2452d24fef7dbd","quote":"Write them down one by one in the ticket.","text":"{\"limits\": []}","usage":{"input":259,"output":9}}
{"key":"8cedd4d89554debffb4780f2d16e23818b3f9d870643d7afe895a7900c88623d","quote":"The customer has the original box","text":"{\"limits\": []}","usage":{"input":253,"output":9}}
{"key":"6d61da27e059da992b0f53ada292da6752e181c4b1a7b310e0d1137c88a31609","quote":"The customer lost the power adapter","text":"{\"limits\": []}","usage":{"input":256,"output":9}}
{"key":"b0200bb74e5f3175cab845ad941e8fc43f7719e99809c774a3ec94ceb9de08a7","quote":"Send the label and say the box is enough","text":"{\"limits\": []}","usage":{"input":257,"output":9}}
{"key":"77173831484ca7bba88ca65ef9cac52ac18d5ef292640aefb64e295119896da7","quote":"Note it on the ticket and say a fee may apply","text":"{\"limits\": []}","usage":{"input":262,"output":9}}
{"key":"2382d42122df880054c8def8776237087f948b2e163ca635c3ed194527a97eb0","quote":"Ask for a photo and attach it to the ticket","text":"{\"limits\": []}","usage":{"input":262,"output":9}}
{"key":"50562801a8cdf552783f0ed3c00ce7e298ddde437865d7de0e3721b69356065e","quote":"The router is damaged","text":"{\"limits\": []}","usage":{"input":252,"output":9}}
{"key":"a40551aee89d82f465c40e0dbe4267a0bed0753ea5d7772442ed7871578d2ad0","quote":"The customer lost the router","text":"{\"limits\": []}","usage":{"input":253,"output":9}}
{"key":"f922c5d82c3ae14b81d30d254025f292c5425ac7b198584f787d34356ee654a5","quote":"Do not promise to waive the fee; send the ticket to billing","text":"{\"limits\": []}","usage":{"input":266,"output":9}}
{"key":"0c8bd0c769e7cca85c967acb827be30edfe3c978be88c0a6c4ea675be45f269c","quote":"Mention them only if the customer asks what happens when equipment is lost.","text":"{\"limits\": []}","usage":{"input":268,"output":9}}
{"key":"d181f9153616169ea6208030a38355ba29e47a2e4b6de14e60f33c78e811d64b","quote":"If the customer asks where it is, look it up.","text":"{\"limits\": []}","usage":{"input":260,"output":9}}
{"key":"0162a1a05e520a0c9a6a04ac04e2428b523e2521bcd99d8d11126349800aef84","quote":"Do not quote these amounts as a threat.","text":"{\"limits\": []}","usage":{"input":260,"output":9}}
{"key":"1d15dbc522583e54b2abd431177b16603164642797a848e0dbe8db88f4a28f80","quote":"Do not tell them it is lost until five working days have passed.","text":"{\"limits\": [{\"limit\": 5, \"comparison\": \"ge\", \"unit\": \"working days\"}]}","usage":{"input":264,"output":36}}
{"key":"5f6945b929f3dac2b56da93388bc2b55b51ee23741e6ae7bfad2b6f770a5e053","quote":"You do not close return tickets by hand.","text":"{\"limits\": []}","usage":{"input":258,"output":9}}
{"key":"9cef8d757644a08cf02bc737ff401b3ba8bb806de5149612bf7f169b9141cf76","quote":"Thank them for their time with us, and never try to talk them out of leaving.","text":"{\"limits\": []}","usage":{"input":269,"output":9}}
{"key":"83cd067425811853470067349ffbc7edebc5d3e3fb03d5eb62c2884c210e1e8f","quote":"If they ask why we want the router back, say plainly that it is ours and that we reuse it.","text":"{\"limits\": []}","usage":{"input":274,"output":9}}
{"key":"f50f93b4df920a7398de78469fa04f5fc34627a3f636614b351c59f0fddf9b9c","quote":"Before you end the conversation, make sure that:","text":"{\"limits\": []}","usage":{"input":260,"output":9}}
{"key":"c2b4dbb36e09f0b3e821ca62feae13006050fe34c8c9bec20a202e42c2dcc508","quote":"The ticket lists every piece of equipment","text":"{\"limits\": []}","usage":{"input":259,"output":9}}
{"key":"aa2538e6e7cc6e76cbd06b2296dc961a0504018e992d8733a05ac5f0d7e58092","quote":"The customer has a label or a drop-off address","text":"{\"limits\": []}","usage":{"input":259,"output":9}}
{"key":"234a6d64bf9e4e9a22e78731863032b55b9190a5edba001abe5a07158c6db9fa","quote":"You told them the thirty-day limit","text":"{\"limits\": [{\"limit\": 30, \"comparison\": \"le\", \"unit\": \"days\"}]}","usage":{"input":257,"output":34}}
{"key":"bce2f4d9eb178a591dcb6fcb7e9eb08b70860226b84951d44f6da8363e19302b","quote":"Wish them well.","text":"{\"limits\": []}","usage":{"input":252,"output":9}}
{"key":"1ddda02bb05cee5e4cbf4c6997c2d002f2ed4ea9603493af45e569574215ad0a","quote":"Hand the conversation to a person when:","text":"{\"limits\": []}","usage":{"input":258,"output":9}}
{"key":"5cfba4863547ef182d0e6bc428a3369706048eca87da431222686b53d60a4847","quote":"The customer asks for a person twice","text":"{\"limits\": [{\"limit\": 2, \"comparison\": \"le\", \"unit\": \"person requests\"}]}","usage":{"input":256,"output":36}}
{"key":"02efb0281fb2ccfb7ceab740753ccfdbe460c9ee0fe4e51e186cd7ff6b472ef9","quote":"The ticket has been open for ten days with no fix","text":"{\"limits\": []}","usage":{"input":261,"output":9}}
{"key":"5603b4dd0d73b3173aa81b77695adb24573af55b56005e52f1ca422aa8f99b89","quote":"The customer mentions a lawyer, a regulator or the press","text":"{\"limits\": []}","usage":{"input":265,"output":9}}
{"key":"055e9ede3759221c00e0d42b60d3fae6fac1079dfd2357fe7e3bd11f48b5d3cf","quote":"You have given the same answer three times and the customer still disagrees","text":"{\"limits\": [{\"limit\": 3, \"comparison\": \"ge\", \"unit\": \"times the same answer has been given\"}]}","usage":{"input":264,"output":42}}
{"key":"c94499892348c36da63d08b6b697e6da73abb2dd461b3923bf2254e5165aff7f","quote":"Do not hand off a conversation just because the customer is angry.","text":"{\"limits\": []}","usage":{"input":265,"output":9}}
{"key":"47660fb2243fd313499cb1ff9024385fb7093b60a35c9678713658c0c528ad24","quote":"It must stand alone.","text":"{\"limits\": []}","usage":{"input":253,"output":9}}
{"key":"3535d678c1e229be5fe7c529a501e2401812469d6e9620c7133c9ac6161c26c7","quote":"Do not hand off to a person who is off shift.","text":"{\"limits\": []}","usage":{"input":261,"output":9}}
{"key":"837a200dd745f7f342e7b35fc786036a38753de0b2b4dddc60fed5499ad27a41","quote":"Tell the customer who will contact them, how, and by when.","text":"{\"limits\": []}","usage":{"input":264,"output":9}}
{"key":"6818c7807b69a013b2cbfd595bd123b832b28284a83e13e82d0002bce0b6372d","quote":"Keep the note under one hundred and twenty words.","text":"{\"limits\": [{\"limit\": 120, \"comparison\": \"lt\", \"unit\": \"words\"}]}","usage":{"input":262,"output":35}}
{"key":"d3f02b2814c0322f36af0f13d6078054af4382c42310ec1809551f2978881e80","quote":"Say \"a colleague in the billing team will email you within five working days\", not \"someone will be in touch\".","text":"{\"limits\": [{\"limit\": 5, \"comparison\": \"le\", \"unit\": \"working days\"}]}","usage":{"input":276,"output":35}}
{"key":"de23778de9f58a202c0825fdd13760557edb7e222481dc111afc00d55ff7bbfa","quote":"Use the deadline in the table above and not a shorter one.","text":"{\"limits\": []}","usage":{"input":264,"output":9}}
{"key":"32b47f01b5eae765bce4ec01288f2d07629451fe0352faa7906e6f48fcebff4b","quote":"Never say \"I am transferring you\" if no one is on the line.","text":"{\"limits\": []}","usage":{"input":265,"output":9}}
{"key":"918d7ba0c8da9fd13c2a9202b3dfae8f83f95ded91964c8d4aed95d9fe2aee21","quote":"You do not edit the ticket again unless the customer writes in.","text":"{\"limits\": []}","usage":{"input":265,"output":9}}
{"key":"f2a5aae50391915d1d818f1209f8a17323e5ea596c59b41d19f05e948cd3b349","quote":"Never copy a handoff note into an email to the customer.","text":"{\"limits\": []}","usage":{"input":263,"output":9}}
{"key":"95a5ee4d0c030a4c11fbe3eba07e8dbc74d16f8e119840440732f748e988b469","quote":"Ask what they were doing when it slowed down.","text":"{\"limits\": []}","usage":{"input":261,"output":9}}
{"key":"b987aaef448747897f2151cf1fa50c85ac8d4eb7a3b1e8ede561636f952276d9","quote":"Before you send the note, check that it names the account, the request and the deadline.","text":"{\"limits\": []}","usage":{"input":268,"output":9}}
{"key":"7d92130e5ec4bfae5ada3ac7a7495bbec1b4caaf941c1fa0f0131757e1cfd914","quote":"Put the answer in the first line and the reason in the second.","text":"{\"limits\": [{\"limit\": 2, \"comparison\": \"le\", \"unit\": \"lines\"}]}","usage":{"input":263,"output":35}}
{"key":"c31997ea7db39b42f4ee780c836c5f484301615487a71a26352ae0bfdb5f98dd","quote":"Repeat the customer's own words when you name the fault.","text":"{\"limits\": []}","usage":{"input":263,"output":9}}
{"key":"d43f3ad2b62c357251a6015a4af9b7373a2d51d22b4b11dde510f41ef64d2a7e","quote":"Give one next step, never three.","text":"{\"limits\": [{\"limit\": 1, \"comparison\": \"le\", \"unit\": \"next steps per response\"}]}","usage":{"input":255,"output":38}}
{"key":"144594be3e2e129ce2733d3184544e7388f014c1b15e6f0b3c00518440affb2f","quote":"Say \"connection\" and not \"service\".","text":"{\"limits\": []}","usage":{"input":257,"output":9}}
{"key":"9b3ba612a5b4bad8f3eff21b08fc930b1049ebaa43767c228201d9612147cb3b","quote":"Do not use the word \"ticket\" in the first message to an anxious customer.","text":"{\"limits\": []}","usage":{"input":269,"output":9}}
{"key":"4cf392141972478164c351fd56796512e46bf1a5b75810309cec4636a5a937d0","quote":"Do not add a new offer.","text":"{\"limits\": []}","usage":{"input":255,"output":9}}
{"key":"723b1d928a52860b37b6aa39f3729d889fcde19d898fbd9845dc5211e5a3e94a","quote":"If a customer's request is not in your instructions, do not invent a policy.","text":"{\"limits\": []}","usage":{"input":268,"output":9}}
{"key":"249ec782f5c67c54f1cd2408843294dee1bd38302f5b5746b6cbf2ee2c023ed5","quote":"Say \"we\" for Quillfisher and \"you\" for the customer.","text":"{\"limits\": []}","usage":{"input":267,"output":9}}
{"key":"a0acb9a891af8a8b5d16d40caa26db6298b0301926518157b86c62805dda57b4","quote":"If two instructions seem to conflict, follow the safer one.","text":"{\"limits\": []}","usage":{"input":265,"output":9}}
{"key":"45ad6461bdc13001c59d322fa3b8831dfe812ff0b9ec73b1fd4d29b9f459866a","quote":"Say \"visit\" and not \"appointment\".","text":"{\"limits\": []}","usage":{"input":259,"output":9}}
{"key":"e9b6d460ff9ba41b9ca4be4a8e26e37ce2399567b91b851eaa681225d17a49d8","quote":"Tell the duty manager about the conflict in your handoff note.","text":"{\"limits\": []}","usage":{"input":266,"output":9}}
{"key":"8a55cb3705afbd0989b2ffc598d5956af07806095d83470788818e068e595d81","quote":"Open the line monitor for the customer's address before you ask them to do anything.","text":"{\"limits\": []}","usage":{"input":269,"output":9}}
{"key":"2d87afa6983385c92783f748babfacd022dff46a2bcb167e568a049f83a0b8c0","quote":"If the monitor shows down and the network team has a known outage for the street, tell the customer at once.","text":"{\"limits\": []}","usage":{"input":275,"output":9}}
{"key":"433c5da5d7c00e65f7d02376ae159f29ecaafae4fe9ff926230c9a09d81b1baa","quote":"Ask one question per message.","text":"{\"limits\": [{\"limit\": 1, \"comparison\": \"le\", \"unit\": \"questions per message\"}]}","usage":{"input":254,"output":37}}
{"key":"9be5b77d11cbc8469d2dbcb0e307896f1b4a081cc221d21ad47466573bd3a0e5","quote":"Give the outage reference and the estimated fix time from the network team's note.","text":"{\"limits\": []}","usage":{"input":268,"output":9}}
{"key":"571dd952dac4b47996943602b8256b2edc2f8f222830563c3748d3270d9ebc3b","quote":"Go on to step 2.","text":"{\"limits\": []}","usage":{"input":254,"output":9}}
{"key":"964566924262e2a6862043bb774e5f389f7ae28895d0c0c96b14fa10eceb4c4a","quote":"Wait for the customer's reply before you ask the next question.","text":"{\"limits\": []}","usage":{"input":264,"output":9}}
{"key":"99d5ab3b652268f3af55f775155267104bad751b329f92b437e188def26443bb","quote":"If the lights show steady red, open a network ticket.","text":"{\"limits\": []}","usage":{"input":262,"output":9}}
{"key":"5c4850b7a32516d4d3f0cf1e78b98b20dc95a5f9b3a2a9332de9dd742f2db857","quote":"Add the address, the time the fault began and the answers you already have.","text":"{\"limits\": []}","usage":{"input":265,"output":9}}
{"key":"9a6142be9f50c59d7ed9128ea4447437da8c296ad0e76bb844ec7d05f9ac76fc","quote":"Do not ask the customer to reset the router to factory settings.","text":"{\"limits\": []}","usage":{"input":265,"output":9}}
{"key":"ae8d2aa014059e66866882391fdcdd673e579a7fa6fdb8d41b3f25501ce4a73a","quote":"Compare the result with the plan speed on the account.","text":"{\"limits\": []}","usage":{"input":261,"output":9}}
{"key":"55ee5fb1cd4449dfb6cb68a88ff4dd1e4d5a6d04ce61ab1af6aa157300db74ee","quote":"Book a technician only after the restart and the socket test have failed.","text":"{\"limits\": []}","usage":{"input":265,"output":9}}
{"key":"50db6bcd3ceb92171f55b2d716ad2c37658a6b2db16f39c69ee9b155783e95b4","quote":"If the lights are off, ask the customer to try another wall socket.","text":"{\"limits\": []}","usage":{"input":266,"output":9}}
{"key":"e53e587d63fbf6881b026b9acad2f9f37d675e7151f93525513606af90d4e80b","quote":"Do not offer evening slots; technicians do not work in the evening.","text":"{\"limits\": []}","usage":{"input":267,"output":9}}
{"key":"1df009a42bc95431ab946de4708ad2d37b62f401f3e1dd792a8eead37ff86dc1","quote":"Confirm the slot by repeating the day, the time window and the address.","text":"{\"limits\": []}","usage":{"input":267,"output":9}}
