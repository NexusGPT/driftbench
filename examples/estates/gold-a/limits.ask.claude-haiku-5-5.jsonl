{"key":"0ffae766ea4a478fb7381ca8644c22c9204baceeaf1cfd67396aa3195872e3b5","quote":"Say \"we\" for Quillfisher and \"you\" for the customer.","text":"{\"limits\": []}","usage":{"input":389,"output":9}}
{"key":"97fb8184a01e452ae268df995d5bd822ac13cf0f90d73e43972c26210e22a99d","quote":"If a customer's request is not in your instructions, do not invent a policy.","text":"{\"limits\": []}","usage":{"input":392,"output":9}}
