{"key":"535bd5b7d04ead2fc0eb7f0d7914a46ba7d061e1f4b3b7d53263e6a657e987d1#1","quote":"The invoice number","text":"{\"limits\": []}","usage":{"input":665,"output":9}}
{"key":"fb4eb9ba03fd0716a300f80c60468bfd50befb78dd98db7c16ea3767d8b62859#1","quote":"The line in dispute","text":"{\"limits\": []}","usage":{"input":659,"output":9}}
{"key":"2a9d5a0f2542e47b52e26d8abfbb71edb45becfdbf3365ec5da3c3c5af4de054#1","quote":"What the customer expects","text":"{\"limits\": []}","usage":{"input":659,"output":9}}
{"key":"413255ed62daedc64292a67a0752145be72761e1eb28b417d6fc857dea9c8e8f#1","quote":"Say what the bill shows and what you will do.","text":"{\"limits\": []}","usage":{"input":685,"output":9}}
{"key":"b494b081b2f9b77027c6c4ed1dd58f5737c2cb3d0809779f5336cf2b6efdb8e6#1","quote":"What you already told them","text":"{\"limits\": []}","usage":{"input":661,"output":9}}
{"key":"23236c731e985cbac4a03017b38fbfd8cc8b904496d73f6db68228a2b81b2a21#1","quote":"The date of the first complaint","text":"{\"limits\": []}","usage":{"input":670,"output":9}}
