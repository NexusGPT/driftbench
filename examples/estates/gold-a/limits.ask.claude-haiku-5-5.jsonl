{"key":"9f1efbd0b9cf873b2e292115c4679cadfea13ef056ccea00adf6eca89eb8f204#1","quote":"Wait for the customer's reply before you ask the next question.","text":"{\"limits\": []}","usage":{"input":857,"output":9}}
{"key":"f4565d553132008f6af1191b249350c1647856a9f45a69326a88cb42cd3a9452#1","quote":"If the lights show steady red, open a network ticket.","text":"{\"limits\": []}","usage":{"input":856,"output":9}}
{"key":"d02bf64036739e9d0a27f59a5b311ebf1a13e7cb7f07cce6c0a6363dd968a3a6#1","quote":"Add the address, the time the fault began and the answers you already have.","text":"{\"limits\": []}","usage":{"input":859,"output":9}}
{"key":"b4ea9d1d51e10a20d3d0adc87523424b7348a1877d8abe0b82f1ee9298038289#1","quote":"If the lights are off, ask the customer to try another wall socket.","text":"{\"limits\": []}","usage":{"input":899,"output":9}}
{"key":"c456c3a0655f059c9409804662a1c54361ee0668ae19b430b16d175bba46ad6e#1","quote":"Do not ask the customer to reset the router to factory settings.","text":"{\"limits\": []}","usage":{"input":854,"output":9}}
