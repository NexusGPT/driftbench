{"key":"3576454180e07e727679da5d143fe8357fb37d425b097aaf2ce31a5930382243","quote":"Repeat the customer's own words when you name the fault.","text":"{\"limits\": []}","usage":{"input":387,"output":9}}
{"key":"0f3a5229e58f744800d5e6544dad07beb8d354c5b2d0be162a76ddfa10c4525b","quote":"Open the line monitor for the customer's address before you ask them to do anything.","text":"{\"limits\": []}","usage":{"input":395,"output":9}}
