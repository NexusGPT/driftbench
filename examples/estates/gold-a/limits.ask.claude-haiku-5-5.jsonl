{"key":"79675458e9e00661e0fa4be4560ab313117217ff927c14274603df7c8fe02304","quote":"Repeat the customer's own words when you name the fault.","text":"{\"limits\": []}","usage":{"input":626,"output":9}}
{"key":"2dd78d3cd73feff5ea0cc17716114616b390f624b92978a5ed9142a968197f2c","quote":"Give one next step, never three.","text":"{\"limits\": [{\"limit\": 1, \"comparison\": \"le\", \"role\": \"constraint\", \"unit\": \"next steps\"}]}","usage":{"input":618,"output":44}}
