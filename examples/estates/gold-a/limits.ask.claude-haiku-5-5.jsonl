{"key":"4c86ec34a0531267eb8e57e155962c31a3ffff8bcc7fe03d8a0baf66bba0f80c","quote":"If the line is a charge the customer agreed to, explain it in one or two sentences.","text":"{\"limits\": [{\"limit\": 2, \"comparison\": \"le\", \"role\": \"constraint\", \"unit\": \"sentences\"}]}","usage":{"input":638,"output":44}}
{"key":"abd164d1cef2edad9e104f7489b6450cf78f5a144ae014f0286833cf8f35c19c","quote":"If the line looks wrong, do not argue and do not promise a refund.","text":"{\"limits\": []}","usage":{"input":634,"output":9}}
{"key":"163aba991221da0e41c275a7f61fe28ac480fa9d5538ad6081bbadbd53cd205b","quote":"The charge matches the plan","text":"{\"limits\": []}","usage":{"input":761,"output":9}}
{"key":"6c684a48a91bb6a2da9c1f4c4a182d33b2cee5b593c26518aea3e686cd313428","quote":"Explain the line and offer to send a copy of the plan terms","text":"{\"limits\": []}","usage":{"input":772,"output":9}}
