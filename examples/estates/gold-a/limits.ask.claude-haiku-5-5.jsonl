{"key":"2c8aab564bb7dd91bf72973740f89c009a121ea8192c541e9045d6a0d3a944cc","quote":"The ticket has been open for ten days with no fix","text":"{\"limits\": [{\"limit\": 10, \"comparison\": \"ge\", \"role\": \"trigger\", \"unit\": \"days\"}]}","usage":{"input":626,"output":43}}
{"key":"b1a0e499a72a5fd7e4406d8aa3c3fa4c20775c85083b9e426999405bcdbc8ff4","quote":"Hand the conversation to a person when:","text":"{\"limits\": []}","usage":{"input":623,"output":9}}
{"key":"115c88a42997e6b8819dcd4d450ee6e972220f25e458c1bac2f6db1ca6be5b35","quote":"The customer mentions a lawyer, a regulator or the press","text":"{\"limits\": []}","usage":{"input":630,"output":9}}
{"key":"1225627c877780a479d689f261c195c990c367489cf11fe79302e8100cd826f4","quote":"The customer asks for a person twice","text":"{\"limits\": [{\"limit\": 2, \"comparison\": \"ge\", \"role\": \"trigger\", \"unit\": \"requests from the customer for a person\"}]}","usage":{"input":621,"output":51}}
