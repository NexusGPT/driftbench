{"key":"c3fae95fcc49db6a506e4ba5518771a48643107faf8fa74b42ce5ffdbea11807#1","quote":"Do not quote these amounts as a threat.","text":"{\"limits\": []}","usage":{"input":865,"output":9}}
{"key":"39804ad6d75e91c6239ead0d4f75626d1fe26fded08eee9612824d6bc739c754#1","quote":"Mention them only if the customer asks what happens when equipment is lost.","text":"{\"limits\": []}","usage":{"input":873,"output":9}}
{"key":"bb73f53947f511c81397f0cfee8e076da2d04a217454d821c8f3b86094fb4064#1","quote":"If the customer asks where it is, look it up.","text":"{\"limits\": []}","usage":{"input":857,"output":9}}
