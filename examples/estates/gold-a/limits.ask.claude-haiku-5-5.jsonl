{"key":"bb9125bb1e5f3ea791c165164bb33b81dd60ff7d7464250d6601fe02591e96d7","quote":"Do not use it for a price quote on a new plan; that goes to sales.","text":"{\"limits\": []}","usage":{"input":385,"output":9}}
{"key":"bd3be752759a4490fd15832d2a87eaca60573a7bf686a7bd5a3c21be77101a90","quote":"Thank the customer for the details and say you are looking at the bill.","text":"{\"limits\": []}","usage":{"input":386,"output":9}}
{"key":"445f0f1c0d8002fbdc984625047b40ba340a9a9e838324b9e4c0a61081ba5448","quote":"Do not guess which line the customer means.","text":"{\"limits\": []}","usage":{"input":376,"output":9}}
{"key":"a90dec1278cf9436d98c442304e20a881b57d8c71e05e94a31e8b058ea1fd4ae","quote":"Read the bill line by line before you answer.","text":"{\"limits\": []}","usage":{"input":377,"output":9}}
{"key":"5c0889151e3f9f48b9fc18ada7444a9b59947d22b83a0f476e5d0f2227656437","quote":"If the line is a charge the customer agreed to, explain it in one or two sentences.","text":"{\"limits\": [{\"limit\": 2, \"comparison\": \"le\", \"unit\": \"sentences\"}]}","usage":{"input":392,"output":36}}
{"key":"ef6639119a0271f9939ca1bcba0754e84f10d961116ef60989356b376609f917","quote":"If the line looks wrong, do not argue and do not promise a refund.","text":"{\"limits\": []}","usage":{"input":388,"output":9}}
{"key":"03654b478b76c4a282b46bd6a0472ffeaf59011c9d8fd1ceee9819eca306d070","quote":"Say when they agreed to it and where it is written down.","text":"{\"limits\": []}","usage":{"input":382,"output":9}}
{"key":"d479d58526e21a7cc5dbf89ffb41ac43f72c7091da510aaf9edbf6d41232f74b","quote":"Name the line you are checking, so they know you read it.","text":"{\"limits\": []}","usage":{"input":382,"output":9}}
{"key":"a60f72474fc141b5d2b136f362bc149f8f746194ce8d7d7ffa3ef696cc1dfdc9","quote":"A charge appears twice","text":"{\"limits\": [{\"limit\": 5, \"comparison\": \"le\", \"unit\": \"working days\"}]}","usage":{"input":514,"output":35}}
{"key":"09ac00f7d7859457f2262f9ce2543f57be48ea9469c1f0bd1aa73bd51c509673","quote":"Explain the line and offer to send a copy of the plan terms","text":"{\"limits\": []}","usage":{"input":526,"output":9}}
{"key":"7ffe29c3340ab67c50594c374c57a6d2b51a2ee738679736d49ad1f567d1df6a","quote":"The charge matches the plan","text":"{\"limits\": []}","usage":{"input":515,"output":9}}
{"key":"2ae4276731af37733599e82076b62f7d8ad893fb54597cba4705c9dd0abc92eb","quote":"Say it looks like a duplicate and that billing will check it within five working days","text":"{\"limits\": [{\"limit\": 5, \"comparison\": \"le\", \"unit\": \"working days\"}]}","usage":{"input":529,"output":35}}
{"key":"d18ef5cd9bfee8108b442143a3fffb72f61b29eb6aeee3af95348b5c00a08d64","quote":"Say you have asked billing to look for it and give the ticket number","text":"{\"limits\": []}","usage":{"input":526,"output":9}}
{"key":"6dc77b08541276913697750cd0a07f8ba80a4c9f2377ae52dda9f03de0d2a1fb","quote":"A credit is missing","text":"{\"limits\": []}","usage":{"input":513,"output":9}}
{"key":"3ae07fef329a2c3efcc5c08e3daa42ff6b199a412b5cc60d68cef5903071c4dd","quote":"The customer disputes the plan fee","text":"{\"limits\": []}","usage":{"input":518,"output":9}}
{"key":"b85191354db38703fcbaf3fb1f04cfcd0c6e916db2f518f50e49d27ceb8dcdf3","quote":"Never say the customer is wrong.","text":"{\"limits\": []}","usage":{"input":377,"output":9}}
{"key":"e88634bb900fbbe8fb08ad36a31dcb63db8b925087bbcb9f2c5ad37e29c4fd0e","quote":"Answer the worry, not the tone.","text":"{\"limits\": []}","usage":{"input":378,"output":9}}
{"key":"5fcf263e84000d30504c09947df7798356f831a5f08cebeb87f00a2e60716906","quote":"Say what the bill shows and what you will do.","text":"{\"limits\": []}","usage":{"input":380,"output":9}}
{"key":"f38cfaa0a4802a10ad6985d973562abe954ce1f000076709205b6fc324751cf8","quote":"If the customer swears, stay polite and carry on.","text":"{\"limits\": []}","usage":{"input":382,"output":9}}
{"key":"44a32e69a99c9ef3f2b0f189951236023f0ae480162c0ce95f45108197cf8e64","quote":"A good billing ticket has five fields:","text":"{\"limits\": []}","usage":{"input":377,"output":9}}
{"key":"022ac1bc15184115afd30085c74ad7f3642647f617cbdd7f17537c792516847e","quote":"Do not discuss the price; say the billing team will contact them","text":"{\"limits\": []}","usage":{"input":525,"output":9}}
{"key":"0522ecfb6524b32b3f3f81e6dfaaa1a9961c36ca59ccb6595a50e65c5d53847d","quote":"The invoice number","text":"{\"limits\": []}","usage":{"input":370,"output":9}}
{"key":"52f297ba3c6eeed8f0c165d23998bf0bc70ac3b16cd14c246df08aac0859a7d2","quote":"The line in dispute","text":"{\"limits\": []}","usage":{"input":371,"output":9}}
{"key":"3c159c63134d596fc527d2ffb5baffd674a1cf179671f9c89a0dd95c878ff51f","quote":"The date of the first complaint","text":"{\"limits\": []}","usage":{"input":373,"output":9}}
{"key":"36cc324c234376fa4719991601557427d6ac7bce4b61842c590244ae2f9050e8","quote":"What you already told them","text":"{\"limits\": []}","usage":{"input":370,"output":9}}
{"key":"816654334bb94a64338c82aa86458addcb63ca72554210bdd3d2e8f04ce885d6","quote":"What the customer expects","text":"{\"limits\": []}","usage":{"input":371,"output":9}}
{"key":"d066797326cbd115f3ab9fc6c20e5afc579d6fad876b7c33e0f2d04fdfc8dfde","quote":"Copy the invoice number exactly as printed.","text":"{\"limits\": []}","usage":{"input":380,"output":9}}
{"key":"28b31839d62d0730317163f9f7b140ce96500e60c4bbcfef63548e10d16fa756","quote":"Do not paste the whole conversation into the ticket.","text":"{\"limits\": []}","usage":{"input":382,"output":9}}
{"key":"78ea937337922b5ae5bf8cb4cd57c4562edd09da3fa6e35a8d3fa1ee561c3379","quote":"Write a summary of three lines at most.","text":"{\"limits\": [{\"limit\": 3, \"comparison\": \"le\", \"unit\": \"lines\"}]}","usage":{"input":377,"output":35}}
{"key":"7dfb45ff973001ac45c9ef0cbf8b7ce09783a34ce5b35fb274be37c9e2ffda96","quote":"Explain this if they ask why their bill is lower than a neighbour's.","text":"{\"limits\": []}","usage":{"input":385,"output":9}}
{"key":"d8cb3e726c3960f7afbd58502c451e9bb74f51a2132e5262b6de091f1f1b042f","quote":"You never say a refund is approved.","text":"{\"limits\": []}","usage":{"input":373,"output":9}}
{"key":"d54d4f64322624b2185e05d15ba5a51d4894d3db485bc90321952498a14cd6c7","quote":"In that case check the move date before you open a ticket.","text":"{\"limits\": []}","usage":{"input":377,"output":9}}
{"key":"02fd7d4014df469a1d21e83a0e55dadadf87fe82278604794dfd10fbfea72279","quote":"Never start a return because a customer sounds unhappy.","text":"{\"limits\": []}","usage":{"input":380,"output":9}}
{"key":"8e8c52cb76d22071186eb3dad24855f1bc382e6dfcb7bcb6ba0de8928ec0b490","quote":"Ask which pieces of equipment they still have at home.","text":"{\"limits\": []}","usage":{"input":380,"output":9}}
{"key":"a5b3ff43f89a29bb058c18a8b866dd860fe69728f898048fd038787b62f91634","quote":"Write them down one by one in the ticket.","text":"{\"limits\": []}","usage":{"input":376,"output":9}}
{"key":"06293f7136145d3d86a27a8494a12bd28f1d932dfa1f47f47ef6c497e21aadb1","quote":"Close with the next step and who owns it.","text":"{\"limits\": []}","usage":{"input":376,"output":9}}
{"key":"22b51418bc1b904f5afac4d3849bc23224562e12d71f640ddb20e7e0bd166237","quote":"Tell the customer to pack the equipment in the original box if they have it.","text":"{\"limits\": []}","usage":{"input":383,"output":9}}
{"key":"8677bd7546f5c33daf08f3290a5bef8e90d71176a3b85bf6ccd5b456f1889786","quote":"The customer has the original box","text":"{\"limits\": []}","usage":{"input":492,"output":9}}
{"key":"9e28468895964a1b2626d492449064163c468a4528a20dd78b5330fc4ff995c3","quote":"The customer lost the power adapter","text":"{\"limits\": []}","usage":{"input":495,"output":9}}
{"key":"81adffc6dd1534fd670be7bb9fb4e578bd1b84410dfa5211459e0b1d3b460299","quote":"Send the label and say the box is enough","text":"{\"limits\": []}","usage":{"input":496,"output":9}}
{"key":"414427ae28c62fd72edea94fe5449f4b9733746d786fc7daa58b8b8849dbbac0","quote":"Note it on the ticket and say a fee may apply","text":"{\"limits\": []}","usage":{"input":501,"output":9}}
{"key":"78fc162b551f963cc63b7a6fcac92ef0ee78371ff86fdef734d931f55a27fae1","quote":"The customer lost the router","text":"{\"limits\": []}","usage":{"input":492,"output":9}}
{"key":"b25de33196d088935f4a2600aced42d1873bc3d9b40f114bf65346887db9d23e","quote":"Do not promise to waive the fee; send the ticket to billing","text":"{\"limits\": []}","usage":{"input":505,"output":9}}
{"key":"b657d5d543b06cb7396e8980d0ac43ca4e026a6de065b786e298314ae17d0f1b","quote":"The router is damaged","text":"{\"limits\": []}","usage":{"input":491,"output":9}}
{"key":"91746643e5a056888b8b1c0938249aad4d6ea8af5c7a8974617ff79800dba40e","quote":"Do not quote these amounts as a threat.","text":"{\"limits\": []}","usage":{"input":375,"output":9}}
{"key":"c71e3a1d948970d6149971617bdbd77a6f5a9b581db09e1d709be67b5b57bb90","quote":"Mention them only if the customer asks what happens when equipment is lost.","text":"{\"limits\": []}","usage":{"input":383,"output":9}}
{"key":"f0089633f4b438d3e34cd667a94bb696f5dbb50bd448b84f672dccf0e95315bf","quote":"If the customer asks where it is, look it up.","text":"{\"limits\": []}","usage":{"input":378,"output":9}}
{"key":"4032924fa4388f35ca9353aba1d6b5f6f07f694f20edbf5d293c6f365cf4509c","quote":"Do not tell them it is lost until five working days have passed.","text":"{\"limits\": [{\"limit\": 5, \"comparison\": \"ge\", \"unit\": \"working days\"}]}","usage":{"input":382,"output":36}}
{"key":"df8919e9521cb57baa4ab0ea53c65b95c5aaa3b3dc72c4a37f4189c944b381e4","quote":"You do not close return tickets by hand.","text":"{\"limits\": []}","usage":{"input":376,"output":9}}
{"key":"5497e2dd1e4efa00fe494543b3ca15ea5d7083b8097c759c2efa1604e3b2a0e5","quote":"Thank them for their time with us, and never try to talk them out of leaving.","text":"{\"limits\": []}","usage":{"input":386,"output":9}}
{"key":"07e895ad72f2bd443c605ea146d315e580f7ac893c8df6cf5833e4ed4a3ccf7a","quote":"Before you end the conversation, make sure that:","text":"{\"limits\": []}","usage":{"input":379,"output":9}}
{"key":"8e536dc2f465fe160de720967710785a2d7a610ab8ab20c925242049769bc019","quote":"Ask for a photo and attach it to the ticket","text":"{\"limits\": []}","usage":{"input":501,"output":9}}
{"key":"6b6cc5b3b2fea0b9b75cb01f4fabbe40ae9dc00a2a54b4cb47d8d9bcea88e4a0","quote":"The customer has a label or a drop-off address","text":"{\"limits\": []}","usage":{"input":378,"output":9}}
{"key":"064f625c9cba5eb2e19ece01b220990bcf950298996e3eda17b53d90024ca684","quote":"If they ask why we want the router back, say plainly that it is ours and that we reuse it.","text":"{\"limits\": []}","usage":{"input":391,"output":9}}
{"key":"d51bc3b1f062ce86a8c48e76b8d52d8a9dde7ce133a0f97d086491c7ac26ecfa","quote":"You told them the thirty-day limit","text":"{\"limits\": [{\"limit\": 30, \"comparison\": \"le\", \"unit\": \"days\"}]}","usage":{"input":376,"output":34}}
{"key":"547e8ae90c98c43078bba6f18aafc0ac90a45c30965446a1c6a4edeb94279c9b","quote":"Wish them well.","text":"{\"limits\": []}","usage":{"input":371,"output":9}}
{"key":"4f2257067d5a64c7ee4cdf0fc6a27f7e5a8d8b47329b3ad9644e3ca03ff3ffb5","quote":"Hand the conversation to a person when:","text":"{\"limits\": []}","usage":{"input":377,"output":9}}
{"key":"292079b794e4b75a41259602cc035dcc5a64b5f76ea42f12b4f9a91848321021","quote":"The customer asks for a person twice","text":"{\"limits\": [{\"limit\": 2, \"comparison\": \"ge\", \"unit\": \"times the customer asks for a person\"}]}","usage":{"input":375,"output":43}}
{"key":"9e2045492fcfad22cb7ae9a294498eb65fe0c2d108885d92dd52b85316915c6d","quote":"The customer mentions a lawyer, a regulator or the press","text":"{\"limits\": []}","usage":{"input":384,"output":9}}
{"key":"40d1012c4dc78cdf6601e896ee106ef0597f8ddc694697582235eefb5f1c6af1","quote":"The ticket lists every piece of equipment","text":"{\"limits\": []}","usage":{"input":378,"output":9}}
{"key":"ba895b3e12c06ba71dc13872684e01b89374019f20c4aed4568ff03c03a137a3","quote":"Do not hand off a conversation just because the customer is angry.","text":"{\"limits\": []}","usage":{"input":385,"output":9}}
{"key":"c8cf7c083004c0f611d0b867cd7e23e0bfdd95547998dc21afa8d42850123bcd","quote":"The ticket has been open for ten days with no fix","text":"{\"limits\": [{\"limit\": 10, \"comparison\": \"ge\", \"unit\": \"days\"}]}","usage":{"input":380,"output":35}}
{"key":"b0fc0ad6683f0a136eb04149ac118cd543eb2458245064c5913fd02cad6697af","quote":"You have given the same answer three times and the customer still disagrees","text":"{\"limits\": [{\"limit\": 3, \"comparison\": \"ge\", \"unit\": \"times the same answer has been given\"}]}","usage":{"input":383,"output":42}}
{"key":"c72384414a77a18d892f677456cfdafee3f1a458bed5a6d485158780fcfb8a28","quote":"Do not hand off to a person who is off shift.","text":"{\"limits\": []}","usage":{"input":381,"output":9}}
{"key":"4f763d63857558e35b7c868952337e66e40bcdf5e6559c725ef22c8d00b82d85","quote":"It must stand alone.","text":"{\"limits\": []}","usage":{"input":372,"output":9}}
{"key":"979086443e2826b12492d2dae8e7f3779aeddbd633f632f4c0f3be0b8a952669","quote":"Tell the customer who will contact them, how, and by when.","text":"{\"limits\": []}","usage":{"input":384,"output":9}}
{"key":"99caa7e26d5304045f856fb4fa5758efe59630c7129c421a6f42a857ea8c21d3","quote":"Keep the note under one hundred and twenty words.","text":"{\"limits\": [{\"limit\": 120, \"comparison\": \"lt\", \"unit\": \"words\"}]}","usage":{"input":381,"output":35}}
{"key":"1327f7ba2992cad47ac318da3fc1c5d941230f8d813cd5f27de047bbcc0752d1","quote":"Use the deadline in the table above and not a shorter one.","text":"{\"limits\": []}","usage":{"input":384,"output":9}}
{"key":"f428a989aa4f438b60cb272b191a25c6dbc408bff4076d91a54fffd85d731122","quote":"You do not edit the ticket again unless the customer writes in.","text":"{\"limits\": []}","usage":{"input":384,"output":9}}
{"key":"00fefee26621f044c0233606273c4d2d6dad3f9ca52e88c3cec3610eda18e290","quote":"Say \"a colleague in the billing team will email you within five working days\", not \"someone will be in touch\".","text":"{\"limits\": [{\"limit\": 5, \"comparison\": \"le\", \"unit\": \"working days\"}]}","usage":{"input":396,"output":35}}
{"key":"185b3feb434945e4e51f5738ea10860ab7669df991beaa972ae692dd86e37cc2","quote":"Never copy a handoff note into an email to the customer.","text":"{\"limits\": []}","usage":{"input":387,"output":9}}
{"key":"86004203e0435c55499dea7150d2a11741cebd168e1691317d1dbd826e4a4251","quote":"Never say \"I am transferring you\" if no one is on the line.","text":"{\"limits\": []}","usage":{"input":385,"output":9}}
{"key":"966d7b709241922e6d3d2753c1345d48c3a98dc2868f3eb4ba396e36ec60c908","quote":"Before you send the note, check that it names the account, the request and the deadline.","text":"{\"limits\": []}","usage":{"input":385,"output":9}}
{"key":"5d19682ad2f4f13a6aac6f699eede41e492e91be0a289f3abcc06ef0713aa315","quote":"Put the answer in the first line and the reason in the second.","text":"{\"limits\": []}","usage":{"input":378,"output":9}}
{"key":"e80312df1c413867cdd02190db784f8aa7d9731adf7bc0bc626386c3fc6d4aab","quote":"Ask what they were doing when it slowed down.","text":"{\"limits\": []}","usage":{"input":376,"output":9}}
{"key":"79728cc8b62c6c8e109a22e62a489b1ac1eb771fc8aebe6e42327c214a1ec7b1","quote":"Do not use the word \"ticket\" in the first message to an anxious customer.","text":"{\"limits\": []}","usage":{"input":384,"output":9}}
{"key":"4289499cfb0e5072b511bedc5a58ad3af96b8604a1312c7d9fb3c42d12dc3d3d","quote":"Do not add a new offer.","text":"{\"limits\": []}","usage":{"input":372,"output":9}}
{"key":"9e09118926e270c075fc0ce6e50e2b8526b6442df092f7f04a07cdddf92667fc","quote":"Repeat the customer's own words when you name the fault.","text":"{\"limits\": []}","usage":{"input":380,"output":9}}
{"key":"7d86c2a6c50180d843396fcba3f1371cb23ac024b7b864e127fd26ab1e41102e","quote":"Give one next step, never three.","text":"{\"limits\": [{\"limit\": 1, \"comparison\": \"le\", \"unit\": \"next steps per response\"}]}","usage":{"input":372,"output":38}}
{"key":"171c72bc050371c4865b83af7481ae707bb87b62237ddabe0f4c7789cd5321c1","quote":"Say \"visit\" and not \"appointment\".","text":"{\"limits\": []}","usage":{"input":374,"output":9}}
{"key":"06968a7dbcf02c05d4ff8cd6c1284a3b494d9908e4e1ff665bb6880848594da7","quote":"Say \"we\" for Quillfisher and \"you\" for the customer.","text":"{\"limits\": []}","usage":{"input":382,"output":9}}
{"key":"08a5528ae565d787a0690828adfbadf46c1d096b957792881ca6daa3e30e882f","quote":"Say \"connection\" and not \"service\".","text":"{\"limits\": []}","usage":{"input":372,"output":9}}
{"key":"d3db0707f61adf0fe50ef98e686092443d12cb8766f2d21515ddf923b24f02cf","quote":"If two instructions seem to conflict, follow the safer one.","text":"{\"limits\": []}","usage":{"input":382,"output":9}}
{"key":"53168f9d1e1c5d09df24e637d894e94d7c6264222d14c8f898d5f8838c91cd37","quote":"If a customer's request is not in your instructions, do not invent a policy.","text":"{\"limits\": []}","usage":{"input":385,"output":9}}
{"key":"4533020bb6e41153aa1795623e6ea68984b2019a357ad1cfbfdaaf7512b987e9","quote":"Tell the duty manager about the conflict in your handoff note.","text":"{\"limits\": []}","usage":{"input":383,"output":9}}
{"key":"c99a4aac561104d9a3eb9a1c30e8438c57781113575f720b982523554d4952ab","quote":"Give the outage reference and the estimated fix time from the network team's note.","text":"{\"limits\": []}","usage":{"input":387,"output":9}}
{"key":"eb9b1323eb52e9260aabe2b65e38dd4e9acc5b291755400f5916f6ecc3ba30f7","quote":"Open the line monitor for the customer's address before you ask them to do anything.","text":"{\"limits\": []}","usage":{"input":388,"output":9}}
{"key":"caae40eb89e880d7696c50f5c9051957676ca501835a66c4a940b511907d3bbc","quote":"If the monitor shows down and the network team has a known outage for the street, tell the customer at once.","text":"{\"limits\": []}","usage":{"input":394,"output":9}}
{"key":"c869eaecb9f5ca530e7b27eceedd3fc8dc0b959a1a48d5d60cf0c0364fc2c3c2","quote":"Go on to step 2.","text":"{\"limits\": []}","usage":{"input":373,"output":9}}
{"key":"9c561c43af47d7023fde428f97fc731dcd8d8a13691f5574f384865cf56d27c0","quote":"Ask one question per message.","text":"{\"limits\": [{\"limit\": 1, \"comparison\": \"le\", \"unit\": \"questions per message\"}]}","usage":{"input":375,"output":37}}
{"key":"1a7254b071d6d996a7c04ca67312140eb8b4c9a6a4121ea86558da3f9ea74456","quote":"Do not ask the customer to reset the router to factory settings.","text":"{\"limits\": []}","usage":{"input":383,"output":9}}
{"key":"3c929ceffa6e271e5d54155bf8a54b61f6b677bca092617115220824499a993a","quote":"Wait for the customer's reply before you ask the next question.","text":"{\"limits\": []}","usage":{"input":385,"output":9}}
{"key":"73dc031ea45c99addeff2bf9a54d85a216e04caee78f916d2c3cb49dd94f56ac","quote":"If the lights show steady red, open a network ticket.","text":"{\"limits\": []}","usage":{"input":380,"output":9}}
{"key":"310f82f0e06ff721234cd94cd3de13b0f4913f5d19c2af4cc23bb90a93cce22f","quote":"Add the address, the time the fault began and the answers you already have.","text":"{\"limits\": []}","usage":{"input":383,"output":9}}
{"key":"b36430362547b7628bbd9e95f9c52192700ecdc463be80d595d5c317a9438f19","quote":"If the lights are off, ask the customer to try another wall socket.","text":"{\"limits\": []}","usage":{"input":384,"output":9}}
{"key":"85cb086ec4bc3dc84ae1f0e3a8afb51963f79ecc557c5724378f8fa7e6251580","quote":"If every light is normal and the internet is still slow, run the speed check in the line monitor.","text":"{\"limits\": []}","usage":{"input":391,"output":9}}
{"key":"67aceb8dfbdba9d592fec617618bcbd14ce8a8d7956dc127d21a27e1e4897b9f","quote":"Compare the result with the plan speed on the account.","text":"{\"limits\": []}","usage":{"input":379,"output":9}}
{"key":"b2916d346c09c330944fef97d564176af11cee5c9fe48d81e61392ce07212e4d","quote":"Book a technician only after the restart and the socket test have failed.","text":"{\"limits\": []}","usage":{"input":382,"output":9}}
{"key":"fe56c28fd080be53c7bdfb88e613074d8257d1ef999964215f8aa5e5ce164ecc","quote":"Do not offer evening slots; technicians do not work in the evening.","text":"{\"limits\": []}","usage":{"input":384,"output":9}}
