{"key":"58bc0b3ca6b0501c8fde9e6315ad4ad8f626bd62473589b34d1b7696a8c71770","quote":"You have given the same answer three times and the customer still disagrees","text":"{\"limits\": [{\"limit\": 3, \"comparison\": \"ge\", \"role\": \"trigger\", \"unit\": \"times the same answer has been given\"}]}","usage":{"input":629,"output":50}}
{"key":"395d11b9f5375f1025b3d342480f8bd3d7bcc22e0b6dfb06f106b27e92aabbbb","quote":"It must stand alone.","text":"{\"limits\": []}","usage":{"input":618,"output":9}}
{"key":"88eb3cd537fd3399f1b219c57faa3fe23f8456231d22178eeba0748eb885732b","quote":"Keep the note under one hundred and twenty words.","text":"{\"limits\": [{\"limit\": 120, \"comparison\": \"lt\", \"role\": \"constraint\", \"unit\": \"words\"}]}","usage":{"input":627,"output":43}}
{"key":"68e0c9ac7ed338445cc515db2ad8a5fb5d3043bd4b55dc209a3fbc7c2cef0eaf","quote":"Tell the customer who will contact them, how, and by when.","text":"{\"limits\": []}","usage":{"input":630,"output":9}}
{"key":"2a9eda30be14888b6981d3e0a8b066edd3c766c83f62bd9ff03baf31381fcff1","quote":"Use the deadline in the table above and not a shorter one.","text":"{\"limits\": []}","usage":{"input":630,"output":9}}
{"key":"908bf1c4e82c6c690b7a59653cafa3ec1a1587e45d031ef8e9f614d70eac8ff2","quote":"Never say \"I am transferring you\" if no one is on the line.","text":"{\"limits\": []}","usage":{"input":631,"output":9}}
{"key":"29dd7d9a3ece9ca056858a99327a303f8039a3d2554b9f15b831bb21d2dd2915","quote":"You do not edit the ticket again unless the customer writes in.","text":"{\"limits\": []}","usage":{"input":630,"output":9}}
{"key":"0f2e489a9219bbf3a767786d305d07eb368ff13dc0f113c2651263a528dbd8a7","quote":"Say \"a colleague in the billing team will email you within five working days\", not \"someone will be in touch\".","text":"{\"limits\": [{\"limit\": 5, \"comparison\": \"le\", \"role\": \"constraint\", \"unit\": \"working days\"}]}","usage":{"input":642,"output":43}}
{"key":"88d7e1d3429b75e15a7a339e30fa3001bf0507ad06626f072f88330d1a30c144","quote":"Never copy a handoff note into an email to the customer.","text":"{\"limits\": []}","usage":{"input":633,"output":9}}
{"key":"a24fe7e7986d73b5dc1d7dd200f1f7f9b754b22020a8d7477fb3f70f928522cf","quote":"Before you send the note, check that it names the account, the request and the deadline.","text":"{\"limits\": []}","usage":{"input":631,"output":9}}
{"key":"ae1c09a96cecc5bb92959fb72d7dd13e1d3c003419f13d93479b3cb801e4ceaf","quote":"Ask what they were doing when it slowed down.","text":"{\"limits\": []}","usage":{"input":622,"output":9}}
{"key":"4cc601f3bba9effe2f1e0a2745f18389770167e903ba4c65e0dd86e67c3a3491","quote":"Do not use the word \"ticket\" in the first message to an anxious customer.","text":"{\"limits\": []}","usage":{"input":630,"output":9}}
