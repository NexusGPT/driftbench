{"key":"2dfeb6f3187e1e946dff240fd83e0c7363de972ca94a800369a50578fc802aed#1","quote":"Read the bill line by line before you answer.","text":"{\"limits\": []}","usage":{"input":848,"output":9}}
{"key":"59ae725c79af4252f212f94839580fe926054cf8dd4f60abbcda86975aadb216#1","quote":"Do not use it for a price quote on a new plan; that goes to sales.","text":"{\"limits\": []}","usage":{"input":831,"output":9}}
{"key":"ac4b41f874f3e000e6048806c8d51149a37b8e62e58cf4a16f8b113f4e4177f7#1","quote":"Do not guess which line the customer means.","text":"{\"limits\": []}","usage":{"input":847,"output":9}}
{"key":"16db49a4812bcaa4c4a8f188dca1676e1aefb891c951890461d81c5d460ab0ce#1","quote":"Thank the customer for the details and say you are looking at the bill.","text":"{\"limits\": []}","usage":{"input":868,"output":9}}
{"key":"80bbe56c5100d292c6c1ae3b7b557f3086413d4a46587375baa5e6de954346a5#1","quote":"Name the line you are checking, so they know you read it.","text":"{\"limits\": []}","usage":{"input":864,"output":9}}
{"key":"5923ae00aa81d0f8854e21dd41935336f954016a17db31d746dc5b35fe750fd2#1","quote":"If the line is a charge the customer agreed to, explain it in one or two sentences.","text":"{\"limits\": [{\"limit\": 2, \"comparison\": \"le\", \"role\": \"constraint\", \"unit\": \"sentences\"}]}","usage":{"input":899,"output":44}}
{"key":"5a68a378b5529dc01de90e66abc48c653684b89bf9b1768fab56906265144d90#1","quote":"Say when they agreed to it and where it is written down.","text":"{\"limits\": []}","usage":{"input":889,"output":9}}
{"key":"234992c47a89863c6407bb359b6e5e2b1bd425d20476d8164acb6623e11388e1#1","quote":"Explain the line and offer to send a copy of the plan terms","text":"{\"limits\": []}","usage":{"input":1009,"output":9}}
{"key":"aa7c2623539dcfefd357e354b586c52318de176a3fd483d0bbe255a1f43394f9#1","quote":"If the line looks wrong, do not argue and do not promise a refund.","text":"{\"limits\": []}","usage":{"input":863,"output":9}}
{"key":"f7c5e3859ddf008ae24ee4a872c7c8984597bce66162bea5b8b0a73b6c2bd3be#1","quote":"Say it looks like a duplicate and that billing will check it within five working days","text":"{\"limits\": [{\"limit\": 5, \"comparison\": \"le\", \"role\": \"constraint\", \"unit\": \"working days\"}]}","usage":{"input":1023,"output":43}}
{"key":"bbfb2a26eea5d62d2db2f7f01c3b21595604c9324604b468e61b21e75d4aec4b#1","quote":"A charge appears twice","text":"{\"limits\": [{\"limit\": 5, \"comparison\": \"le\", \"role\": \"constraint\", \"unit\": \"working days\"}]}","usage":{"input":1008,"output":43}}
{"key":"46ff361eac797f465848d426b55ea9d55134c9b440f53fda20af1508b36b2b03#1","quote":"A credit is missing","text":"{\"limits\": []}","usage":{"input":1015,"output":9}}
{"key":"b1a65f0304584adc9276e3ec68ec30dd23aeadf76d7cfda369842bce241838c9#1","quote":"The charge matches the plan","text":"{\"limits\": []}","usage":{"input":998,"output":9}}
{"key":"53a53e95769fd862fa0a6a6a848acfd48a06484eaf076139631b96f1cd2961cc#1","quote":"The customer disputes the plan fee","text":"{\"limits\": []}","usage":{"input":996,"output":9}}
{"key":"a97030eaa87e6e54c5ff761b7a29a55ea585c0e9a86f13cc3e2abf9eaf07757d#1","quote":"Do not discuss the price; say the billing team will contact them","text":"{\"limits\": []}","usage":{"input":1003,"output":9}}
{"key":"937f71d5a7222ed4c9bd254056ba12f57cec058ee685593c3beb198b73b92f61#1","quote":"Say you have asked billing to look for it and give the ticket number","text":"{\"limits\": []}","usage":{"input":1028,"output":9}}
