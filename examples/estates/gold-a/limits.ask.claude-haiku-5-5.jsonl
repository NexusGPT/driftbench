{"key":"f426f9219736c30c5afaad5e8d752db504dc0f1c8e0299223ff9c8aa32467606#1","quote":"Do not paste the whole conversation into the ticket.","text":"{\"limits\": []}","usage":{"input":664,"output":9}}
{"key":"bf6fbd095804bbd7b8858c85dfed38fa1bf009d276778a2c3aba8e236b849b6c#1","quote":"You never say a refund is approved.","text":"{\"limits\": []}","usage":{"input":657,"output":9}}
{"key":"378ba9d1208aba2b657f8dac1bbc6efd93b48a358de567038e12b51b21b0edac#1","quote":"Write a summary of three lines at most.","text":"{\"limits\": [{\"limit\": 3, \"comparison\": \"le\", \"role\": \"constraint\", \"unit\": \"lines\"}]}","usage":{"input":659,"output":43}}
{"key":"6800a8e41d35ccb4713f325feac062037b7bc6605172d81c55e379d49c36d70e#1","quote":"Explain this if they ask why their bill is lower than a neighbour's.","text":"{\"limits\": []}","usage":{"input":712,"output":9}}
{"key":"f89a07381405f24ad906ba4f1b03627ca47ff54b9e6b7c5b9b7ed866d28849bf#1","quote":"In that case check the move date before you open a ticket.","text":"{\"limits\": []}","usage":{"input":694,"output":9}}
{"key":"aa42db209ec84da7b23d929bce190947aa0c242414b3ea868ba76febbd6906be#1","quote":"Close with the next step and who owns it.","text":"{\"limits\": []}","usage":{"input":667,"output":9}}
{"key":"a805cc0854c2056a648b9b540e9cd6decacafd5d519fcfe22b086919d76f8ffa#1","quote":"Never start a return because a customer sounds unhappy.","text":"{\"limits\": []}","usage":{"input":661,"output":9}}
{"key":"dce3f8cc8c2f91e7933bc47c614ba4552a2fce17df12683353406125f9e83728#1","quote":"Ask which pieces of equipment they still have at home.","text":"{\"limits\": []}","usage":{"input":683,"output":9}}
{"key":"a4623972527d32d39a22cf94e21425095d598a09bd20d3222b00eeba4e258eb6#1","quote":"Tell the customer to pack the equipment in the original box if they have it.","text":"{\"limits\": []}","usage":{"input":684,"output":9}}
