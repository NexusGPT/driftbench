{"key":"e37ee1b38c2999b1d7a12d826fe7d1dafd07a924d002bf343141b89b17a88c25","quote":"You have given the same answer three times and the customer still disagrees","text":"{\"limits\": [{\"limit\": 3, \"comparison\": \"ge\", \"unit\": \"times the same answer has been given to the customer\"}]}","usage":{"input":390,"output":46}}
{"key":"304124c179f7ed78a0bfb33e962daad59a3e3e304e11bff5b7c2255d21fc26e5","quote":"If the customer asks where it is, look it up.","text":"{\"limits\": []}","usage":{"input":385,"output":9}}
{"key":"1b0544093c113805b05656b624b1c2c1f5a6ad11d3551208e15e8823fdfa50d8","quote":"Keep the note under one hundred and twenty words.","text":"{\"limits\": [{\"limit\": 120, \"comparison\": \"lt\", \"unit\": \"words\"}]}","usage":{"input":388,"output":35}}
{"key":"8c0f7f78a66f008a056cd4189792e4e28a7d462ae6f5b86158c9c38f65376534","quote":"Use the deadline in the table above and not a shorter one.","text":"{\"limits\": []}","usage":{"input":391,"output":9}}
