{"key":"168a69d1a3302f67db1b9fd849311a0f78b42b0be25f5e6a6eaee25195edfa47#1","quote":"Do not use the word \"ticket\" in the first message to an anxious customer.","text":"{\"limits\": []}","usage":{"input":890,"output":9}}
{"key":"bdb5e2e0db60646e931eb245af8a45216b98c56617ab862f31fbe5ce0cf791af#1","quote":"Repeat the customer's own words when you name the fault.","text":"{\"limits\": [{\"limit\": 1, \"comparison\": \"le\", \"role\": \"constraint\", \"unit\": \"repetitions of the customer's own words\"}]}","usage":{"input":845,"output":52}}
{"key":"74cf40d7d992cdc546a0730294020bee6abbd804fc82a834cd419361bba233ad#1","quote":"Give one next step, never three.","text":"{\"limits\": [{\"limit\": 1, \"comparison\": \"le\", \"role\": \"constraint\", \"unit\": \"next steps\"}]}","usage":{"input":889,"output":44}}
{"key":"15fe201085f07cf8f87db3a04811d4891a71091efdba9965665d4d349cade9c4#1","quote":"Do not add a new offer.","text":"{\"limits\": []}","usage":{"input":847,"output":9}}
{"key":"6d71a90ac5a3e464baccf54c7ff34bf20d6c08420370128346898cb746afa247#1","quote":"Say \"connection\" and not \"service\".","text":"{\"limits\": []}","usage":{"input":860,"output":9}}
{"key":"738394c1d1512f67a63e1df1c9d8bca6b2f1f2968635be8cf4b5bae6647e4210#1","quote":"Say \"we\" for Quillfisher and \"you\" for the customer.","text":"{\"limits\": []}","usage":{"input":870,"output":9}}
{"key":"88031472bc5beada26cc019b06d25a07314e07443ed23c0e733f972181def219#1","quote":"Say \"visit\" and not \"appointment\".","text":"{\"limits\": []}","usage":{"input":862,"output":9}}
{"key":"c3a13f782773eb6dd9ad2d77a9850a79cd6559622310823ec0dd3bc8a9638ec6#1","quote":"If a customer's request is not in your instructions, do not invent a policy.","text":"{\"limits\": []}","usage":{"input":860,"output":9}}
{"key":"d7eadb0416ec81f128519bd2e8dcdb926c086ab61e1c217e86d3f7851a8b61a6#1","quote":"If two instructions seem to conflict, follow the safer one.","text":"{\"limits\": []}","usage":{"input":855,"output":9}}
{"key":"4ec1898f48ea6cf2da693ff35c0e98d75307f2369e2594463f3f5d77f08e4c20#1","quote":"Open the line monitor for the customer's address before you ask them to do anything.","text":"{\"limits\": []}","usage":{"input":873,"output":9}}
{"key":"e8214474f3879eb903eed061e36255b8e23ef21981e4c4c1f7860044aeed1900#1","quote":"If the monitor shows down and the network team has a known outage for the street, tell the customer at once.","text":"{\"limits\": []}","usage":{"input":902,"output":9}}
