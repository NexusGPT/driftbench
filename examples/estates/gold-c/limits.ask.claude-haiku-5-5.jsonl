{"key":"a15e5797c26963755f941dd57daec682aac213462e935b5c536c675cf5df0b87","quote":"If two tabs seem to conflict, the safer one wins.","text":"{\"limits\": []}","usage":{"input":392,"output":9}}
{"key":"f929a0b1c51d564a908d6c2c7005ef4db4007d2d3293aafb207346818201a4ad","quote":"Tell the front desk about the conflict in your note.","text":"{\"limits\": []}","usage":{"input":389,"output":9}}
{"key":"1801fca179b4e18b5156a18517168f86b3a9c9e8bfd6baf8003b06e57bb26bfe","quote":"Read the tab that matches the channel of the message and ignore the others.","text":"{\"limits\": []}","usage":{"input":389,"output":9}}
{"key":"639ddf71286f6b7e92f512397607c86d7ca25676ecc74f07aaa4acb5725ab864","quote":"Be warm and brief.","text":"{\"limits\": []}","usage":{"input":382,"output":9}}
{"key":"1644c519a3abb7794484933bfbd20b5043d8bb9a680ce76fa5157d7cdccf0845","quote":"If you cannot tell the channel, use the web chat tab.","text":"{\"limits\": []}","usage":{"input":387,"output":9}}
{"key":"18b580fa0394cebbfd6b24ecd34528f2c4adb1976edede680946a1c48607c549","quote":"Never promise a room you have not seen as free.","text":"{\"limits\": []}","usage":{"input":388,"output":9}}
