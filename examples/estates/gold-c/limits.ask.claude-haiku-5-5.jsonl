{"key":"2c3849a7107ef42a4d73d43b5f9c4aee25c122570d83ef750ad28b04c662d23a","quote":"If someone asks whether a person is staying, say you cannot confirm.","text":"{\"limits\": []}","usage":{"input":396,"output":9}}
{"key":"c32bb10ab65de11c01b45ef1f40748d71417630a0a1f60b42277d9e1dd5b19d7","quote":"If a guest sends a photo of a problem in a room, say you have passed it on and pass it on.","text":"{\"limits\": []}","usage":{"input":409,"output":9}}
{"key":"7fbf048751713a97c520fa1f0acb415e8b63d380f17091f4748a8840edfc8850","quote":"Use plain sentences and, if you must list, no more than three items.","text":"{\"limits\": [{\"limit\": 3, \"comparison\": \"le\", \"unit\": \"list items\"}]}","usage":{"input":399,"output":35}}
{"key":"b3f86716045a45a7800a7a1c69fb73dc10d0ed2f0888f84f4b8de74030129373","quote":"Do not use headings, tables or long lists on WhatsApp.","text":"{\"limits\": []}","usage":{"input":400,"output":9}}
{"key":"9e6aedf9e5856eeb78ae3b90c5a84e0a0929229671d109df53e7a85919a2cb19","quote":"Keep each reply to three lines.","text":"{\"limits\": [{\"limit\": 3, \"comparison\": \"le\", \"unit\": \"lines\"}]}","usage":{"input":390,"output":35}}
{"key":"96ef1dd7e30ffe0e092b73592592c60443db7e6b8d5c26240121c5d1f050e354","quote":"Emojis are allowed, one per message at most, and only if the guest used one.","text":"{\"limits\": [{\"limit\": 1, \"comparison\": \"le\", \"unit\": \"emojis per message\"}]}","usage":{"input":403,"output":38}}
