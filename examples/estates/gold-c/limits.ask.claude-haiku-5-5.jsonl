{"key":"9869526afdc6100ce90e84ef9cf254d83aa592a0ec4f796ca7543fbca43ffc45","quote":"Do not read out a list longer than three items.","text":"{\"limits\": [{\"limit\": 3, \"comparison\": \"le\", \"unit\": \"items in a list read out\"}]}","usage":{"input":389,"output":39}}
{"key":"f5024fbcedf1666900be65aa5c25305ecac3b2d9070b20f626c78ccdf0030553","quote":"Write short sentences that sound natural when spoken.","text":"{\"limits\": []}","usage":{"input":392,"output":9}}
