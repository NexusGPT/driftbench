{"key":"68c430cd6691c605065df9f3a35b1e6a6f5e149862f8366d3aff86219291866c#1","quote":"Use plain sentences and, if you must list, no more than three items.","text":"{\"limits\": [{\"limit\": 3, \"comparison\": \"le\", \"role\": \"constraint\", \"unit\": \"items in a list\"}]}","usage":{"input":879,"output":45}}
{"key":"7d3dc7dc65aa8eae6aeac93f36f51fd973bc320fa0a0d2a173200bf55dca2805#1","quote":"Emojis are allowed, one per message at most, and only if the guest used one.","text":"{\"limits\": [{\"limit\": 1, \"comparison\": \"le\", \"role\": \"constraint\", \"unit\": \"emojis per message\"}]}","usage":{"input":930,"output":46}}
{"key":"013ccc90b5350b1a03cf59b572ea4219744a40f13496446506fd38380f7d2a37#1","quote":"Start with a greeting and the guest's name, and end with your name and the guesthouse.","text":"{\"limits\": []}","usage":{"input":888,"output":9}}
