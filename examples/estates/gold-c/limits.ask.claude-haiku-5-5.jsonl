{"key":"9de299700ac05796e07f898cc6cedd194f316fef39ff6186b26a08035d413110#1","quote":"If they say \"chilly\", say \"chilly\" and not \"inadequate heating\".","text":"{\"limits\": []}","usage":{"input":855,"output":9}}
{"key":"20607b29889cb356831a97a396cc47711f42ab0f38df84b2349d1970948060b7#1","quote":"If a request is not in your instructions, do not invent a rule.","text":"{\"limits\": []}","usage":{"input":860,"output":9}}
{"key":"7bfb4a2e0e2db9b1820b73b8f8ee38879807c37ab1d8625dfa7e3937589df8b8#1","quote":"If two tabs seem to conflict, the safer one wins.","text":"{\"limits\": []}","usage":{"input":892,"output":9}}
{"key":"37440887721403bf70cadcdeee1d15254c7bad09d5fef8d2ef783875d1371162#1","quote":"Do not add a new offer.","text":"{\"limits\": []}","usage":{"input":848,"output":9}}
{"key":"fb2e7d2290353947b32de92941021947d9cae500396c826b06cc912cdeda6e96#1","quote":"Tell the front desk about the conflict in your note.","text":"{\"limits\": []}","usage":{"input":889,"output":9}}
{"key":"45b684adf602afd82b0475e485916c1875114afc99b7f0c58dfcb34fcb5c0944#1","quote":"Read the tab that matches the channel of the message and ignore the others.","text":"{\"limits\": []}","usage":{"input":884,"output":9}}
{"key":"66d8c9f7d483a6220a1da3fb5d4c798e30ad7808e5e0177fbb2d23078064290d#1","quote":"If you cannot tell the channel, use the web chat tab.","text":"{\"limits\": []}","usage":{"input":882,"output":9}}
{"key":"78ee5b7572b127f601b6daf5b05377cf973a05566088591c51129768176831b7#1","quote":"Be warm and brief.","text":"{\"limits\": []}","usage":{"input":876,"output":9}}
{"key":"3bf390d893e819b597c8cd7e72948be869707f1dab72f91633ce256fe60fa926#1","quote":"Never promise a room you have not seen as free.","text":"{\"limits\": []}","usage":{"input":884,"output":9}}
{"key":"971204636ad3a37c4a6721aa2326cc6d672342f0a57d1377110cbcf6648a8ad5#1","quote":"Quote prices in pounds with the word per night or for the stay.","text":"{\"limits\": []}","usage":{"input":892,"output":9}}
{"key":"8c3ae8baf65b94f443dc3637566d32bbda47861a8bb277e7e0180575f69087dc#1","quote":"Check the booking calendar before you promise a room.","text":"{\"limits\": []}","usage":{"input":885,"output":9}}
{"key":"7cd317b18d78fc19cc0cffeaf4dd7b5be0770f2f14467741a57809683eda11f8#1","quote":"Breakfast is included; say so when you quote.","text":"{\"limits\": []}","usage":{"input":887,"output":9}}
{"key":"e2777c43deecbdd4a4c71e1c2ee7a4fa9794576598119b91d89eeb9faad79caf#1","quote":"Tell them to call 999 first.","text":"{\"limits\": []}","usage":{"input":874,"output":9}}
{"key":"ee92413da6b5d677e615c2ed37d4ee141b6a28d34eabf7df673cfb628001287c#1","quote":"Do not carry on with a booking while an emergency is open.","text":"{\"limits\": []}","usage":{"input":881,"output":9}}
