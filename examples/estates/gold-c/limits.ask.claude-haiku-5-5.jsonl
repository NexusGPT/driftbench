{"key":"bb4f7962e0a6c942a4495f6e4981188285691f2d78deb67546e893274c0b9646#1","quote":"Use a subject line that begins with the original subject.","text":"{\"limits\": []}","usage":{"input":876,"output":9}}
{"key":"965958880a6ec63d1132f6ebff69c5d49e27e31f694826b231ccadfd6f53bccf#1","quote":"Do not write more than twelve lines.","text":"{\"limits\": [{\"limit\": 12, \"comparison\": \"le\", \"role\": \"constraint\", \"unit\": \"lines\"}]}","usage":{"input":914,"output":43}}
