{"key":"c6ec97939ae380adcbb0fd49115bdaa6447bb45fbb76fee2ab936ebf8dd18efb","quote":"Breakfast is included; say so when you quote.","text":"{\"limits\": []}","usage":{"input":389,"output":9}}
{"key":"e8980e03fc491f0b64589ff705b83fad192f163cba236a2aeeda42eb60f99e71","quote":"Tell them to call 999 first.","text":"{\"limits\": []}","usage":{"input":385,"output":9}}
{"key":"06cb8b7de127879dec6d76a9289b57c413d260d295f7746a9627309b49c1b988","quote":"Then ring the duty owner on the number in the staff sheet.","text":"{\"limits\": []}","usage":{"input":394,"output":9}}
{"key":"18c631a5e783901444b2bfeb960ac7a8cbd5173048acf5cf393f59ad216d670b","quote":"Check the booking calendar before you promise a room.","text":"{\"limits\": []}","usage":{"input":389,"output":9}}
{"key":"3dbe1682605f9d696a9a4115bcd88558a2995dca9c6c4daa3b9947e3b4c8f201","quote":"Do not carry on with a booking while an emergency is open.","text":"{\"limits\": []}","usage":{"input":392,"output":9}}
{"key":"d954a2365b2c929e88689e7a22c72b9709788ebda923a36da25dc2019dba6b44","quote":"Never give one guest's name, room or dates to another person.","text":"{\"limits\": []}","usage":{"input":391,"output":9}}
