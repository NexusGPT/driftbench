{"key":"e7904d938d58c5eb3dcfe4a27f5ae71417dd2cbb7f5ac6453ab10bc7f31cbc2a","quote":"If two tabs seem to conflict, the safer one wins.","text":"{\"limits\": []}","usage":{"input":385,"output":9}}
{"key":"b0c454fcb19ff59ea22c94678ab3f4d1c8e3ee8162003759e3a286d12f33e130","quote":"Tell the front desk about the conflict in your note.","text":"{\"limits\": []}","usage":{"input":382,"output":9}}
{"key":"b0534dee0504370c0a2e2b134c02c4f0cec79d3b305671f8f2e51d93f0641bf7","quote":"If you cannot tell the channel, use the web chat tab.","text":"{\"limits\": []}","usage":{"input":380,"output":9}}
{"key":"c2559dc1f0fc1c0d3e05ccce4363de67092696abf647339f2220abe3dcec0f44","quote":"Read the tab that matches the channel of the message and ignore the others.","text":"{\"limits\": []}","usage":{"input":382,"output":9}}
{"key":"f9b0c5339612bdfd31cda62e02371f67718478ac2f84ac499b797625089671d0","quote":"Be warm and brief.","text":"{\"limits\": []}","usage":{"input":375,"output":9}}
{"key":"6d0f0ad2c92b3e4c7295e0eac33d564932e22bfe79bdc33810d7edf6c392c077","quote":"Check the booking calendar before you promise a room.","text":"{\"limits\": []}","usage":{"input":382,"output":9}}
{"key":"14fcafd9f3b1649f8c6f7ca5248e915de613b2d57c5462cb2770e2407b077704","quote":"Never promise a room you have not seen as free.","text":"{\"limits\": []}","usage":{"input":381,"output":9}}
{"key":"58f5ed86fc347ad8fa984e391bcde1cc7de331343fed64bd2b09964cef4a0070","quote":"Quote prices in pounds with the word per night or for the stay.","text":"{\"limits\": []}","usage":{"input":387,"output":9}}
{"key":"2acc013e07d9e5039e5919fb3614a83fc80f367ad90f3a22443f0261e86a44b0","quote":"Breakfast is included; say so when you quote.","text":"{\"limits\": []}","usage":{"input":382,"output":9}}
{"key":"87595ad31a7b5b041de97a3c8dadb70021e8dc3ebdb2ad98c8397606c70a956d","quote":"Then ring the duty owner on the number in the staff sheet.","text":"{\"limits\": []}","usage":{"input":387,"output":9}}
{"key":"caf02b91afeccf163c4a756e084805d241050069eaf145a455e2463f025d2543","quote":"Do not carry on with a booking while an emergency is open.","text":"{\"limits\": []}","usage":{"input":385,"output":9}}
{"key":"e858e71fd41d90f8c4d454b6712eeda55acdc9ff83942636454612ab94c97b46","quote":"Tell them to call 999 first.","text":"{\"limits\": [{\"limit\": 999, \"comparison\": \"le\", \"unit\": \"emergency telephone number to call\"}]}","usage":{"input":378,"output":42}}
{"key":"3f04aed4b976f49dc50fb2f44a12806896b98f5d4f909609908a9129312ca6a3","quote":"If someone asks whether a person is staying, say you cannot confirm.","text":"{\"limits\": []}","usage":{"input":389,"output":9}}
{"key":"f318d62b62b5b39b30d1eff7dbd70b6a911adee2c3e82224ea4cb2661466b657","quote":"Keep each reply to three lines.","text":"{\"limits\": [{\"limit\": 3, \"comparison\": \"le\", \"unit\": \"lines\"}]}","usage":{"input":383,"output":35}}
{"key":"4c2e923d65d3f5d3d1611b1be5a056d251861ee8f4376e406c2a528b8407917a","quote":"Put the answer in the first line.","text":"{\"limits\": []}","usage":{"input":382,"output":9}}
{"key":"d03b999a35c37d0de5f7f0c1d5afe6c17845456700cc3c0d7e328f72f5dc870d","quote":"Do not use headings, tables or long lists on WhatsApp.","text":"{\"limits\": []}","usage":{"input":393,"output":9}}
{"key":"790c487071f10784f2ee2cebecc23c6cd0e0480f86d00998be1a5886fcf3673c","quote":"Use plain sentences and, if you must list, no more than three items.","text":"{\"limits\": [{\"limit\": 3, \"comparison\": \"le\", \"unit\": \"list items\"}]}","usage":{"input":392,"output":35}}
{"key":"f65e5c7c27e0a162a1aea28c2ae27a74aaa1d17c705eb6a1409b6d8a9429ac0d","quote":"Never give one guest's name, room or dates to another person.","text":"{\"limits\": []}","usage":{"input":384,"output":9}}
{"key":"73c8002b4a1cb8a6db9b74137e48b0d4b1b9ffd57da5cd077dabd8628f2d6aa6","quote":"If a guest sends a photo of a problem in a room, say you have passed it on and pass it on.","text":"{\"limits\": []}","usage":{"input":402,"output":9}}
{"key":"9d864953d7e590157f2e862733d782345d5c3b86e9947d99461c55ac2e88362a","quote":"Reply within the same minute.","text":"{\"limits\": [{\"limit\": 1, \"comparison\": \"le\", \"unit\": \"minute\"}]}","usage":{"input":381,"output":35}}
{"key":"fef1a98641053dc000a7fc1611e927353a152a97232e6ebe100d3e2384c1f49f","quote":"Emojis are allowed, one per message at most, and only if the guest used one.","text":"{\"limits\": [{\"limit\": 1, \"comparison\": \"le\", \"unit\": \"emojis per message\"}]}","usage":{"input":396,"output":38}}
{"key":"af8cd3b245db04906dee13021835f96c1a50f6161cb534ab16d6b27140ecc1c6","quote":"Answer every question in the email, in the order the guest asked.","text":"{\"limits\": []}","usage":{"input":386,"output":9}}
{"key":"58ff171f5d79e5a9d050bfabd175d6cf44817627701059f389256ef59ca8e238","quote":"Number the answers if there are more than two.","text":"{\"limits\": [{\"limit\": 2, \"comparison\": \"gt\", \"unit\": \"answers\"}]}","usage":{"input":380,"output":36}}
{"key":"94bed324d9e02ca3c2c94d2f4eef800026d21c33e62baac8f470f9b9a0d9e074","quote":"Start with a greeting and the guest's name, and end with your name and the guesthouse.","text":"{\"limits\": []}","usage":{"input":395,"output":9}}
{"key":"88fbe4e63a9c51e93749b95e2dbebd64484cf62be33440ef22985984f5cb7e53","quote":"Use a subject line that begins with the original subject.","text":"{\"limits\": []}","usage":{"input":383,"output":9}}
{"key":"9d400e96f81ef4f243bc0df24156604f7ef30395e41a7b536ac32e2557733690","quote":"Never put a card number or a password in an email.","text":"{\"limits\": []}","usage":{"input":381,"output":9}}
{"key":"96b0419138fea72f3552c30b416e6fe8ec1eb4a91c136eedc5e94ecb6b5f0523","quote":"Attach the booking confirmation as a pdf when you confirm a stay.","text":"{\"limits\": []}","usage":{"input":392,"output":9}}
{"key":"cdf083db6abc5c6c4fb75439fc921f40e1bea5d02a16bb1ea323d010bd6dc9d4","quote":"Do not write more than twelve lines.","text":"{\"limits\": [{\"limit\": 12, \"comparison\": \"le\", \"unit\": \"lines\"}]}","usage":{"input":380,"output":35}}
{"key":"f42a8c91bc6cf8aaef59d7c25f5c66653bff5d53e28768263d0a7afc365743d4","quote":"Ask the guest to ring the office to give payment details.","text":"{\"limits\": []}","usage":{"input":385,"output":9}}
{"key":"4765cadf3ad63cbbf482292c6555f0061f576021ab0fd8303d63540ff7dc2339","quote":"Write short sentences that sound natural when spoken.","text":"{\"limits\": []}","usage":{"input":385,"output":9}}
{"key":"ed266b450772e1d21037ecd98f92175299ecdd2bb88fffe9ba0cca3b8e66e621","quote":"Say numbers in groups, such as ninety two pounds, and say dates with the day name.","text":"{\"limits\": []}","usage":{"input":397,"output":9}}
{"key":"0005a33d77f77b7a54c26420dd9abdbfca9250f118611ee470529745522840e7","quote":"Do not use symbols, brackets or web addresses.","text":"{\"limits\": []}","usage":{"input":386,"output":9}}
{"key":"c3d8ec64a71303a88df8e8423e9c740bcb20f4bc46a0314f52d9431183e6ab13","quote":"Do not read out a list longer than three items.","text":"{\"limits\": [{\"limit\": 3, \"comparison\": \"le\", \"unit\": \"items in a list read out\"}]}","usage":{"input":382,"output":39}}
{"key":"82d84f909a12f27d4dcee925118a1a8dad7f593badebc8b06d0043f098d38543","quote":"If the guest has been silent for five seconds, ask whether they are still there.","text":"{\"limits\": [{\"limit\": 5, \"comparison\": \"ge\", \"unit\": \"seconds of guest silence\"}]}","usage":{"input":392,"output":42}}
{"key":"c0eecafdbabb1396e47f811dbeb8262e36eb8b4ccecd7a7b05433fe5bf530057","quote":"Spell a booking reference one letter at a time.","text":"{\"limits\": []}","usage":{"input":384,"output":9}}
{"key":"bc56c340d0897d5d159adad8ed9a6b6c0b538cc8d3c35e237eb02ae0c2b0c767","quote":"Never put the guest on hold without saying why and for how long.","text":"{\"limits\": []}","usage":{"input":387,"output":9}}
{"key":"5d472f12156f3e201a93190e3d97273b668ed397684b3b93e5c55260d738b10f","quote":"Do not paste long paragraphs.","text":"{\"limits\": []}","usage":{"input":382,"output":9}}
{"key":"b7f24585e35beacaf52f175b907a3cd5bd2c0198c0946a80d1f3c1404590a04a","quote":"When the guest wants to book, ask for the name, dates and number of guests before anything else.","text":"{\"limits\": []}","usage":{"input":397,"output":9}}
{"key":"a6a75f62753ee3646040956b597343eb2d6d8cfc3336e2d37dd1eadfc772c6b6","quote":"Pass the conversation to the front desk when the guest asks for a person or asks for a discount.","text":"{\"limits\": []}","usage":{"input":399,"output":9}}
{"key":"715f4e5d9d5e0c8b7c8bd738836c107d95e18a98d525f43786f0ba5807083024","quote":"Write a note that names the guest, the dates and the request.","text":"{\"limits\": []}","usage":{"input":387,"output":9}}
{"key":"270a977e2b599705914297bf73481076b2fb49a56f87cdcca4dbb68dcaaf5a8b","quote":"Say who will answer and when, using the times in the staff sheet.","text":"{\"limits\": []}","usage":{"input":390,"output":9}}
{"key":"ebe9483a75d73af7924db076c1fbed5d3aa2244339864da2e3d68d1fdcb43060","quote":"Do not write again after that.","text":"{\"limits\": [{\"limit\": 1, \"comparison\": \"le\", \"unit\": \"message written after a given point\"}]}","usage":{"input":378,"output":39}}
{"key":"bade12b98194b3d58b16c786689a37fe6a7633441727a9b11b0d239332d622c9","quote":"Never say \"someone will call\" without a time.","text":"{\"limits\": []}","usage":{"input":383,"output":9}}
