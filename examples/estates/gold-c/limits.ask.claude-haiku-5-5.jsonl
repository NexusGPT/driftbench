{"key":"4ea4de43e66ac60725f4afa00618445c06e8f905e2d7bb7ff582afe553d29565","quote":"If two tabs seem to conflict, the safer one wins.","text":"{\"limits\": []}","usage":{"input":265,"output":9}}
{"key":"a85da566284aed6150dd8fbb67fb1fd8f325baecc0ccc89e3cf782efaf269def","quote":"Tell the front desk about the conflict in your note.","text":"{\"limits\": []}","usage":{"input":262,"output":9}}
{"key":"faf567f7b6d4f5d9c71bd56e7411a574e614fa0d21e8e421fae1bf4c7fcc9fc4","quote":"Read the tab that matches the channel of the message and ignore the others.","text":"{\"limits\": []}","usage":{"input":267,"output":9}}
{"key":"6b743b951f4c1f1f022928131fdb5d6ba2928d287fe49ad633905e79f84ce292","quote":"Be warm and brief.","text":"{\"limits\": []}","usage":{"input":254,"output":9}}
{"key":"80f726de2fa48b1cfc1bed057ca703d7a223c3a75919e671bfd60f8b8b9022b5","quote":"If you cannot tell the channel, use the web chat tab.","text":"{\"limits\": []}","usage":{"input":265,"output":9}}
{"key":"2194bfa72bec5fa037a85f1026a7220f8a080ab30c4cc47bf351c0c2c6f8df88","quote":"Check the booking calendar before you promise a room.","text":"{\"limits\": []}","usage":{"input":261,"output":9}}
{"key":"583a34858ab287d5a918b17b422fa170bd90f24bd10ee713cedd5b6521ef971b","quote":"Never promise a room you have not seen as free.","text":"{\"limits\": []}","usage":{"input":260,"output":9}}
{"key":"b1bf991689b244859f8dccde6fea3ea1b2c98209c6331d3941ad422354b8b89e","quote":"Breakfast is included; say so when you quote.","text":"{\"limits\": []}","usage":{"input":261,"output":9}}
{"key":"6c70f0ce92f2e1dbca644d971f4db27728054373db3ed2bf28c6cfd96fed16a7","quote":"Quote prices in pounds with the word per night or for the stay.","text":"{\"limits\": []}","usage":{"input":266,"output":9}}
{"key":"85235495fc5e5104e953fc88dd666179dd56ed36e7d1762207a4e540842117bc","quote":"Tell them to call 999 first.","text":"{\"limits\": []}","usage":{"input":257,"output":9}}
{"key":"8fd90552a16dedec91547fc544c6ad2f411f6729179e65fd66acf1466a47392a","quote":"Then ring the duty owner on the number in the staff sheet.","text":"{\"limits\": []}","usage":{"input":266,"output":9}}
{"key":"072a5da0d4ff93ceba522b44bc46b49f8b2b916605964a9618e2b95a1166c397","quote":"Do not carry on with a booking while an emergency is open.","text":"{\"limits\": []}","usage":{"input":264,"output":9}}
{"key":"144d15c2478023370d6725bd7e20a3fe9adf1826d00950af4ba1986bd783b708","quote":"Never give one guest's name, room or dates to another person.","text":"{\"limits\": []}","usage":{"input":263,"output":9}}
{"key":"fa3ad9bc4c7d1dd6f6392012ede41c6546a996ece09bce03da102827888a5f17","quote":"If someone asks whether a person is staying, say you cannot confirm.","text":"{\"limits\": []}","usage":{"input":268,"output":9}}
{"key":"69e0a5ef8aaa44c26cce88543bcca9615a2bc9d350a27a6be3a11f0b7359b514","quote":"Put the answer in the first line.","text":"{\"limits\": []}","usage":{"input":256,"output":9}}
{"key":"02a5120c7ff1992f297ec2ece66e310efde29f2ec4c504aba8ebd885aaebcacb","quote":"Do not use headings, tables or long lists on WhatsApp.","text":"{\"limits\": []}","usage":{"input":267,"output":9}}
{"key":"1027eed974c68a188d0aea8049409ab36c79cdf466fc645e8f93ba5807c9ddc6","quote":"If a guest sends a photo of a problem in a room, say you have passed it on and pass it on.","text":"{\"limits\": []}","usage":{"input":276,"output":9}}
{"key":"e9211b02ddbf91957e7e7f879ab9d574986d0638497b9e571fc55335a783492f","quote":"Use plain sentences and, if you must list, no more than three items.","text":"{\"limits\": [{\"limit\": 3, \"comparison\": \"le\", \"unit\": \"list items\"}]}","usage":{"input":266,"output":35}}
{"key":"50a0192a122e1ab56ae9a3288a3fc4057a495cb47062a0145a4e5759bfa7bfa5","quote":"Keep each reply to three lines.","text":"{\"limits\": [{\"limit\": 3, \"comparison\": \"le\", \"unit\": \"lines\"}]}","usage":{"input":257,"output":35}}
{"key":"4de842e5597c0c958307da8fb39e31543855e6e77b580f9eb07e48beef146719","quote":"Reply within the same minute.","text":"{\"limits\": [{\"limit\": 1, \"comparison\": \"le\", \"unit\": \"minute\"}]}","usage":{"input":255,"output":35}}
{"key":"114130c4a9de8e901f6eb9190995cf8b44aa5177a09c31694c3847af5b54c330","quote":"Emojis are allowed, one per message at most, and only if the guest used one.","text":"{\"limits\": [{\"limit\": 1, \"comparison\": \"le\", \"unit\": \"emojis per message\"}]}","usage":{"input":270,"output":38}}
{"key":"0e9180bd8be17895508f0ecc1c5266eece618b7724abeb6149a277ac5999e4c9","quote":"Answer every question in the email, in the order the guest asked.","text":"{\"limits\": []}","usage":{"input":264,"output":9}}
{"key":"08adecda5df426d6e928d1640afd30b07e07fc2205d3e758d63833b07a662330","quote":"Number the answers if there are more than two.","text":"{\"limits\": [{\"limit\": 2, \"comparison\": \"gt\", \"unit\": \"answers\"}]}","usage":{"input":258,"output":36}}
{"key":"1db0183029ea2c78edaee2d01ab28907cdc38558b6edc61fb39e0c6e5804796b","quote":"Start with a greeting and the guest's name, and end with your name and the guesthouse.","text":"{\"limits\": []}","usage":{"input":273,"output":9}}
{"key":"75b82a1db9b9c36aaf908376029cb2ef9d9df05f520151d08f95d90ed9661a8f","quote":"Use a subject line that begins with the original subject.","text":"{\"limits\": []}","usage":{"input":261,"output":9}}
{"key":"aa101e958e585839bcfad77cff50b0572573ccfa49af61e8921cf3d03980c92f","quote":"Do not write more than twelve lines.","text":"{\"limits\": [{\"limit\": 12, \"comparison\": \"le\", \"unit\": \"lines\"}]}","usage":{"input":258,"output":35}}
{"key":"10e9d26e1ea20743ddbb3eaff22f817b8889fb73495f2f07d8e94abe8bee5714","quote":"Ask the guest to ring the office to give payment details.","text":"{\"limits\": []}","usage":{"input":263,"output":9}}
{"key":"c97073ca3bca72977f4019e474b954e6ea74908c238940a7b11401519f6015e1","quote":"Never put a card number or a password in an email.","text":"{\"limits\": []}","usage":{"input":259,"output":9}}
{"key":"04c33f6855b4aa01b36a7cadbdc5af535c08a8bd2cfaf64c547b5a882b1afab4","quote":"Attach the booking confirmation as a pdf when you confirm a stay.","text":"{\"limits\": []}","usage":{"input":270,"output":9}}
{"key":"21c6a85ba4fe29c493b7f303a1211b3edf91ed1b37a45062b739f11520e915fb","quote":"Say numbers in groups, such as ninety two pounds, and say dates with the day name.","text":"{\"limits\": []}","usage":{"input":274,"output":9}}
{"key":"29ce81a737258e5e2dde1f608ed8c1e06924e1c7dadf35794f3a3cfd0dcb46ba","quote":"Do not use symbols, brackets or web addresses.","text":"{\"limits\": []}","usage":{"input":263,"output":9}}
{"key":"0d9ee1f864b8cd8de89d360d4ffccda0ce28247ccdacd3fcb89665093074959a","quote":"Write short sentences that sound natural when spoken.","text":"{\"limits\": []}","usage":{"input":262,"output":9}}
{"key":"5591ea3cfeed248891d20876037ae4a274ec9b912451b8abdad9ab05c1f4465b","quote":"Spell a booking reference one letter at a time.","text":"{\"limits\": []}","usage":{"input":261,"output":9}}
{"key":"fdb9851705d0d2c741466bc90719dec025f524bbb1c4a04167f16e4ba4018bb4","quote":"Do not read out a list longer than three items.","text":"{\"limits\": [{\"limit\": 3, \"comparison\": \"le\", \"unit\": \"items in a list read out\"}]}","usage":{"input":259,"output":39}}
{"key":"305fd89dcbb066bee8264319552f22250c309eff2927ecf40d8f6f36dee680ff","quote":"If the guest has been silent for five seconds, ask whether they are still there.","text":"{\"limits\": [{\"limit\": 5, \"comparison\": \"ge\", \"unit\": \"seconds of guest silence\"}]}","usage":{"input":269,"output":42}}
{"key":"f7480a58a056c049661e133b90d0e76bdacc312d1b1a7bff26981d5a77c77dc2","quote":"Do not paste long paragraphs.","text":"{\"limits\": []}","usage":{"input":258,"output":9}}
{"key":"f1616e97aeda867416b48ba71bf822f9c4a762b5e12f5516a58e5dc7008d96d1","quote":"Never put the guest on hold without saying why and for how long.","text":"{\"limits\": [{\"limit\": 0, \"comparison\": \"ge\", \"unit\": \"seconds of hold time before the agent must state the reason and expected duration\"}]}","usage":{"input":264,"output":55}}
{"key":"fb6cbd4ed5535c0a63e89f306da3ecc247050724273d6361d1d744fac277aea9","quote":"Do not write again after that.","text":"{\"limits\": []}","usage":{"input":254,"output":9}}
{"key":"8ca242ffa6cf7cddd95fcc0236dfe2fc2a7e3c3cec6573e7e63e4116aa8fabeb","quote":"When the guest wants to book, ask for the name, dates and number of guests before anything else.","text":"{\"limits\": []}","usage":{"input":273,"output":9}}
{"key":"9443e1171029f15c30ed5a388f24fdddea86d3dddbcf71c950cdff272d54e16d","quote":"Pass the conversation to the front desk when the guest asks for a person or asks for a discount.","text":"{\"limits\": []}","usage":{"input":275,"output":9}}
{"key":"8794e08394deb08ddc2313687451aa5aae675c66e88efcae02c90a3ee4d01b02","quote":"Write a note that names the guest, the dates and the request.","text":"{\"limits\": []}","usage":{"input":263,"output":9}}
{"key":"6e1690cb735536fc5d737513ca89e2907062a804547e75a495afb9ce40eca571","quote":"Never say \"someone will call\" without a time.","text":"{\"limits\": []}","usage":{"input":259,"output":9}}
{"key":"4183f0d09b2bc1c548d3255927a92652a137a22e31015667bc362ecd9a68bba1","quote":"Say who will answer and when, using the times in the staff sheet.","text":"{\"limits\": []}","usage":{"input":266,"output":9}}
