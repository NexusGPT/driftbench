{"key":"f425bc48df005a21f1b485dbf9bb54194a474b40e01976cf004357df4be39796#1","quote":"Give one next step, not three.","text":"{\"limits\": [{\"limit\": 1, \"comparison\": \"le\", \"role\": \"constraint\", \"unit\": \"next steps\"}]}","usage":{"input":694,"output":44}}
{"key":"ac398d78d1481889d55ab004e888ed2e78add05f127261cecf30021e77b743f2#1","quote":"If a request is not in your instructions, do not invent a rule.","text":"{\"limits\": []}","usage":{"input":668,"output":9}}
{"key":"07cffc13ce1aaef14c5c97bc2779d8f1a1babb5f0d2386251b08ae2b728f169c#1","quote":"Read the tab that matches the channel of the message and ignore the others.","text":"{\"limits\": []}","usage":{"input":692,"output":9}}
{"key":"1979a5070a59aeb5ceba928214bf1705ac348c9ea33e1b4258595b1ebc4251a1#1","quote":"If you cannot tell the channel, use the web chat tab.","text":"{\"limits\": []}","usage":{"input":690,"output":9}}
{"key":"701b123cca3b98ad528e3503e162664c07ce9dd4dd50f609ee96dd70e34df648#1","quote":"If two tabs seem to conflict, the safer one wins.","text":"{\"limits\": []}","usage":{"input":700,"output":9}}
{"key":"0284e95703c720334c1142525306c58cb151aa82574f22af087e9e74734869f1#1","quote":"Be warm and brief.","text":"{\"limits\": []}","usage":{"input":684,"output":9}}
{"key":"0c9ac4d74e890ad61e3fd26b5bf0880e5d116c1d9fae6ece1545be5873eb4650#1","quote":"Tell the front desk about the conflict in your note.","text":"{\"limits\": []}","usage":{"input":697,"output":9}}
{"key":"5cf7a4efa1fc7772b45581ecf0451c118663470a92aebbc65b1edd5dba7cb370#1","quote":"Check the booking calendar before you promise a room.","text":"{\"limits\": []}","usage":{"input":693,"output":9}}
{"key":"07efd443d24550e0b6e93888613b14631b80c25c3e4a841be376db1f69236906#1","quote":"Never promise a room you have not seen as free.","text":"{\"limits\": []}","usage":{"input":692,"output":9}}
{"key":"df5584b76883b2da50df80d07f50642e8e76d262250abe52992599477b094ad9#1","quote":"Quote prices in pounds with the word per night or for the stay.","text":"{\"limits\": []}","usage":{"input":700,"output":9}}
{"key":"9c73b518252757a7ae3c2f6c7b43d45498572cf08320565fca813ec6ecc7bf01#1","quote":"Breakfast is included; say so when you quote.","text":"{\"limits\": []}","usage":{"input":695,"output":9}}
{"key":"4cc307a7f9d01e43e6e25e12532f4d84a3b2c6bfef7effeaf6b37042c8249a44#1","quote":"Tell them to call 999 first.","text":"{\"limits\": []}","usage":{"input":682,"output":9}}
{"key":"0b51e824594dc5734a7947087c8bb55a1df4642017081bb617d38158e727b6c9#1","quote":"Then ring the duty owner on the number in the staff sheet.","text":"{\"limits\": []}","usage":{"input":691,"output":9}}
{"key":"cf7206802ffead2145ee2509ffba53de8b8eabc5ef2c6522f500c2122e4866c3#1","quote":"Do not carry on with a booking while an emergency is open.","text":"{\"limits\": []}","usage":{"input":689,"output":9}}
{"key":"599728d7995797d88efd81765df761bd3c6f8d426057e70541ccbcef5dee300f#1","quote":"Never give one guest's name, room or dates to another person.","text":"{\"limits\": []}","usage":{"input":669,"output":9}}
{"key":"0e795c52a6b5e1f214ab56d4a11aeec6563708ed2539468fae453f167f8d3834#1","quote":"If someone asks whether a person is staying, say you cannot confirm.","text":"{\"limits\": []}","usage":{"input":674,"output":9}}
{"key":"f77942895557ba1ffe0bdc5bb75dc0ef2dfaaef475a7c2166139c0c351e65d17#1","quote":"Keep each reply to three lines.","text":"{\"limits\": [{\"limit\": 3, \"comparison\": \"le\", \"role\": \"constraint\", \"unit\": \"lines\"}]}","usage":{"input":737,"output":43}}
{"key":"17094f2f6a8a6f4d4eac7fdeed16b539af2448db75855ee5cbbdbc2ca2fb7820#1","quote":"Put the answer in the first line.","text":"{\"limits\": []}","usage":{"input":694,"output":9}}
{"key":"168aa68849ba6824ea8a7ba38822955dd609e6a430b4ae1d320da510b0cce677#1","quote":"Do not use headings, tables or long lists on WhatsApp.","text":"{\"limits\": []}","usage":{"input":688,"output":9}}
{"key":"021e9f250dac1bd96dd2f268b46a0878a4171fb0bbe7eb9cc87d97ed7e44ed87#1","quote":"If a guest sends a photo of a problem in a room, say you have passed it on and pass it on.","text":"{\"limits\": []}","usage":{"input":708,"output":9}}
{"key":"265b395cc3efd29f4deb811d3be5be62efb28db2cddad55e4b6e3b9981cccc51#1","quote":"Reply within the same minute.","text":"{\"limits\": [{\"limit\": 1, \"comparison\": \"le\", \"role\": \"constraint\", \"unit\": \"minute\"}]}","usage":{"input":712,"output":43}}
{"key":"398fc08673f1c74150d43f6a5860e0df58d7dc5cc367b6da9c8a374360e7e76d#1","quote":"Emojis are allowed, one per message at most, and only if the guest used one.","text":"{\"limits\": [{\"limit\": 1, \"comparison\": \"le\", \"role\": \"constraint\", \"unit\": \"emojis per message\"}]}","usage":{"input":738,"output":46}}
{"key":"905e866ac90d95a258c34fdab8e587b3a16317baa98bc29bfa76bdc6a8c49ca7#1","quote":"Answer every question in the email, in the order the guest asked.","text":"{\"limits\": []}","usage":{"input":707,"output":9}}
{"key":"3315538efb321af00f3e7b688cd44c5f37d60c4672f1cfe216f64fcd973f376d#1","quote":"Use plain sentences and, if you must list, no more than three items.","text":"{\"limits\": [{\"limit\": 3, \"comparison\": \"le\", \"role\": \"constraint\", \"unit\": \"items in a list\"}]}","usage":{"input":687,"output":45}}
{"key":"bf7efb21b19c210a5fd9a456ca2d63913468c582da62fb4970162aa10440aa84#1","quote":"Number the answers if there are more than two.","text":"{\"limits\": [{\"limit\": 2, \"comparison\": \"gt\", \"role\": \"trigger\", \"unit\": \"answers\"}]}","usage":{"input":701,"output":44}}
{"key":"febbb6813b0d4540c5cdc13387052c976dfe79f0b3a1692de430117c68a3158f#1","quote":"Start with a greeting and the guest's name, and end with your name and the guesthouse.","text":"{\"limits\": []}","usage":{"input":696,"output":9}}
{"key":"ec336c0e03c02f537a362d147c9e24aec0d73efc3fe98acb9d1e1729437ad316#1","quote":"Use a subject line that begins with the original subject.","text":"{\"limits\": []}","usage":{"input":684,"output":9}}
{"key":"581bb17ab18c2d2748d1f76bc2e99defccc0363f10774012d1fce80f5e722500#1","quote":"Do not write more than twelve lines.","text":"{\"limits\": [{\"limit\": 12, \"comparison\": \"le\", \"role\": \"constraint\", \"unit\": \"lines\"}]}","usage":{"input":722,"output":43}}
{"key":"56cd461328b7ed0ca41b0cc34110808c63f312e52fbd49ddc4775f62b9faa933#1","quote":"Never put a card number or a password in an email.","text":"{\"limits\": []}","usage":{"input":704,"output":9}}
{"key":"0131ee9d76881b9f4536999242dcbffeaaa792acf6bba7cceebb3e706eccd247#1","quote":"Ask the guest to ring the office to give payment details.","text":"{\"limits\": []}","usage":{"input":708,"output":9}}
{"key":"345ea2efbd364242385bb15cfb8e628ba5e75b6aa083f99583f55c92f1c39004#1","quote":"Attach the booking confirmation as a pdf when you confirm a stay.","text":"{\"limits\": []}","usage":{"input":676,"output":9}}
{"key":"8786060ecc0c35efaaa7884595cb7325f881fdd56b285e4eb1e075830bff00e9#1","quote":"Write short sentences that sound natural when spoken.","text":"{\"limits\": []}","usage":{"input":704,"output":9}}
{"key":"1815da5c628ba1568a31e54dc733fdf82ae1721f62abc26ea0b624604fe6a749#1","quote":"Do not use symbols, brackets or web addresses.","text":"{\"limits\": []}","usage":{"input":745,"output":9}}
{"key":"7090116889b05a3c9bed656fac309a79f0fed28c33e2ee8f95dd0c38972aedeb#1","quote":"Spell a booking reference one letter at a time.","text":"{\"limits\": []}","usage":{"input":691,"output":9}}
{"key":"e5aade8072f1ffd6af190c0d199ed72b183691d5918a592574832862b05c887b#1","quote":"Say numbers in groups, such as ninety two pounds, and say dates with the day name.","text":"{\"limits\": []}","usage":{"input":704,"output":9}}
{"key":"7e8536310a0e34449aeb55f22e36c0390dbf04c342c06b59afd940fde161aee2#1","quote":"Do not read out a list longer than three items.","text":"{\"limits\": [{\"limit\": 3, \"comparison\": \"le\", \"role\": \"constraint\", \"unit\": \"items\"}]}","usage":{"input":697,"output":42}}
{"key":"95e3b99357c7fa68138fa7d6ee80695c97ab6e4eaea0a90fa46252e84e5d2693#1","quote":"If the guest has been silent for five seconds, ask whether they are still there.","text":"{\"limits\": [{\"limit\": 5, \"comparison\": \"ge\", \"role\": \"trigger\", \"unit\": \"seconds\"}]}","usage":{"input":699,"output":45}}
{"key":"ff84790f1638aaf2d2437810533324ef36472679fce1a7503175603296186163#1","quote":"Do not paste long paragraphs.","text":"{\"limits\": []}","usage":{"input":747,"output":9}}
{"key":"33cfba8500336099d0ae8b6664f9e6ad85d7cfd813f67d08ab12f3ed876be653#1","quote":"Never put the guest on hold without saying why and for how long.","text":"{\"limits\": []}","usage":{"input":673,"output":9}}
{"key":"61112bf7d121e6d56b86da52b0a19f67faa5232ed6f39c2d9c4c08049edb4e18#1","quote":"Do not write again after that.","text":"{\"limits\": []}","usage":{"input":694,"output":9}}
{"key":"ebb2e0b005295f5eb4e225a993e7fa1451b45eae61e903076ba8e7c1d1d4f2eb#1","quote":"Pass the conversation to the front desk when the guest asks for a person or asks for a discount.","text":"{\"limits\": []}","usage":{"input":683,"output":9}}
{"key":"cd2017314734ab513104abc083806132166c9602a884644b1120922deb425f63#1","quote":"When the guest wants to book, ask for the name, dates and number of guests before anything else.","text":"{\"limits\": []}","usage":{"input":672,"output":9}}
{"key":"45e1f327ca87f39942d8b31f81ec8abb293b2d5f6af5dfc4589cebf77ecb07b6#1","quote":"Write a note that names the guest, the dates and the request.","text":"{\"limits\": []}","usage":{"input":671,"output":9}}
{"key":"ae248fedc82b3fb53db1510315db643a8da40063f680a963f3ed13d0a1cedb2d#1","quote":"Never say \"someone will call\" without a time.","text":"{\"limits\": []}","usage":{"input":689,"output":9}}
{"key":"2004dd987993b81e677a379890334ba0bb2253186f5435b123b4b089ef8ffc14#1","quote":"Say who will answer and when, using the times in the staff sheet.","text":"{\"limits\": []}","usage":{"input":696,"output":9}}
