{"key":"3e132938b7f975b38e54f1bbafb040474fc4a328facf9b049be4df60aca46497","quote":"If a guest sends a photo of a problem in a room, say you have passed it on and pass it on.","text":"{\"limits\": []}","usage":{"input":648,"output":9}}
{"key":"41979cd3f690bf61b8acccd4eef301703b0631bfebb15cbd39c3c196b29836e2","quote":"Emojis are allowed, one per message at most, and only if the guest used one.","text":"{\"limits\": [{\"limit\": 1, \"comparison\": \"le\", \"role\": \"constraint\", \"unit\": \"emojis per message\"}]}","usage":{"input":642,"output":46}}
{"key":"4601783e19c333dcbe509acb766c729091129f5ec43a5dc8507b781d4a359729","quote":"Answer every question in the email, in the order the guest asked.","text":"{\"limits\": []}","usage":{"input":632,"output":9}}
{"key":"232c43280963a109d62f1f8391408bbdc48893e7208ea6374ece868442904f9a","quote":"Start with a greeting and the guest's name, and end with your name and the guesthouse.","text":"{\"limits\": []}","usage":{"input":641,"output":9}}
{"key":"3d3d9c3537058d01763fd08b192d040229065ff048cbb0db6eebdfcb61b57598","quote":"Use a subject line that begins with the original subject.","text":"{\"limits\": []}","usage":{"input":629,"output":9}}
{"key":"f0bf1e8e507bd540a35d00fe2d6d3599942a4c408d912af7c6b6a6c8f43b4f69","quote":"Do not write more than twelve lines.","text":"{\"limits\": [{\"limit\": 12, \"comparison\": \"le\", \"role\": \"constraint\", \"unit\": \"lines\"}]}","usage":{"input":663,"output":43}}
{"key":"20bcb95056600f6ef94ff08a5ca05015ec4eadd68a9fd894e07790224e923e2f","quote":"Number the answers if there are more than two.","text":"{\"limits\": [{\"limit\": 2, \"comparison\": \"gt\", \"role\": \"trigger\", \"unit\": \"answers\"}]}","usage":{"input":626,"output":44}}
{"key":"f47bad6bf73ca887aa85be2b9d3a246e59a971b24f8bf51944c048b2c3a5c7ff","quote":"Never put a card number or a password in an email.","text":"{\"limits\": []}","usage":{"input":627,"output":9}}
{"key":"f46acf58e1427815794a79f4de7cd161806da172a0a2a025599a77697bbfbb2a","quote":"Ask the guest to ring the office to give payment details.","text":"{\"limits\": []}","usage":{"input":631,"output":9}}
{"key":"1d94cf679399255df0a9819956678e3d09f4a1250f39c7949099735862ea6a63","quote":"Write short sentences that sound natural when spoken.","text":"{\"limits\": []}","usage":{"input":631,"output":9}}
{"key":"c53a757f0717f47b15524b7806cf146ae57e09c2bf854b1eaa0baac29a0d03b0","quote":"Attach the booking confirmation as a pdf when you confirm a stay.","text":"{\"limits\": []}","usage":{"input":638,"output":9}}
{"key":"fad2290ab2a56517e22816836c21a23c450d7d8e1cb4f6cbe18687d08e223b06","quote":"Do not use symbols, brackets or web addresses.","text":"{\"limits\": []}","usage":{"input":672,"output":9}}
{"key":"094701ab89fcec0e00f9b2cf7c24771ca649ac4ed2d256bd663263901f6a8a89","quote":"Do not read out a list longer than three items.","text":"{\"limits\": [{\"limit\": 3, \"comparison\": \"le\", \"role\": \"constraint\", \"unit\": \"items\"}]}","usage":{"input":628,"output":42}}
{"key":"0c7ae96bac6b85fab5e3f8668103560de93c4456e4bf759e13a8c8245a5e566a","quote":"Say numbers in groups, such as ninety two pounds, and say dates with the day name.","text":"{\"limits\": []}","usage":{"input":643,"output":9}}
{"key":"ae5271121362cd7ef8ffdb5cfd291865f4403d2c0fcdfec339361e582e0ee3a4","quote":"If the guest has been silent for five seconds, ask whether they are still there.","text":"{\"limits\": [{\"limit\": 5, \"comparison\": \"ge\", \"role\": \"trigger\", \"unit\": \"seconds\"}]}","usage":{"input":638,"output":45}}
{"key":"9439859a217dce7712e5727aa0ab3c20fd4ee9c98fa76831e049c9c6cb1954a6","quote":"Spell a booking reference one letter at a time.","text":"{\"limits\": []}","usage":{"input":630,"output":9}}
{"key":"be71294ae889d207b6b68251d4513bfa751a019f8da47f25be83f301e35cced3","quote":"Do not paste long paragraphs.","text":"{\"limits\": []}","usage":{"input":671,"output":9}}
