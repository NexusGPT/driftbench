{"key":"f2d7b39eba6d01f5123548bc3c7928524c776b431f07a797c33f98162600ed0a","quote":"Do not write more than twelve lines.","text":"{\"limits\": [{\"limit\": 12, \"comparison\": \"le\", \"unit\": \"lines\"}]}","usage":{"input":387,"output":35}}
{"key":"dc10155406e6cf2983c3894a3e083954359df5d95c7b111f2518adacafcd4957","quote":"Ask the guest to ring the office to give payment details.","text":"{\"limits\": []}","usage":{"input":392,"output":9}}
{"key":"38b702a22f797b7d17e4266aedd7543cd31ed3c5fff14682beaf0feff7f38a3a","quote":"Do not use symbols, brackets or web addresses.","text":"{\"limits\": []}","usage":{"input":393,"output":9}}
{"key":"e17c8e9ed06e3c7174c4dc1d89a37cd16d64c7cdb7f83dd87e3c33994a04c18a","quote":"Say numbers in groups, such as ninety two pounds, and say dates with the day name.","text":"{\"limits\": []}","usage":{"input":404,"output":9}}
