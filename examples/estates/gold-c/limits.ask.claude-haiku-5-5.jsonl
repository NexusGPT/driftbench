{"key":"5fc7813daff20ae285b86ffbe291af3dd84dcc85e40fcdaf1b0e28cb59ee7e35","quote":"Start with a greeting and the guest's name, and end with your name and the guesthouse.","text":"{\"limits\": []}","usage":{"input":402,"output":9}}
{"key":"c97dd84bca4f177e9fdacb6f3c5d2a4f53b989261286eec3193ece5094c5d941","quote":"Reply within the same minute.","text":"{\"limits\": [{\"limit\": 1, \"comparison\": \"le\", \"unit\": \"minute\"}]}","usage":{"input":388,"output":35}}
{"key":"3465e64e33e99d1d1c1cd2627d62b2e906ec163ff370229e3c405e8c203a59b4","quote":"Answer every question in the email, in the order the guest asked.","text":"{\"limits\": []}","usage":{"input":393,"output":9}}
{"key":"1b713f4467327e1f54673f7d1080f3e341c87590f635447920b29377c0634bca","quote":"Use a subject line that begins with the original subject.","text":"{\"limits\": []}","usage":{"input":390,"output":9}}
