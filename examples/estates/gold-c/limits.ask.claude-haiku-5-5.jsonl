{"key":"5a24552d8558012df9ff31fa4dbca5f66ccee88a567df748a09692f439cc0165","quote":"If two tabs seem to conflict, the safer one wins.","text":"{\"limits\": []}","usage":{"input":631,"output":9}}
{"key":"f09296d319072e38b167f29cfc9310a0606bf7a297b78abad000f83fb568381a","quote":"Read the tab that matches the channel of the message and ignore the others.","text":"{\"limits\": []}","usage":{"input":628,"output":9}}
{"key":"558cab59f6e7fdd94241776485fa5858858b3160497caed25eecdac597574001","quote":"Tell the front desk about the conflict in your note.","text":"{\"limits\": []}","usage":{"input":628,"output":9}}
{"key":"5f4d9128505ae9575d6c4c224665319c0fb781687696e03fb8cbb270c219d0a7","quote":"If you cannot tell the channel, use the web chat tab.","text":"{\"limits\": []}","usage":{"input":626,"output":9}}
{"key":"da8d9af17d5a4cad7aea81a0300263904ad41a785acb80c76e8eed3ad9f9d2a9","quote":"Quote prices in pounds with the word per night or for the stay.","text":"{\"limits\": []}","usage":{"input":633,"output":9}}
{"key":"3006cd606c3e77e36920c0add6e1db7d9b26ab7c3c38a8e09d1ee23894efd015","quote":"Be warm and brief.","text":"{\"limits\": []}","usage":{"input":621,"output":9}}
{"key":"0e9e8144bf8adfd2bf88cb083707f9adeeb7504c92685fbc08958ff393e63f8a","quote":"Never promise a room you have not seen as free.","text":"{\"limits\": []}","usage":{"input":627,"output":9}}
{"key":"5415c664643113a00047a509d1c574f6955d2e019c9c97b25f786c58d89f49c9","quote":"Then ring the duty owner on the number in the staff sheet.","text":"{\"limits\": []}","usage":{"input":633,"output":9}}
{"key":"91348c331068f4117341c3eacde37f963ad67c0463c44d04477f41bdd5b91947","quote":"Breakfast is included; say so when you quote.","text":"{\"limits\": []}","usage":{"input":628,"output":9}}
{"key":"444f84127560f5fdcbb12246adc55fe544e1af5a9ca778537c12a84721f6624b","quote":"Tell them to call 999 first.","text":"{\"limits\": []}","usage":{"input":624,"output":9}}
{"key":"a0fa8a71801d490436670727f3cdfa1d9f88ba54c9537399342d8aead8935d5a","quote":"Check the booking calendar before you promise a room.","text":"{\"limits\": []}","usage":{"input":628,"output":9}}
{"key":"ce6637fe98f6e2b4495b20307e732aa47c42ce62ed53cb6864c07dbd9cd0cb56","quote":"Do not carry on with a booking while an emergency is open.","text":"{\"limits\": []}","usage":{"input":631,"output":9}}
{"key":"1cea26ffb45c8d62ef9327c303f8fe1f06dc66ff1c85c44288f7ad25101112ad","quote":"Never give one guest's name, room or dates to another person.","text":"{\"limits\": []}","usage":{"input":630,"output":9}}
{"key":"b3d3bd89beaf541b9f1481467e364594edc3f4212f7f9c158a247d5efa405a95","quote":"If someone asks whether a person is staying, say you cannot confirm.","text":"{\"limits\": []}","usage":{"input":635,"output":9}}
{"key":"0cd7f087ab7a6314b1f3b545fc54ecf2e8f574095bd1e8738b8096d38213775b","quote":"Keep each reply to three lines.","text":"{\"limits\": [{\"limit\": 3, \"comparison\": \"le\", \"role\": \"constraint\", \"unit\": \"lines\"}]}","usage":{"input":671,"output":43}}
{"key":"a97d3a2e870a32a5a2466d0855b80fef85b3c971aec1802d20248f866c2aad60","quote":"Do not use headings, tables or long lists on WhatsApp.","text":"{\"limits\": []}","usage":{"input":639,"output":9}}
