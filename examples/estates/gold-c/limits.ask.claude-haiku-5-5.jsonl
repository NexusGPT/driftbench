{"key":"e421f7df2cfd67777b2a68a9a924347f7ce17e9924e787819558e7e62af34ad9#1","quote":"Never put a card number or a password in an email.","text":"{\"limits\": []}","usage":{"input":896,"output":9}}
{"key":"d664ad6ad2c3860dce09e81cc348b63c0cd43b5d2dfbb94e864d6790780408d0#1","quote":"Ask the guest to ring the office to give payment details.","text":"{\"limits\": []}","usage":{"input":900,"output":9}}
{"key":"e88ec1d05a9c86fd340d61eecbb36b9f1903c579dfac4b3fbccfe3d0cab111ab#1","quote":"Attach the booking confirmation as a pdf when you confirm a stay.","text":"{\"limits\": []}","usage":{"input":868,"output":9}}
