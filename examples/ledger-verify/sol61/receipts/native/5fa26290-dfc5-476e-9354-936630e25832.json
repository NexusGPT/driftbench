ce is zero, so t = 0 and v = anchor.\nassert anchor[1] == (-12 * anchor[0] + 74) / 5\n\n# Every direction along the line is parallel to (5, -12).\n# Distance = t requires unit length and t >= 0.\ntangent = (5, -12)\nlength_squared = sum(c * c for c in tangent)\nlength = isqrt(length_squared)\nassert length * length == length_squared\n\n# These exhaust the two unit directions along this line.\ncandidates = [\n    tuple(F(sign * c, length) for c in tangent)\n    for sign in (-1, 1)\n]\nvalid = [d for d in candidates if d[0] < 0]\nassert len(valid) == 1\nexpected = valid[0]\n\nprint(\"Expected d:\", expected)\nprint(\"Submitted d:\", claimed)\nprint(\"Submitted squared norm:\", sum(c * c for c in claimed))\nprint(\"Submitted line-direction residual:\", 12 * claimed[0] + 5 * claimed[1])\n\n# Exact counterexample on the required half-line using the submitted d.\nt = F(-13)\npoint = tuple(anchor[i] + t * claimed[i] for i in range(2))\ndistance_squared = sum((point[i] - anchor[i]) ** 2 for i in range(2))\nassert point[0] <= 7\nassert point[1] == (-12 * point[0] + 74) / 5\nassert distance_squared == 169\n\nprint(\"Counterexample point:\", point)\nprint(\"Submitted parameter t:\", t)\nprint(\"Actual distance: 13\")\nprint(\"CHECK PASS\" if claimed == expected else \"CHECK FAIL\")\n```"}],"phase":"final_answer","role":"assistant"}],"parallel_tool_calls":true,"presence_penalty":0,"previous_response_id":null,"prompt_cache_key":null,"prompt_cache_retention":"24h","reasoning":{"context":"all_turns","effort":"medium","mode":"standard","summary":null},"safety_identifier":null,"service_tier":"default","store":false,"temperature":1,"text":{"format":{"type":"text"},"verbosity":"medium"},"tool_choice":"auto","tool_usage":{"image_gen":{"input_tokens":0,"input_tokens_details":{"image_tokens":0,"text_tokens":0},"output_tokens":0,"output_tokens_details":{"image_tokens":0,"text_tokens":0},"total_tokens":0},"web_search":{"num_requests":0}},"tools":[],"top_logprobs":0,"top_p":0.98,"truncation