 a, b, g in itertools.permutations(directions, 3):\n        if label == \"A\":\n            if dot(a, b) != 0:\n                continue\n            ell = canonical(cross(a, b))\n            candidates = [\n                m for m in directions\n                if dot(m, ell) == 0 and cross(m, b) != (0, 0, 0)\n            ]\n        elif label == \"B\":\n            if dot(a, g) != 0 or dot(b, g) != 0:\n                continue\n            candidates = [canonical(cross(a, g))]\n            ell = None\n        else:\n            if dot(a, g) != 0 or dot(b, g) != 0:\n                continue\n            candidates = [a]\n            ell = None\n\n        for m in candidates:\n            if m is None or cross(m, b) == (0, 0, 0):\n                continue\n            l = ell or next(v for v in directions if v != m)\n            if l == m:\n                continue\n            n = next(v for v in directions if v not in (m, l))\n            return {\n                \"plane_normals\": {\"alpha\": a, \"beta\": b, \"gamma\": g},\n                \"line_directions\": {\"m\": m, \"n\": n, \"l\": l},\n                \"m_cross_beta_normal\": cross(m, b),\n                \"placement\": \"All planes and lines pass through the origin.\"\n            }\n    return None\n\n# Sparse exact polynomials in x,y,z,s,r,q.\nZERO = (0,) * 6\n\ndef variable(i):\n    exponent = list(ZERO)\n    exponent[i] = 1\n    return {tuple(exponent): 1}\n\ndef multiply(p, q):\n    result = {}\n    for e, c in p.items():\n        for f, d in q.items():\n            k = tuple(x + y for x, y in zip(e, f))\n            result[k] = result.get(k, 0) + c*d\n    return {k: v for k, v in result.items() if v}\n\ndef subtract(p, q):\n    result = dict(p)\n    for k, v in q.items():\n        result[k] = result.get(k, 0) - v\n    return {k: v for k, v in result.items() if v}\n\ndef polynomial_cross(u, v):\n    return [\n        subtract(multiply(u[i], v[j]), multiply(u[j], v[i]))\n        for i, j in ((1, 2), (2, 0), (0, 1))\n    ]\n\ndef solve():\n    evidence = {}\n    for label in (\"A\", \"B\", \"C\"):\n        witness = counterexample(label)\n        if witness is None:\n            return None\n        evidence[label] = witness\n\n    # Under D, let a,b be plane normals and d the direction of n.\n    # Perpendicularity gives a=s*d, b=r*d, with s,r nonzero.\n    # Since m is perpendicular to alpha, its direction is q*a.\n    d = [variable(i) for i in range(3)]\n    s, r, q = (variable(i) for i in range(3, 6))\n    a = [multiply(s, x) for x in d]\n    b = [multiply(r, x) for x in d]\n    m = [multiply(q, x) for x in a]\n    residual = polynomial_cross(m, b)\n    certified = all(not component for component in residual)\n    if not certified:\n        return None\n\n    evidence[\"D\"] = {\n        \"universal_parameterization\":\n            \"n=d, alpha_normal=s*d, beta_normal=r*d, m=q*s*d; \"\n            \"d nonzero and s,r,q nonzero. Distinct parallel lines \"\n            \"are allowed, so distinctness does not invalidate this.\",\n        \"exact_polynomial_m_cross_beta_normal\": [0, 0, 0]\n    }\n    statuses = {label: False for label in (\"A\", \"B\", \"C\")}\n    statuses[\"D\"] = certified\n    answer = [label for label, sufficient in statuses.items() if sufficient]\n    return {\"final_answer\": \", \".join(answer), \"evidence\": evidence}\n\nresult = solve()\nprint(\"UNSUPPORTED\" if result is None else json.dumps(result, separators=(\",\", \":\")))\n```"}],"phase":"final_answer","role":"assistant"}],"parallel_tool_calls":true,"presence_penalty":0,"previous_response_id":null,"prompt_cache_key":null,"prompt_cache_retention":"24h","reasoning":{"context":"all_turns","effort":"medium","mode":"standard","summary":null},"safety_identifier":null,"service_tier":"default","store":false,"temperature":1,"text":{"format":{"type":"text"},"verbosity":"medium"},"tool_choice":"auto","tool_usage":{"image_gen":{"input_tokens":0,"input_tokens_details":{"image_tokens":0,"text