nue\n    if any(\n        is_vowel(a) != is_vowel(b) or (not is_vowel(a) and a != b)\n        for a, b in zip(s, e)\n    ):\n        continue\n    for i, token in enumerate(e):\n        if is_vowel(token):\n            right = e[i + 1] if i + 1 < len(e) else \"\"\n            observations.append((token, right, s[i], sursilvan, engadine))\n\ntarget = tokenize(\"cuort\")\nresult = target[:]\nevidence = []\n\nfor i, token in enumerate(target):\n    if not is_vowel(token):\n        continue\n    right = target[i + 1] if i + 1 < len(target) else \"\"\n    settled = False\n\n    # Use the shortest following-consonant context giving a unanimous\n    # correspondence among the supplied, fully observed word pairs.\n    for width in range(len(right) + 1):\n        matches = [\n            row for row in observations\n            if row[0] == token and row[1][:width] == right[:width]\n        ]\n        outputs = {row[2] for row in matches}\n        if len(outputs) == 1:\n            result[i] = outputs.pop()\n            evidence.append({\n                \"engadine_vowel\": token,\n                \"following_context\": right[:width],\n                \"sursilvan_vowel\": result[i],\n                \"support\": [[row[3], row[4]] for row in matches],\n            })\n            settled = True\n            break\n\n    if not settled:\n        print(json.dumps({\"final_answer\": \"UNSUPPORTED\", \"evidence\": evidence}))\n        break\nelse:\n    print(json.dumps({\n        \"final_answer\": \"\".join(result),\n        \"evidence\": evidence\n    }, separators=(\",\", \":\")))\n```"}],"phase":"final_answer","role":"assistant"}],"parallel_tool_calls":true,"presence_penalty":0,"previous_response_id":null,"prompt_cache_key":null,"prompt_cache_retention":"24h","reasoning":{"context":"all_turns","effort":"medium","mode":"standard","summary":null},"safety_identifier":null,"service_tier":"default","store":false,"temperature":1,"text":{"format":{"type":"text"},"verbosity":"medium"}