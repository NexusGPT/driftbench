e i < len(expanded):\n        token = expanded[i]\n        left_vowel = i == 0 or vowel(expanded[i - 1])\n        right_vowel = (\n            i + 1 < len(expanded) and vowel(expanded[i + 1])\n        )\n\n        if token == \"q\" and i + 1 < len(expanded) and expanded[i + 1] == \"w\":\n            output.append(\"ɣʷ\" if left_vowel else \"xʷ\")\n            i += 2\n            continue\n\n        if (token == \"g\" and i + 2 < len(expanded)\n                and expanded[i + 1] == \"w\"\n                and vowel(expanded[i + 2])):\n            output.append(\"gʷ\" if left_vowel else \"kʷ\")\n            i += 2\n            continue\n\n        if token in \"tgjq\":\n            voiced, voiceless = {\n                \"t\": (\"d\", \"t\"),\n                \"g\": (\"g\", \"k\"),\n                \"j\": (\"j\", \"c\"),\n                \"q\": (\"ɣ\", \"x\"),\n            }[token]\n            output.append(\n                voiced if left_vowel and right_vowel else voiceless\n            )\n        else:\n            output.append(token)\n        i += 1\n\n    return \"\".join(output), \"\".join(expanded)\n\nchecks = [transcribe(word)[0] == expected for word, expected in data]\nif not all(checks):\n    print(json.dumps({\n        \"final_answer\": \"UNSUPPORTED\",\n        \"evidence\": {\"matched_examples\": sum(checks), \"total\": len(data)}\n    }, ensure_ascii=False))\nelse:\n    answer, intermediate = transcribe(\"gmu’jmin\")\n    print(json.dumps({\n        \"final_answer\": \"[\" + answer + \"]\",\n        \"evidence\": {\n            \"matched_examples\": len(data),\n            \"schwa_and_length_stage\": intermediate,\n            \"rules\": [\n                \"A vowel followed by ’ is long.\",\n                \"Insert schwa between a consonant and m, n, or l.\",\n                \"Stops are voiced next to vowels on both sides, or initially before a vowel.\"\n            ]\n        }\n    }, ensure_ascii=False, separators=(\",\", \":\")))\n```"}],"phase":"final_answer","role":"assistant"}],"parallel_tool_calls":true,"presence_penalty":0,"previous_response_id":null,"prompt_cache_key":null,"prompt_cache_retention":"24h","reasoning":{"context":"all_turns","effort":"medium","mode":"standard","summary":null},"safety_identifier":null,"service_tier":"default","store":false,"temperature":1,"text":{"format":{"type":"text"},"verbosity":"medium"},"tool_choice":"auto","tool_usage":{"image_gen":{"input_tokens":0,"input_tokens_details":{"image_tokens":0,"text_tokens":0},"output_tokens":0,"output_tokens_details":{"image_tokens":0,"text_tokens":0},"total_tokens":0},"web_search":{"num_requests":0}},"tools":[],"top_logprobs":0,"top_p":0.98,"truncation":"disabled","usage":{"input_tokens":418,"input_tokens_details":{"cache_write_tokens":0,"cached_tokens":0},"output_tokens":2430,"output_tokens_details":{"reasoning_tokens":1552},"total_tokens":2848},"user":null,"metadata":{}}
