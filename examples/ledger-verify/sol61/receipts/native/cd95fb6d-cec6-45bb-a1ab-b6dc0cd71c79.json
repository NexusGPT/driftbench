4.80251 L 9.07607,14.80251\"\"\"\n\ndef sub(a, b):\n    return (a[0] - b[0], a[1] - b[1])\n\ndef cross(a, b):\n    return a[0] * b[1] - a[1] * b[0]\n\ndef dot(a, b):\n    return a[0] * b[0] + a[1] * b[1]\n\ndef orient(a, b, c):\n    return cross(sub(b, a), sub(c, a))\n\ndef on_segment(p, a, b):\n    return (orient(a, b, p) == 0\n            and min(a[0], b[0]) <= p[0] <= max(a[0], b[0])\n            and min(a[1], b[1]) <= p[1] <= max(a[1], b[1]))\n\nsegments = []\nprevious = None\nfor command, x, y in re.findall(r\"([ML])\\s+(-?[\\d.]+),(-?[\\d.]+)\", svg):\n    point = (F(x), F(y))\n    if command == \"L\" and point != previous:\n        segments.append((previous, point))\n    previous = point\n\n# Split every segment at every endpoint and intersection, including overlaps.\npoints = {p for segment in segments for p in segment}\nfor a, b in segments:\n    r = sub(b, a)\n    for c, d in segments:\n        s = sub(d, c)\n        denominator = cross(r, s)\n        if denominator:\n            t = cross(sub(c, a), s) / denominator\n            u = cross(sub(c, a), r) / denominator\n            if 0 <= t <= 1 and 0 <= u <= 1:\n                points.add((a[0] + t * r[0], a[1] + t * r[1]))\n\nvertices = sorted(points)\nindex = {p: i for i, p in enumerate(vertices)}\ngraph = defaultdict(set)\nfor a, b in segments:\n    ordered = sorted(\n        (p for p in points if on_segment(p, a, b)),\n        key=lambda p: dot(sub(p, a), sub(b, a))\n    )\n    for p, q in zip(ordered, ordered[1:]):\n        i, j = index[p], index[q]\n        graph[i].add(j)\n        graph[j].add(i)\n\n# Exhaustively enumerate undirected simple cycles. A planarized graph cycle\n# is a simple polygon; collinear subdivision vertices are not corners.\ncycles = []\nfor start in range(len(vertices)):\n    path = [start]\n    used = {start}\n\n    def search(v):\n        for w in sorted(graph[v]):\n            if w == start:\n                if len(path) >= 3 and path[1] < path[-1]:\n                    cycles.append(tuple(path))\n            elif w > start and w not in used:\n                used.add(w)\n                path.append(w)\n                search(w)\n                path.pop()\n                used.remove(w)\n\n    search(start)\n\ndef corners(cycle):\n    polygon = [vertices[i] for i in cycle]\n    return [\n        p for i, p in enumerate(polygon)\n        if orient(polygon[i - 1], p, polygon[(i + 1) % len(polygon)]) != 0\n    ]\n\ndef strictly_inside(p, polygon):\n    if any(on_segment(p, a, b)\n           for a, b in zip(polygon, polygon[1:] + polygon[:1])):\n        return False\n    inside = False\n    for a, b in zip(polygon, polygon[1:] + polygon[:1]):\n        if (a[1] > p[1]) != (b[1] > p[1]):\n            x = a[0] + (p[1] - a[1]) * (b[0] - a[0]) / (b[1] - a[1])\n            if p[0] < x:\n                inside = not inside\n    return inside\n\ndef drawn_straight_segment(a, b):\n    # Verify coverage of the entire candidate chord, not just its endpoints.\n    direction = sub(b, a)\n    denominator = dot(direction, direction)\n    intervals = []\n    for c, d in segments:\n        if orient(a, b, c) == 0 and orient(a, b, d) == 0:\n            lo, hi = sorted((dot(sub(c, a), direction) / denominator,\n                             dot(sub(d, a), direction) / denominator))\n            lo, hi = max(lo, F(0)), min(hi, F(1))\n            if lo <= hi:\n                intervals.append((lo, hi))\n    reached = F(0)\n    for lo, hi in sorted(intervals):\n        if lo > reached:\n            return False\n        reached = max(reached, hi)\n    return reached >= 1\n\ndef has_drawn_diagonal(polygon):\n    n = len(polygon)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if j == i + 1 or (i == 0 and j == n - 1):\n                continue\n            a, b = polygon[i], polygon[j]\n            if not drawn_straight_segment(a, b):\n                continue\n            # Split the chord at every boundary intersection and test\n            # each open interval. An exterior chord is not a diagonal.\n            r = sub(b, a)\n            parameters = {F(0), F(1)}\n            for c, d in zip(polygon, polygon[1:] + polygon[:1]):\n                s = sub(d, c)\n                den = cross(r, s)\n                if den:\n                    t = cross(sub(c, a), s) / den\n                    u = cross(sub(c, a), r) / den\n                    if 0 <= t <= 1 and 0 <= u <= 1:\n                        parameters.add(t)\n            ts = sorted(parameters)\n            if all(strictly_inside(\n                    (a[0] + ((lo + hi) / 2) * r[0],\n                     a[1] + ((lo + hi) / 2) * r[1]), polygon)\n                   for lo, hi in zip(ts, ts[1:])):\n                return True\n    return False\n\ndef close(a, b):\n    # Used only for metric classifications affected by decimal rounding.\n    return abs(float(a - b)) <= 1e-4 * max(1.0, abs(float(a)), abs(float(b)))\n\ndef perpendicular(a, b):\n    return abs(float(dot(a, b))) <= 1e-5 * math.sqrt(float(dot(a, a) * dot(b, b)))\n\ndef regular(edges, turns):\n    if not (all(t > 0 for t in turns) or all(t < 0 for t in turns)):\n        return False\n    lengths = [dot(e, e) for e in edges]\n    adjacent_dots = [dot(edges[i - 1], edges[i]) for i in range(len(edges))]\n    return (all(close(x, lengths[0]) for x in lengths)\n            and all(close(x, adjacent_dots[0]) for x in adjacent_dots))\n\nwitnesses = {}\nfor cycle in cycles:\n    polygon = corners(cycle)\n    n = len(polygon)\n    if n < 3:\n        continue\n    edges = [sub(polygon[(i + 1) % n], polygon[i]) for i in range(n)]\n    turns = [cross(edges[i - 1], edges[i]) for i in range(n)]\n    convex = all(t > 0 for t in turns) or all(t < 0 for t in turns)\n    kinds = set()\n\n    if n == 3:\n        kinds.add(4 if any(perpendicular(edges[i - 1], edges[i])\n                           for i in range(n)) else 3)\n    elif not has_drawn_diagonal(polygon):\n        if n == 4 and convex:\n          