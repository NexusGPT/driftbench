shank\", \"Casper\", \"Philadelphia\", \"Gatsby\", \"PK\"),\n    \"E\": (\"Casper\", \"Forrest\", \"Philadelphia\", \"Shawshank\", \"Gatsby\"),\n    \"F\": (\"Dances\", \"Holland\", \"Philadelphia\", \"PK\", \"Gatsby\"),\n    \"G\": (\"Forrest\", \"Philadelphia\", \"PK\", \"Dances\", \"Casper\"),\n    \"H\": (\"PK\", \"Casper\", \"Philadelphia\", \"Forrest\", \"Gatsby\"),\n    \"I\": (\"Gatsby\", \"Philadelphia\", \"Dances\", \"Holland\", \"Forrest\"),\n    \"J\": (\"Holland\", \"Shawshank\", \"Philadelphia\", \"Dances\", \"Forrest\"),\n}\n\n# The problem supplies neither audience preferences nor a similarity rule.\n# Demonstrate ambiguity even under one fixed, reasonable rule:\n# mean pairwise agreement of binary like/dislike responses.\n# In each hypothetical audience, all members like exactly the listed set.\nwitnesses = []\nfor liked_movies in options.values():\n    liked = set(liked_movies)\n    scores = {}\n    for label, movies in options.items():\n        pairs = list(combinations(movies, 2))\n        agreements = sum((a in liked) == (b in liked) for a, b in pairs)\n        scores[label] = Fraction(agreements, len(pairs))\n    maximum = max(scores.values())\n    winners = tuple(label for label, score in scores.items() if score == maximum)\n    if len(winners) == 1 and all(\n        witness[\"winner\"] != winners[0] for witness in witnesses\n    ):\n        witnesses.append({\n            \"hypothetical_liked_movies\": sorted(liked),\n            \"winner\": winners[0],\n            \"scores\": {label: str(score) for label, score in scores.items()},\n        })\n    if len(witnesses) == 2:\n        break\n\nprint(json.dumps({\n    \"final_answer\": \"UNSUPPORTED\",\n    \"evidence\": {\n        \"missing\": [\"audience preferences\", \"specified similarity measure\"],\n        \"ambiguity_demonstrated\": len(witnesses) == 2,\n        \"hypothetical_counterexamples_not_given_data\": witnesses,\n    },\n}, separators=(\",\", \":\")))\n```"}],"phase":"final_answ