,\n    196: \"cloth old\",\n    197: \"paper old\",\n    199: \"medium-size snorkeling\",\n    200: \"tiny typing\",\n}\ncategory[\"chinese\"] = \"origin\"\n\noptions = {\n    \"A\": \"massive hiking wool old-fashioned green silly\",\n    \"B\": \"repulsive midsize typing plastic brand-new pyramidal ethiopian\",\n    \"C\": \"ethiopian rectangular medium-size driving glass ancient repulsive\",\n    \"D\": \"turkish circular massive whittling cardboard old yellow lovely\",\n    \"E\": \"japanese prismlike small eating paper old-fashioned indigo\",\n    \"F\": \"massive typing paper old-fashioned ridiculous gray\",\n    \"G\": \"pyramidal medium-size drinking steel new pink ridiculous\",\n    \"H\": \"violet lovely enormous hiking leather new triangular\",\n    \"I\": \"terrible brown normal-size typing glass old triangular japanese\",\n    \"J\": \"bangladeshi prismlike huge drinking wood ancient\",\n}\n\ndef sequence(text):\n    return [category[word] for word in text.split()]\n\nedges = set()\nfor text in givens.values():\n    seq = sequence(text)\n    edges.update(\n        (seq[i], seq[j])\n        for i in range(len(seq))\n        for j in range(i + 1, len(seq))\n    )\n\norders = []\nfor order in itertools.permutations(classes):\n    rank = {name: i for i, name in enumerate(order)}\n    if all(rank[a] < rank[b] for a, b in edges):\n        orders.append(rank)\n\nif not orders:\n    print(json.dumps({\n        \"final_answer\": \"UNSUPPORTED\",\n        \"evidence\": \"The givens admit no consistent adjective-class order.\"\n    }))\nelse:\n    compatible_counts = {}\n    for letter, text in options.items():\n        seq = sequence(text)\n        compatible_counts[letter] = sum(\n            all(rank[a] < rank[b] for a, b in zip(seq, seq[1:]))\n            for rank in orders\n        )\n\n    # A proposed order is compatible with the givens exactly when at least\n    # one exhaustive total-order completion permits it.\n    answer = \"\".join(\n        letter for