   return 0\n    return ((a > 0) - (a < 0)) * ((delta > 0) - (delta < 0))\n\ndef text(u):\n    a, b = u\n    if b == 0:\n        return str(a)\n    if a == 0:\n        return f\"({b})*sqrt({D})\"\n    op = \"+\" if b > 0 else \"-\"\n    return f\"({a}) {op} ({abs(b)})*sqrt({D})\"\n\ntry:\n    root = (F(0), F(1))\n    candidates = []\n    rejected = []\n\n    # At an interior maximum of xyz, Lagrange multipliers imply\n    # that x,y,z take at most two distinct values. If t is repeated,\n    # q = 2*s*t - 3*t^2.\n    for branch in (-1, 1):\n        t = div(add(scalar(s), mul(scalar(branch), root)), scalar(3))\n        third = sub(scalar(s), mul(scalar(2), t))\n        if sign(t) > 0 and sign(third) > 0:\n            candidates.append((mul(mul(t, t), third), (t, t, third)))\n        else:\n            rejected.append({\n                \"repeated\": text(t),\n                \"third\": text(third),\n                \"reason\": \"not all coordinates are positive\"\n            })\n\n    if not candidates:\n        raise ArithmeticError(\"No positive maximizing candidate\")\n\n    rmax, values = candidates[0]\n    for r, triple in candidates[1:]:\n        if sign(sub(r, rmax)) > 0:\n            rmax, values = r, triple\n\n    x, y, z = values\n    assert add(add(x, y), z) == scalar(s)\n    assert add(add(mul(x, y), mul(x, z)), mul(y, z)) == scalar(q)\n    assert sign(rmax) > 0\n\n    # Direct evaluation of the original expression at the maximizing triple.\n    answer = scalar(0)\n    for u, v in ((x, y), (x, z), (y, z)):\n        answer = add(answer, div(add(mul(u, u), mul(v, v)), add(u, v)))\n\n    # For every feasible triple, with r=xyz:\n    # E = 2*s - 2*(q^2+s*r)/(s*q-r).\n    reduced = sub(\n        scalar(2*s),\n        div(mul(scalar(2), add(scalar(q*q), mul(scalar(s), rmax))),\n            sub(scalar(s*q), rmax))\n    )\n    assert answer == reduced\n    derivative_numerator = -2*q*(s*s + q)\n    assert derivative_numerator < 0\n\n    print(json.dumps({\n        \"final_answer\": text(answer),\n        \"evidence\": {\n            \"attaining_triple\": [text(v) for v in values],\n            \"maximum_xyz\": text(rmax),\n            \"identity\": \"E=2s-2(q^2+s*r)/(s*q-r), s=9, q=14, r=xyz\",\n            \"derivative\": f\"{derivative_numerator}/(126-r)^2 < 0\",\n            \"global_certificate\": (\n                \"On the compact nonnegative feasible set, boundary xyz=0. \"\n                \"A positive feasible candidate exists, so the product maximum \"\n                \"is interior. The constraint gradients are independent since \"\n                \"all-equal coordinates violate q=14. Lagrange multipliers for \"\n                \"log(xyz) make each coordinate a root of one quadratic; hence \"\n                \"two coordinates coincide. Both resulting branches were checked.\"\n            ),\n            \"rejected_branch\": rejected,\n            \"exact_constraint_and_objective_checks\": True\n        }\n    }, separators=(\",\", \":\")))\nexcept (ArithmeticError, AssertionError, ZeroDivisionError):\n    print(\"UNSUPPORTED\")\n```"}],"phase":"final_answer","role":"assistant"}],"parallel_tool_calls":true,"presence_penalty":0,"previous_response_id":null,"prompt_cache_key":null,"prompt_cache_retention":"24h","reasoning":{"context":"all_turns","effort":"medium","mode":"standard","summary":null},"safety_identifier":null,"service_tier":"default","store":false,"temperature":1,"text":{"format":{"type":"text"},"verbosity":"medium"},"tool_choice":"auto","tool_usage":{"image_gen":{"input_tokens":0,"input_tokens_details":{"image_tokens":0,"text_tokens":0},"output_tokens":0,"output_tokens_details":{"image_tokens":0,"text_tokens":0},"total_tokens":0},"web_search":{"num_requests":0}},"tools":[],"top_logprobs":0,"top_p":0.98,"truncation":"disabled","usage":{"input_tokens":238,"input_tokens_details":{"cache_write_tokens":0,"cached_tokens":0},"output_tokens":2062,"output_tokens_details":{"reasoning_tokens":880},"total_tokens"