det = add(mul(a, x), scale(mul(b, y), -1))\ndot = add(mul(a, b), mul(x, y))\nnorm_product = mul(add(square(a), square(y)),\n                   add(square(b), square(x)))\nassert add(add(square(det), square(dot)),\n           scale(norm_product, -1)) == {}\n\n# Set x=sqrt(1-b^2), y=sqrt(1-a^2).\n# Both norms above equal 1. det=1 therefore implies dot=0.\n# Thus ab=-xy; squaring gives AB=(1-A)(1-B), where A=a^2, B=b^2.\nA, B = var(0, 2), var(1, 2)\none = {(0, 0): F(1)}\nsquared_dot_equation = add(\n    mul(A, B),\n    scale(mul(add(one, scale(A, -1)),\n            add(one, scale(B, -1))), -1)\n)\nassert squared_dot_equation == add(add(A, B), scale(one, -1))\n\nprint(\"Exact identity checks passed.\")\nprint(\"Every feasible pair has a^2+b^2=1.\")\nprint(\"Writing t=a^2 in [0,1] gives D=2t-1.\")\n\n# Completeness certificate:\n# For every t in [0,1], choose a=sqrt(t), b=-sqrt(1-t).\n# The original left side is then t+(1-t)=1.\nt = var(0, 1)\none_t = {(0,): F(1)}\nassert add(t, add(one_t, scale(t, -1))) == one_t\nD = add(scale(t, 2), scale(one_t, -1))\nslope = D.get((1,), F(0))\nintercept = D.get((0,), F(0))\nassert slope > 0\nexpected = (intercept, intercept + slope)\nassert expected == (F(-1), F(1))\nprint(\"Conversely, a=sqrt(t), b=-sqrt(1-t) realizes every t in [0,1].\")\nprint(\"Expected result: D ranges over [-1, 1].\")\n\n# Direct exact endpoint checks, including a=0 and b=0.\ndef rational_sqrt(q):\n    n, d = isqrt(q.numerator), isqrt(q.denominator)\n    assert n*n == q.numerator and d*d == q.denominator\n    return F(n, d)\n\nfor av, bv in [(F(0), F(-1)), (F(1), F(0))]:\n    lhs = av * rational_sqrt(1 - bv*bv) - bv * rational_sqrt(1 - av*av)\n    dv = av*av - bv*bv\n    assert lhs == 1\n    print(f\"Feasible endpoint: a={av}, b={bv}, left side={lhs}, D={dv}\")\n\nclaimed = (F(0), F(2))\nassert not (claimed[0] <= expected[0] <= claimed[1])\nprint(\"The submitted interval excludes feasible D=-1 and includes impossible D=2.\")\nprint(\"CHECK FAIL\")\n```"}],"phase