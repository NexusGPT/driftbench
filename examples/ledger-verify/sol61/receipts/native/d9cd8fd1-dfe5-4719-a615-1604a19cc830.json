l cosine rule.\n    computed_b2 = add(\n        add((a2, Fraction(0)), c2_exact),\n        (-sqrt6_c_exact[0], -sqrt6_c_exact[1])\n    )\n    exact_valid = computed_b2 == (b2, Fraction(0))\n\n    # Independently recover all angles from the computed sides.\n    computed_A = degrees(acos((float(b2) + c*c - float(a2)) / (2*b*c)))\n    computed_B = degrees(acos((float(a2) + c*c - float(b2)) / (2*a*c)))\n    computed_C = 180 - computed_A - computed_B\n\n    triangle_valid = a + b > c and a + c > b and b + c > a\n    angle_valid = (\n        isclose(computed_A, angle_A, abs_tol=1e-10)\n        and isclose(computed_B, B, abs_tol=1e-10)\n        and isclose(computed_C, angle_C, abs_tol=1e-10)\n    )\n\n    symbol = \"+\" if sign == 1 else \"-\"\n    print(f\"A = {angle_A} degrees, C = {angle_C} degrees, \"\n          f\"c = sqrt(2 {symbol} sqrt(3)) = {c:.12f}\")\n    print(\"Exact cosine-rule substitution:\", computed_b2,\n          \"(coefficients of 1 and sqrt(3))\")\n\n    if not (exact_valid and triangle_valid and angle_valid):\n        print(\"CHECK UNKNOWN: internal verification failed\")\n        break\n    solutions.append((angle_A, angle_C, sign))\nelse:\n    submitted = {(60, 75, 1)}\n    expected = set(solutions)\n    print(\"Submitted answer is a valid triangle:\", submitted <= expected)\n    print(\"All possibilities enumerated by the quadratic:\", len(expected))\n    if submitted == expected:\n        print(\"CHECK PASS\")\n    else:\n        print(\"CHECK FAIL: the submitted answer omits \"\n              \"A = 120 degrees, C = 15 degrees, c = sqrt(2 - sqrt(3)).\")\n```"}],"phase":"final_answer","role":"assistant"}],"parallel_tool_calls":true,"presence_penalty":0,"previous_response_id":null,"prompt_cache_key":null,"prompt_cache_retention":"24h","reasoning":{"context":"all_turns","effort":"medium","mode":"standard","summary":null},"safety_identifier":null,"service_tier":"default","store":false,"temperature":1,"text":{"format":{"type":"text"},"verbosity":"mediu