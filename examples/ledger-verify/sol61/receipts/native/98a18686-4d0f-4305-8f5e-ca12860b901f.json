n    if (len(tokens) >= 2\n            and not is_vowel(tokens[0])\n            and not is_vowel(tokens[1])\n            and tokens[1] not in set(\"mnlw\")):\n        tokens.insert(0, \"ə\")\n\n    expanded = []\n    for i, token in enumerate(tokens):\n        expanded.append(token)\n        if (i + 1 < len(tokens)\n                and not is_vowel(token)\n                and tokens[i + 1] in set(\"mnl\")):\n            expanded.append(\"ə\")\n\n    voiced = {\"p\": \"b\", \"t\": \"d\", \"k\": \"g\", \"c\": \"j\"}\n    result = []\n    for i, token in enumerate(expanded):\n        previous = expanded[i - 1] if i else None\n        following = expanded[i + 1] if i + 1 < len(expanded) else None\n        next_sound = following\n        if (following == \"w\" and i + 2 < len(expanded)\n                and token in {\"k\", \"x\"}):\n            next_sound = expanded[i + 2]\n\n        can_voice = (\n            (previous is None or is_vowel(previous))\n            and next_sound is not None\n            and (is_vowel(next_sound) or next_sound in sonorants)\n        )\n        if token in voiced and can_voice:\n            token = voiced[token]\n        elif token == \"x\" and can_voice:\n            token = \"ɣ\"\n        result.append(token)\n\n    output = []\n    i = 0\n    while i < len(result):\n        if (i + 2 < len(result)\n                and result[i] in {\"k\", \"g\", \"x\", \"ɣ\"}\n                and result[i + 1] == \"w\"\n                and is_vowel(result[i + 2])):\n            output.append(result[i] + \"ʷ\")\n            i += 2\n        else:\n            output.append(result[i])\n            i += 1\n    return \"\".join(output)\n\nif not all(transcribe(word) == sound for word, sound in givens):\n    print(\"UNSUPPORTED\")\nelse:\n    target = \"alaptək\"\n\n    # Invert the segment correspondences, then exhaustively test every\n    # possible apostrophe placement. Schwa may instead be epenthetic.\n    alphabet = sorted({c for word, _ in givens for c in word if c != \"’\"})\n    inverse = {}\n    for letter in alphabet:\n        segment = underlying.get(letter, letter)\n        inverse.setdefault(segment, []).append(letter)\n\n    segment_choices = [inverse.get(c, []) for c in target if c != \"ə\"]\n    answers = set()\n    tested = 0\n\n    if all(segment_choices):\n        for base_tuple in itertools.product(*segment_choices):\n            for marks in itertools.product((False, True), repeat=len(base_tuple)):\n                candidate = \"\".join(\n                    letter + (\"’\" if marked else \"\")\n                    for letter, marked in zip(base_tuple, marks)\n                )\n                tested += 1\n                if transcribe(candidate) == target:\n                    answers.add(candidate)\n\n    if len(answers) != 1:\n        print(\"UNSUPPORTED\")\n    else:\n        answer = next(iter(answers))\n        print(json.dumps({\n            \"final_answer\": answer,\n            \"evidence\": {\n                \"given_transcriptions_verified\": len(givens),\n                \"candidates_tested\": tested,\n                \"matching_candidates\": len(answers),\n                \"computed_transcription\": transcribe(answer)\n            }\n        }, ensure_ascii=False, separators=(\",\", \":\")))\n```"}],"phase":"final_answer","role":"assistant"}],"parallel_tool_calls":true,"presence_penalty":0,"previous_response_id":null,"prompt_cache_key":null,"prompt_cache_retention":"24h","reasoning":{"context":"all_turns","effort":"medium","mode":"standard","summary":null},"safety_identifier":null,"service_tier":"default","store":false,"temperature":1,"text":{"format":{"type":"text"},"verbosity":"medium"},"tool_choice":"auto","tool_usage":{"image_gen":{"input_tokens":0,"input_tokens_details":{"image_tokens":0,"text_tokens":0},"output_tokens":0,"output_tokens_details":{"image_tokens":0,"text_tokens":0},"total_tokens":0},"web_search":{"num_requests":0}},"tools":[],"top_logprobs":0,"top_p":0.98,"truncation