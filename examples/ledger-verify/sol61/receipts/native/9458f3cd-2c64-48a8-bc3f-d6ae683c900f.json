[term] = result.get(term, Fraction(0)) + c * comb(a, j)\n    return clean(result)\n\ndef evaluate(p, n, x):\n    return sum((c * n**a * x**b for (a, b), c in p.items()), Fraction(0))\n\none = {(0, 0): Fraction(1)}\nn = {(1, 0): Fraction(1)}\nx = {(0, 1): Fraction(1)}\nx2 = mul(x, x)\nn2 = mul(n, n)\n\n# Binomial weights obey\n# w_(n+1,k) = (1-x) w_(n,k) + x w_(n,k-1).\n# Thus their total mass S and first two raw moments obey:\n# S' = S, M1' = M1 + x*S, M2' = M2 + 2*x*M1 + x*S.\n# These identities follow by reindexing finite sums, including endpoints.\nS = one\nM1 = mul(n, x)\nM2 = add(mul(mul(n, add(n, scale(one, -1))), x2), mul(n, x))\n\nchecks = [\n    evaluate(S, 0, Fraction(1, 3)) == 1,\n    clean({term: c for term, c in M1.items() if term[0] == 0}) == {},\n    clean({term: c for term, c in M2.items() if term[0] == 0}) == {},\n    at_n_plus_one(S) == S,\n    at_n_plus_one(M1) == add(M1, mul(x, S)),\n    at_n_plus_one(M2) == add(M2, scale(mul(x, M1), 2), mul(x, S)),\n]\n\n# Since p_n(x) = M2/n^2 for f(t)=t^2, verify the exact\n# numerator identity before dividing by n>0.\ntarget = add(x, scale(x2, -1))\nchecks.append(\n    add(M2, scale(mul(n2, x2), -1)) == mul(n, target)\n)\nchecks.extend([\n    evaluate(target, 1, Fraction(0)) == 0,\n    evaluate(target, 1, Fraction(1)) == 0,\n])\n\nif all(checks):\n    print(\"Exact symbolic induction verifies the binomial moments for every n >= 0.\")\n    print(\"p_n(x) = x^2 + x(1-x)/n for every integer n >= 1.\")\n    print(\"Therefore n*(p_n(x)-x^2) = x(1-x) exactly, not just in the limit.\")\n    print(\"Boundary values: x=0 -> 0; x=1 -> 0.\")\n    print(\"The claimed limit holds for every x in [0,1].\")\n    print(\"CHECK PASS\")\nelse:\n    print(\"Exact identity checks:\", checks)\n    print(\"UNSUPPORTED: the symbolic verification did not complete successfully.\")\n    print(\"CHECK UNKNOWN\")\n```"}],"phase":"final_answer","role":"assistant"}],"parallel_tool_calls":true,"presence_penalty":0,"previous_response_id":nul