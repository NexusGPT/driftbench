65\n18.29129,-17.02568 20.49493,-21.75139\n17.75636,-22.97711 15.16487,-17.41963\n10.35209,-7.0986 0,-7.0986\n22.10067,8.68911 19.34832,10.61633\n2.5205,-5.64339 6.14757,-3.5493\n10.35209,-4.68508 10.35209,0\n10.35209,-7.0986 10.35209,-4.68508\n20.49493,-25.44266 20.49493,-28.84999\n0,-7.0986 2.5205,-5.64339\n6.14757,-3.5493 2.33608,-1.34873\n24.85302,6.76189 22.10067,8.68911\n15.93065,-11.96326 17.25429,-14.80182\n20.49493,-21.75139 20.49493,-25.44266\n19.34832,10.61633 17.21983,12.10671 11.74658,15.93912\n10.35209,1.96 10.35209,3.3712\n0,5.46 0,0\n4.03732,0 10.35209,0\n10.35209,7 7.55703,7\n10.35209,0 15.93065,-11.96326\n10.35209,3.3712 10.35209,7\n2.33608,-1.34873 0,0\n34.99586,-14.98949 24.85302,6.76189\n15.16487,-17.41963 10.35209,-7.0986\n11.74658,15.93912 11.17484,9.40408\n0,0 4.03732,0\n11.17484,9.40408 10.79637,5.0782\n29.3405,-17.62663 34.99586,-14.98949\n10.35209,0 10.35209,1.96\n10.79637,5.0782 10.35209,0\n7.55703,7 0,7\n17.25429,-14.80182 18.29129,-17.02568\n\"\"\"\n\nEPS = 0.00005\ndef sub(a, b):\n    return (a[0]-b[0], a[1]-b[1])\ndef cross(a, b):\n    return a[0]*b[1]-a[1]*b[0]\ndef dot(a, b):\n    return a[0]*b[0]+a[1]*b[1]\ndef norm(a):\n    return math.hypot(*a)\ndef near(a, b):\n    return norm(sub(a, b)) <= EPS\ndef parallel(a, b):\n    return abs(cross(a, b)) <= 0.00002*norm(a)*norm(b)\ndef perpendicular(a, b):\n    return abs(dot(a, b)) <= 0.00002*norm(a)*norm(b)\n\nsegments = []\nfor line in raw.strip().splitlines():\n    p = [tuple(map(float, s.split(\",\"))) for s in line.split()]\n    segments.extend(zip(p, p[1:]))\n\npoints = []\ndef vertex(p):\n    for i, q in enumerate(points):\n        if near(p, q):\n            return i\n    points.append(p)\n    return len(points)-1\n\ncuts = []\nfor a, b in segments:\n    cuts.append({vertex(a), vertex(b)})\n\n# Split at every segment intersection and every endpoint on another segment.\nfor i, (a, b) in enumerate(segments):\n    r = sub(b, a)\n    for j in range(i+1, len(segments)):\n        c, d = segments[j]\n        s = sub(d, c)\n        den = cross(r, s)\n        if abs(den) > 1e-12:\n            t = cross(sub(c, a), s)/den\n            u = cross(sub(c, a), r)/den\n            if -EPS/norm(r) <= t <= 1+EPS/norm(r) and \\\n               -EPS/norm(s) <= u <= 1+EPS/norm(s):\n                p = (a[0]+t*r[0], a[1]+t*r[1])\n                v = vertex(p)\n                cuts[i].add(v)\n                cuts[j].add(v)\n        for p, source, target, x, y in (\n            (a, i, j, c, d), (b, i, j, c, d),\n            (c, j, i, a, b), (d, j, i, a, b)\n        ):\n            vxy = sub(y, x)\n            t = dot(sub(p, x), vxy)/dot(vxy, vxy)\n            if -EPS/norm(vxy) <= t <= 1+EPS/norm(vxy):\n                projection = (x[0]+t*vxy[0], x[1]+t*vxy[1])\n                if near(p, projection):\n                    cuts[target].add(vertex(p))\n\nadj = [set() for _ in points]\nfor (a, b), cut in zip(segments, cuts):\n    direction = sub(b, a)\n    ordered = sorted(cut, key=lambda v: dot(sub(points[v], a), direction))\n    for u, v in zip(ordered, ordered[1:]):\n        if u != v:\n            adj[u].add(v)\n            adj[v].add(u)\n\ncycles = []\nfor start in range(len(points)):\n    def walk(path, used):\n        for v in sorted(adj[path[-1]]):\n            if v == start:\n                if len(path) >= 3 and path[1] < path[-1]:\n                    cycles.append(path[:])\n            elif v > start and v not in used:\n                walk(path+[v], used | {v})\n    walk([start], {start})\n\ndef corners(cycle):\n    p = [points[v] for v in cycle]\n    changed = True\n    while changed and len(p) > 2:\n        changed = False\n        for i in range(len(p)):\n            a = sub(p[i], p[i-1])\n            b = sub(p[(i+1) % len(p)], p[i])\n            if parallel(a, b) and dot(a, b) > 0:\n                p.pop(i)\n                changed = True\n                break\n    return p\n\ndef drawn(a, b):\n    v = sub(b, a)\n    length = norm(v)\n    intervals = []\n    for c, d in segments:\n        if abs(cross(sub(c, a), v))/length <= EPS and \\\n           abs(cross(sub(d, a), v))/length <= EPS:\n            x, y = sorted((dot(sub(c, a), v)/dot(v, v),\n                           dot(sub(d, a), v)/dot(v, v)))\n            if y >= 0 and x <= 1:\n                intervals.append((max(0, x), min(1, y)))\n    end = 0.0\n    for x, y in sorted(intervals):\n        if x > end + EPS/length:\n            return False\n        end = max(end, y)\n    return end >= 1-EPS/length\n\ndef has_diagonal(p):\n    n = len(p)\n    return any(drawn(p[i], p[j])\n               for i in range(n) for j in range(i+1, n)\n               if j != i+1 and not (i == 0 and j == n-1))\n\nfound = {}\nfor cycle in cycles:\n    p = corners(cycle)\n    n = len(p)\n    if n < 3:\n        continue\n    edges = [sub(p[(i+1) % n], p[i]) for i in range(n)]\n    turns = [cross(edges[i], edges[(i+1) % n]) for i in range(n)]\n    convex = all(x > 0 for x in turns) or all(x < 0 for x in turns)\n    right = [perpendicular(edges[i-1], edges[i]) for i in range(n)]\n    lengths = [norm(e) for e in edges]\n    equal_sides = max(lengths)-min(lengths) <= EPS*4\n    cosines = [dot(edges[i-1], edges[i]) /\n               (lengths[i-1]*lengths[i]) for i in range(n)]\n    regular = convex and equal_sides and max(cosines)-min(cosines) < 0.00005\n    kinds = []\n    if n == 3:\n        kinds = [4 if any(right) else 3]\n    elif not has_diagonal(p):\n        if n == 4:\n            pairs = sum((parallel(edges[0], edges[2]),\n                         parallel(edges[1], edges[3])))\n            if all(right):\n                kinds = [2 if equal_sides else 1]\n            elif pairs == 2:\n                kinds = [5]\n            elif convex and pairs == 1:\n                kinds = [6]\n        elif n == 5:\n            kinds = [9 if regular else (7 if convex else 8)]\n        elif n == 6 and regular:\n            kinds = [10]\n    for kind in kinds:\n        found.setdefault(kind