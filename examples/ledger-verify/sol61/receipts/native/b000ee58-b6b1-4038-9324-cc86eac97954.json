        if coefficient * factor != 0}\n\ndef subtract(p, q):\n    return add(p, scale(q, -1))\n\ndef multiply(p, q):\n    result = {}\n    for u, x in p.items():\n        for v, y in q.items():\n            powers = tuple(u[i] + v[i] for i in range(3))\n            result[powers] = result.get(powers, Fraction(0)) + x * y\n    return {powers: coefficient for powers, coefficient in result.items()\n            if coefficient != 0}\n\ndef midpoint(P, Q):\n    return tuple(scale(add(p, q), Fraction(1, 2))\n                 for p, q in zip(P, Q))\n\ndef signed_double_area(P, Q, R):\n    ux, uy = (subtract(q, p) for p, q in zip(P, Q))\n    vx, vy = (subtract(r, p) for p, r in zip(P, R))\n    return subtract(multiply(ux, vy), multiply(uy, vx))\n\ndef serialize(poly):\n    return [\n        {\"powers_of_a_b_c\": list(powers), \"coefficient\": str(coefficient)}\n        for powers, coefficient in sorted(poly.items())\n    ]\n\na, b, c = (variable(i) for i in range(3))\nH = (ZERO, ZERO)\nA = (scale(a, -1), ZERO)\nB = (ZERO, b)\nC = (c, ZERO)\n\n# ABH is right at H because BH perpendicular AC.\n# BHD and HDC are right at D because HD perpendicular BC.\n# A right triangle's circumcenter is its hypotenuse midpoint.\nO1 = midpoint(A, B)\nO2 = midpoint(B, H)\nO3 = midpoint(H, C)\n\nnumerator = signed_double_area(O1, O2, O3)\ndenominator = signed_double_area(A, B, H)\n\nif not denominator:\n    print(json.dumps({\"final_answer\": \"UNSUPPORTED\", \"evidence\": {}}))\nelse:\n    term = next(iter(denominator))\n    signed_ratio = numerator.get(term, Fraction(0)) / denominator[term]\n    if numerator != scale(denominator, signed_ratio):\n        print(json.dumps({\"final_answer\": \"UNSUPPORTED\", \"evidence\": {}}))\n    else:\n        print(json.dumps({\n            \"final_answer\": str(abs(signed_ratio)),\n            \"evidence\": {\n                \"parameters\": \"a,b,c>0\",\n                \"circumcenters\": [\n                    \"midpoint(A,B)\",\n                    \"midpoint(B,H)\",\n                    \"midpoint(H,C)\"\n                ],\n                \"signed_double_area_O1O2O3\": serialize(numerator),\n                \"signed_double_area_ABH\": serialize(denominator),\n                \"exact_polynomial_proportionality_verified\": True\n            }\n        }, separators=(\",\", \":\")))\n```"}],"phase":"final_answer","role":"assistant"}],"parallel_tool_calls":true,"presence_penalty":0,"previous_response_id":null,"prompt_cache_key":null,"prompt_cache_retention":"24h","reasoning":{"context":"all_turns","effort":"medium","mode":"standard","summary":null},"safety_identifier":null,"service_tier":"default","store":false,"temperature":1,"text":{"format":{"type":"text"},"verbosity":"medium"},"tool_choice":"auto","tool_usage":{"image_gen":{"input_tokens":0,"input_tokens_details":{"image_tokens":0,"text_tokens":0},"output_tokens":0,"output_tokens_details":{"image_tokens":0,"text_tokens":0},"total_tokens":0},"web_search":{"num_requests":0}},"tools":[],"top_logprobs":0,"top_p":0.98,"truncation":"disabled","usage":{"input_tokens":276,"input_tokens_details":{"cache_write_tokens":0,"cached_tokens":0},"output_tokens":1240,"output_tokens_details":{"reasoning_tokens":423},"total_tokens":1516},"user":null,"metadata":{}}
