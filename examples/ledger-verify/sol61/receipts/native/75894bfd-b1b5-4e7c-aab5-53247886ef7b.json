  constant = abs(remainder[0])\n        candidates = [\n            sign * d\n            for d in range(1, constant + 1)\n            if constant % d == 0\n            for sign in (1, -1)\n        ]\n        root = next(\n            (r for r in candidates if evaluate(remainder, r) == 0),\n            None\n        )\n        if root is None:\n            break\n        factors.append([-root, 1])\n        remainder = divide_by_root(remainder, root)\n    if len(remainder) > 1:\n        factors.append(remainder)\n    else:\n        assert remainder == [1]\n    return factors\n\ndef multiply(p, q):\n    result = [0] * (len(p) + len(q) - 1)\n    for i, a in enumerate(p):\n        for j, b in enumerate(q):\n            result[i + j] += a * b\n    return result\n\ndef reconstruct(factors):\n    result = [1]\n    for factor in factors:\n        result = multiply(result, factor)\n    return result\n\ndef power(variable, exponent):\n    if exponent == 0:\n        return \"\"\n    return variable if exponent == 1 else variable + \"^\" + str(exponent)\n\ndef homogeneous_text(p, x, y):\n    degree = len(p) - 1\n    terms = []\n    for i in range(degree, -1, -1):\n        coefficient = p[i]\n        if coefficient == 0:\n            continue\n        variables = \"*\".join(\n            v for v in (power(x, i), power(y, degree - i)) if v\n        )\n        magnitude = abs(coefficient)\n        body = variables if magnitude == 1 and variables else str(magnitude)\n        if magnitude != 1 and variables:\n            body += \"*\" + variables\n        if not terms:\n            terms.append((\"-\" if coefficient < 0 else \"\") + body)\n        else:\n            terms.append((\" - \" if coefficient < 0 else \" + \") + body)\n    return \"\".join(terms)\n\ndef factor_text(factors, x, y):\n    counts = Counter(tuple(factor) for factor in factors)\n    pieces = []\n    for factor, multiplicity in counts.items():\n        piece = \"(\" + homogeneous_text(factor, x, y) + \")\"\n        if multiplicity > 1:\n            piece += \"^\" + str(multiplicity)\n        pieces.append(piece)\n    return \"*\".join(pieces)\n\noriginals = [[-1, 0, 0, 0, 1], [1, -2, 1]]\nfactorizations = [factor_monic(p) for p in originals]\nchecks = [reconstruct(factors) for factors in factorizations]\n\nif checks != originals:\n    print(\"UNSUPPORTED\")\nelse:\n    answers = [\n        factor_text(factorizations[0], \"a\", \"b\"),\n        factor_text(factorizations[1], \"sqrt(a)\", \"sqrt(b)\")\n    ]\n    print(json.dumps({\n        \"final_answer\": (\n            \"a^4 - b^4 = \" + answers[0] + \"; \"\n            \"a + b - 2*sqrt(a*b) = \" + answers[1]\n        ),\n        \"evidence\": {\n            \"verified_coefficients_ascending\": checks,\n            \"homogenization\": [\n                \"b^4*((a/b)^4 - 1)\",\n                \"y^2*((x/y)^2 - 2*(x/y) + 1)\"\n            ],\n            \"domain\": (\n                \"a,b>0: x=sqrt(a)>0, y=sqrt(b)>0; \"\n                \"x^2=a, y^2=b, xy=sqrt(a*b).\"\n            )\n        }\n    }, separators=(\",\", \":\")))\n```"}],"phase":"final_answer","role":"assistant"}],"parallel_tool_calls":true,"presence_penalty":0,"previous_response_id":null,"prompt_cache_key":null,"prompt_cache_retention":"24h","reasoning":{"context":"all_turns","effort":"medium","mode":"standard","summary":null},"safety_identifier":null,"service_tier":"default","store":false,"temperature":1,"text":{"format":{"type":"text"},"verbosity":"medium"},"tool_choice":"auto","tool_usage":{"image_gen":{"input_tokens":0,"input_tokens_details":{"image_tokens":0,"text_tokens":0},"output_tokens":0,"output_tokens_details":{"image_tokens":0,"text_tokens":0},"total_tokens":0},"web_search":{"num_requests":0}},"tools":[],"top_logprobs":0,"top_p":0.98,"truncation":"disabled","usage":{"input_tokens":193,"input_tokens_details":{"cache_write_tokens":0,"cached_tokens":0},"output_tokens":1364,"output_tokens_details":{"reasoning_tokens":392},"total_tokens":1557},"use