, -1):\n        c = (math.sqrt(p2) + sign * math.sqrt(discriminant)) / 2\n        if c <= 0 or not (abs(a - b) < c < a + b):\n            continue\n\n        cosA = (b2 + c * c - a2) / (2 * b * c)\n        if not -1 <= cosA <= 1:\n            continue\n        A = math.degrees(math.acos(cosA))\n        C = 180 - B - A\n        if C <= 0:\n            continue\n\n        def angle_text(x):\n            nearest = round(x)\n            return str(nearest) if abs(x - nearest) < 1e-10 else f\"{x:.12g}\"\n\n        operator = \"+\" if sign == 1 else \"-\"\n        exact_c = f\"(sqrt({p2}) {operator} sqrt({discriminant}))/2\"\n        solutions.append({\n            \"A\": angle_text(A),\n            \"C\": angle_text(C),\n            \"c_exact\": exact_c,\n            \"c_approx\": c\n        })\n\nif not solutions:\n    print(\"UNSUPPORTED\")\nelse:\n    answer = \" or \".join(\n        f\"A = {s['A']} degrees, C = {s['C']} degrees, c = {s['c_exact']}\"\n        for s in solutions\n    )\n    print(json.dumps({\n        \"final_answer\": answer,\n        \"evidence\": {\n            \"cosine_rule_quadratic\": f\"c^2 - sqrt({p2})*c + {q} = 0\",\n            \"discriminant\": str(discriminant),\n            \"all_positive_triangle_roots\": solutions\n        }\n    }, separators=(\",\", \":\")))\n```"}],"phase":"final_answer","role":"assistant"}],"parallel_tool_calls":true,"presence_penalty":0,"previous_response_id":null,"prompt_cache_key":null,"prompt_cache_retention":"24h","reasoning":{"context":"all_turns","effort":"medium","mode":"standard","summary":null},"safety_identifier":null,"service_tier":"default","store":false,"temperature":1,"text":{"format":{"type":"text"},"verbosity":"medium"},"tool_choice":"auto","tool_usage":{"image_gen":{"input_tokens":0,"input_tokens_details":{"image_tokens":0,"text_tokens":0},"output_tokens":0,"output_tokens_details":{"image_tokens":0,"text_tokens":0},"total_tokens":0},"web_search":{"num_requests":0}},"tools":[],"top_logprobs":0,"top_p