if not b:\n        return str(a)\n    radical = \"sqrt(%d)\" % RAD\n    magnitude = abs(b)\n    term = radical if magnitude == 1 else str(magnitude) + \"*\" + radical\n    if not a:\n        return (\"-\" if b < 0 else \"\") + term\n    return str(a) + (\" + \" if b > 0 else \" - \") + term\n\ntry:\n    p, q = value(9), value(14)\n\n    # With r=xyz, the original objective is\n    # 2p - 2(q^2 + pr)/(pq-r).\n    # Its derivative with respect to r is strictly negative.\n    derivative_numerator = -2 * (9*9*14 + 14*14)\n    assert derivative_numerator < 0\n\n    # Maximize xyz on the compact nonnegative constraint set.\n    # Boundary points have xyz=0. At an interior stationary point,\n    # Lagrange multiplier equations force two variables to coincide.\n    # Setting x=y=a gives 3a^2-18a+14=0.\n    discriminant = 18**2 - 4*3*14\n    assert discriminant == 4*RAD\n    roots = [value(3, F(-1, 3)), value(3, F(1, 3))]\n    feasible = []\n    rejected = []\n\n    for a in roots:\n        b = sub(p, mul(value(2), a))\n        assert add(mul(value(2), a), b) == p\n        assert add(mul(a, a), mul(value(2), mul(a, b))) == q\n        if sign(a) > 0 and sign(b) > 0:\n            feasible.append((a, b, mul(mul(a, a), b)))\n        else:\n            rejected.append({\"repeated\": text(a), \"third\": text(b)})\n\n    assert len(feasible) == 1\n    a, b, r_max = feasible[0]\n    assert sign(r_max) > 0\n\n    denominator = sub(mul(p, q), r_max)\n    assert sign(denominator) > 0\n    answer = sub(\n        mul(value(2), p),\n        div(\n            mul(value(2), add(mul(q, q), mul(p, r_max))),\n            denominator\n        )\n    )\n\n    # Independently evaluate the original three summands.\n    original = value()\n    for u, v in ((a, a), (a, b), (a, b)):\n        original = add(original, div(add(mul(u, u), mul(v, v)), add(u, v)))\n    assert original == answer\n\n    print(json.dumps({\n        \"final_answer\": text(answer),\n        \"evidence\": {\n            \"objective_in_r\": \"(1876-36*r)/(126-r), r=xyz\",\n            \"derivative\": str(derivative_numerator) + \"/(126-r)^2 < 0\",\n            \"maximum_product\": text(r_max),\n            \"attained_at\": [text(a), text(a), text(b)],\n            \"rejected_stationary_branch\": rejected,\n            \"global_argument\": (\n                \"The nonnegative constraint set is compact. Boundary products \"\n                \"are zero, whereas the displayed feasible product is positive. \"\n                \"An interior product maximum has two equal coordinates by \"\n                \"the Lagrange equations; only one such branch is positive.\"\n            ),\n            \"original_expression_exactly_verified\": True\n        }\n    }, separators=(\",\", \":\")))\nexcept Exception:\n    print(json.dumps({\"final_answer\": \"UNSUPPORTED\", \"evidence\": \"Exact computation could not settle the problem.\"},\n                     separators=(\",\", \":\")))\n```"}],"phase":"final_answer","role":"assistant"}],"parallel_tool_calls":true,"presence_penalty":0,"previous_response_id":null,"prompt_cache_key":null,"prompt_cache_retention":"24h","reasoning":{"context":"all_turns","effort":"medium","mode":"standard","summary":null},"safety_identifier":null,"service_tier":"default","store":false,"temperature":1,"text":{"format":{"type":"text"},"verbosity":"medium"},"tool_choice":"auto","tool_usage":{"image_gen":{"input_tokens":0,"input_tokens_details":{"image_tokens":0,"text_tokens":0},"output_tokens":0,"output_tokens_details":{"image_tokens":0,"text_tokens":0},"total_tokens":0},"web_search":{"num_requests":0}},"tools":[],"top_logprobs":0,"top_p":0.98,"truncation":"disabled","usage":{"input_tokens":238,"input_tokens_details":{"cache_write_tokens":0,"cached_tokens":0},"output_tokens":1832,"output_tokens_details":{"reasoning_tokens":703},"total_tokens":2070},"user":null,"metadata":{}}
