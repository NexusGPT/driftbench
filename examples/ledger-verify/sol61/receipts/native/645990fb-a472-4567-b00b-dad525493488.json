p().splitlines():\n    subject, predicate = line.rstrip(\".\").split(\" is \")\n    if predicate.startswith(\"a \"):\n        predicate = predicate[2:]\n        species.add(predicate)\n    else:\n        colors.add(predicate)\n    facts.add((subject, predicate))\n\ntarget = \"Bernhard\"\ncolor_list = sorted(colors)\nmodels = []\n\n# Exhaust every truth assignment to Bernhard's color predicates.\n# All other given facts remain true; there are no inference rules.\nfor bits in itertools.product((False, True), repeat=len(color_list)):\n    assignment = dict(zip(color_list, bits))\n    if all(assignment[color] for color in color_list\n           if (target, color) in facts):\n        models.append({color for color, true in assignment.items() if true})\n\nentailed = sorted(set.intersection(*models)) if models else []\nanswer = entailed[0] if len(entailed) == 1 else \"UNSUPPORTED\"\n\nprint(json.dumps({\n    \"final_answer\": answer,\n    \"evidence\": {\n        \"given_for_Bernhard\": sorted(p for s, p in facts if s == target),\n        \"models_checked\": len(models),\n        \"entailed_colors\": entailed\n    }\n}, separators=(\",\", \":\")))\n```"}],"phase":"final_answer","role":"assistant"}],"parallel_tool_calls":true,"presence_penalty":0,"previous_response_id":null,"prompt_cache_key":null,"prompt_cache_retention":"24h","reasoning":{"context":"all_turns","effort":"medium","mode":"standard","summary":null},"safety_identifier":null,"service_tier":"default","store":false,"temperature":1,"text":{"format":{"type":"text"},"verbosity":"medium"},"tool_choice":"auto","tool_usage":{"image_gen":{"input_tokens":0,"input_tokens_details":{"image_tokens":0,"text_tokens":0},"output_tokens":0,"output_tokens_details":{"image_tokens":0,"text_tokens":0},"total_tokens":0},"web_search":{"num_requests":0}},"tools":[],"top_logprobs":0,"top_p":0.98,"truncation":"disabled","usage":{"input_tokens":204,"input_tokens_details":{"cache_write_tokens":0,"cached_tokens":0},"output_tokens":729,"outpu