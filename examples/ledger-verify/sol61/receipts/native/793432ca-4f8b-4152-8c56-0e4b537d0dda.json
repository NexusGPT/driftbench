n_triples\": triple_multiplicity,\n    \"strict_total_lower_bound\": str(total_lower),\n}\nanswers = []\n\nfor label, k, limit in [(\"a\", 7, Fraction(16)), (\"b\", 5, Fraction(12))]:\n    subset_count = comb(n, k)\n    multiplicity = comb(n - 1, k - 1)\n    total_upper = subset_count * limit / multiplicity\n    details = {\n        \"subset_count\": subset_count,\n        \"occurrences_per_number\": multiplicity,\n        \"strict_total_upper_bound\": str(total_upper),\n    }\n\n    if total_lower >= total_upper:\n        answers.append(\n            f\"{label}) No. Summing all triple inequalities gives \"\n            f\"S > {total_lower}; summing all {k}-number inequalities gives \"\n            f\"S < {total_upper}. These bounds are incompatible.\"\n        )\n        details[\"possible\"] = False\n    else:\n        value = (triple_limit / 3 + limit / k) / 2\n        numbers = [value] * n\n        triples_ok = all(\n            sum(group, Fraction(0)) > triple_limit\n            for group in combinations(numbers, 3)\n        )\n        subsets_ok = all(\n            sum(group, Fraction(0)) < limit\n            for group in combinations(numbers, k)\n        )\n        if not (triples_ok and subsets_ok):\n            print(\"UNSUPPORTED\")\n            raise SystemExit\n\n        answers.append(\n            f\"{label}) Yes. Take all ten numbers equal to {value}. \"\n            f\"Every triple sums to {3 * value} > {triple_limit}, \"\n            f\"and every {k}-number subset sums to {k * value} < {limit}.\"\n        )\n        details.update({\n            \"possible\": True,\n            \"witness_each_number\": str(value),\n            \"triple_sum\": str(3 * value),\n            \"required_subset_sum\": str(k * value),\n            \"all_subsets_verified\": True,\n        })\n\n    evidence[label] = details\n\nprint(json.dumps({\n    \"final_answer\": \" \".join(answers),\n    \"evidence\": evidence,\n}, separators=(\",\", \":\")))\n```"}],"phase":"final_an