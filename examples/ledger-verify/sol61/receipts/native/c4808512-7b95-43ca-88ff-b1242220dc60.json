ef operation(a, op, b):\n    if op == \"+\":\n        return a + b\n    if op == \"-\":\n        return a - b\n    if op == \"*\":\n        return a * b\n    if op == \"&\":\n        return a - b if a * b > 0 else a + b\n    if op == \"!\":\n        return min(a, b) if is_prime(a) or is_prime(b) else max(a, b)\n    if op == \"@\":\n        return operation(a, \"&\", b) if a * b > 0 else a + b\n    if op == \"#\":\n        g = gcd(a, b)\n        return operation(a, \"@\", b) if g == 1 else g\n    raise ValueError(\"Unknown operation: \" + op)\n\ndef evaluate(start, steps):\n    value = start\n    for operators, b in steps:\n        for op in operators:\n            value = operation(value, op, b)\n    return value\n\nA = evaluate(-6, [\n    (\"@\", 6),\n    (\"-&\", 4),\n    (\"--&\", -6),\n    (\"@##\", 1),\n    (\"*!#\", 1),\n    (\"#&\", -3),\n    (\"-!\", -10),\n    (\"&\", -2),\n    (\"*\", 3),\n    (\"*@\", 4),\n    (\"&\", -3),\n    (\"*#\", 10),\n])\n\nB = evaluate(-5, [\n    (\"-\", 9),\n    (\"*\", 3),\n    (\"-+\", -9),\n    (\"#*\", -2),\n    (\"&!#\", 1),\n    (\"#\", -7),\n    (\"-#\", -4),\n    (\"+\", 2),\n    (\"+-\", -3),\n    (\"#*#\", -7),\n    (\"#&\", 5),\n    (\"#\", -6),\n    (\"-&+\", 4),\n    (\"@\", -7),\n    (\"+!-\", -1),\n    (\"#*+\", -3),\n    (\"--\", 2),\n    (\"*\", 2),\n    (\"@\", 2),\n    (\"@-\", -2),\n])\n\nC = evaluate(-8, [\n    (\"#*@\", -9),\n    (\"!#\", 8),\n    (\"@\", -4),\n    (\"**\", -9),\n    (\"!+\", 8),\n    (\"*@\", -1),\n    (\"+!&\", 3),\n    (\"!-#\", 5),\n    (\"+!!\", 10),\n    (\"-\", -6),\n    (\"@+@\", 1),\n    (\"&\", 5),\n])\n\nprint(\"A =\", A)\nprint(\"B =\", B)\nprint(\"C =\", C)\nprint(\"A + B - C =\", A + B - C)\n\n# The submitted work explicitly claims that -6 @ 6 equals -6.\nactual_first_step = operation(-6, \"@\", 6)\nprint(\"Submitted first-step value: -6\")\nprint(\"Actual -6 @ 6 =\", actual_first_step)\nif actual_first_step != -6:\n    print(\"CHECK FAIL: the submitted work contradicts the op