e]\n        # z^degree = z^(degree-6) - z^(degree-12)\n        coefficients[degree - 6] += value\n        coefficients[degree - 12] -= value\n        coefficients[degree] = F(0)\n    return tuple(coefficients[:N])\n\none = constant(1)\nz = (F(0), F(1)) + (F(0),) * (N - 2)\n\npowers = [one]\nfor _ in range(36):\n    powers.append(mul(powers[-1], z))\n\ndef power(exponent):\n    return powers[exponent % 36]\n\ndef cos_degrees(angle):\n    k = angle // 10\n    return scale(add(power(k), power(-k)), F(1, 2))\n\ndef sin_degrees(angle):\n    k = angle // 10\n    difference = add(power(k), scale(power(-k), -1))\n    # i = z^9, so division by i is multiplication by z^-9.\n    return scale(mul(difference, power(-9)), F(1, 2))\n\ncos_product = one\nsin_product = one\nfor angle in (10, 50, 70):\n    cos_product = mul(cos_product, cos_degrees(angle))\n    sin_product = mul(sin_product, sin_degrees(angle))\n\nactual = add(scale(cos_product, 6), sin_product)\nsqrt3 = scale(cos_degrees(30), 2)\nclaimed = scale(add(scale(sqrt3, 6), one), F(1, 8))\n\ndef display(poly):\n    terms = []\n    for exponent, coefficient in enumerate(poly):\n        if coefficient:\n            basis = \"\" if exponent == 0 else f\"*z^{exponent}\"\n            terms.append(f\"({coefficient}){basis}\")\n    return \" + \".join(terms) or \"0\"\n\nprint(\"Exact basis: z = exp(i*pi/18), z^12 - z^6 + 1 = 0\")\nprint(\"Computed value:\", display(actual))\nprint(\"Submitted value:\", display(claimed))\n\n# Independently extract a + b*sqrt(3) from the computed polynomial.\na = actual[0]\nb = actual[3] / sqrt3[3]\nif actual == add(constant(a), scale(sqrt3, b)):\n    print(f\"Computed simplified value: {a} + ({b})*sqrt(3)\")\n\nprint(\"Exact difference:\", display(add(actual, scale(claimed, -1))))\nprint(\"CHECK PASS\" if actual == claimed else \"CHECK FAIL\")\n```"}],"phase":"final_answer","role":"assistant"}],"parallel_tool_calls":true,"presence_penalty":0,"previous_response_id":null,"prompt_cache_key":null,"prom