nd(word[i])\n            i += 1\n    return result\n\ndef roles(tokens):\n    first_vowel = next(i for i, x in enumerate(tokens) if x in vowels)\n    return [\n        \"initial\" if i == 0 and x not in vowels else\n        \"presyllable_vowel\" if i == first_vowel and\n        any(y in vowels for y in tokens[i + 1:]) else\n        \"vowel\" if x in vowels else \"consonant\"\n        for i, x in enumerate(tokens)\n    ]\n\nspecific = defaultdict(Counter)\ngeneral = defaultdict(Counter)\nsources = defaultdict(list)\n\nfor proto, cham in pairs:\n    a, b = tokenize(proto), tokenize(cham)\n    # Only directly aligned pairs are used; no uncertain alignment is imposed.\n    if len(a) != len(b):\n        continue\n    for x, y, role in zip(a, b, roles(a)):\n        specific[(role, x)][y] += 1\n        general[x][y] += 1\n        sources[(role, x, y)].append([proto, cham])\n\ndef unique_mode(counts):\n    if not counts:\n        return None\n    maximum = max(counts.values())\n    winners = [x for x, n in counts.items() if n == maximum]\n    return winners[0] if len(winners) == 1 else None\n\ntarget = tokenize(\"dəpa\")\noutput = []\nevidence = []\n\nfor symbol, role in zip(target, roles(target)):\n    counts = specific.get((role, symbol))\n    scope = role\n    if not counts:\n        counts = general.get(symbol)\n        scope = \"general consonant correspondence\"\n    replacement = unique_mode(counts)\n    if replacement is None:\n        print(\"UNSUPPORTED\")\n        break\n    output.append(replacement)\n    evidence.append({\n        \"from\": symbol,\n        \"to\": replacement,\n        \"scope\": scope,\n        \"counts\": dict(counts)\n    })\nelse:\n    # All supplied syllables beginning with p have an unaccented vowel;\n    # the inferred final syllable therefore requires no grave accent.\n    p_syllables = []\n    for _, cham in pairs:\n        for i, c in enumerate(cham[:-1]):\n            if c == \"p\" and normalize(cham[i + 1]) in vowels:\n                p_syllables.append(cham[i + 1])\n    if not p_syllables or any(\n        unicodedata.combining(c)\n        for vowel in p_syllables\n        for c in unicodedata.normalize(\"NFD\", vowel)\n    ):\n        print(\"UNSUPPORTED\")\n    else:\n        print(json.dumps({\n            \"final_answer\": \"\".join(output),\n            \"evidence\": evidence\n        }, ensure_ascii=False, separators=(\",\", \":\")))\n```"}],"phase":"final_answer","role":"assistant"}],"parallel_tool_calls":true,"presence_penalty":0,"previous_response_id":null,"prompt_cache_key":null,"prompt_cache_retention":"24h","reasoning":{"context":"all_turns","effort":"medium","mode":"standard","summary":null},"safety_identifier":null,"service_tier":"default","store":false,"temperature":1,"text":{"format":{"type":"text"},"verbosity":"medium"},"tool_choice":"auto","tool_usage":{"image_gen":{"input_tokens":0,"input_tokens_details":{"image_tokens":0,"text_tokens":0},"output_tokens":0,"output_tokens_details":{"image_tokens":0,"text_tokens":0},"total_tokens":0},"web_search":{"num_requests":0}},"tools":[],"top_logprobs":0,"top_p":0.98,"truncation":"disabled","usage":{"input_tokens":882,"input_tokens_details":{"cache_write_tokens":0,"cached_tokens":0},"output_tokens":2064,"output_tokens_details":{"reasoning_tokens":1034},"total_tokens":2946},"user":null,"metadata":{}}
