s:\n# initial consonant, unstressed vowel, medial consonant, stressed vowel, coda.\nexamples = [\n    ((\"d\", \"i\", \"k\", \"i\", \"ʔ\"), (\"t\", \"a\", \"k\", \"i\", \"ʔ\")),\n    ((\"d\", \"i\", \"l\", \"a\", \"h\"), (\"t\", \"a\", \"l\", \"à\", \"h\")),\n    ((\"p\", \"a\", \"d\", \"a\", \"m\"), (\"p\", \"a\", \"t\", \"à\", \"m\")),\n    ((\"b\", \"a\", \"l\", \"a\", \"\"),  (\"p\", \"i\", \"l\", \"à\", \"\")),\n    ((\"m\", \"a\", \"s\", \"a\", \"m\"), (\"m\", \"ɨ\", \"th\", \"a\", \"m\")),\n]\n\ntarget = (\"d\", \"a\", \"l\", \"a\", \"m\")  # *dalam\nsubmitted = \"inside\"\n\ndef unique(values):\n    values = set(values)\n    return next(iter(values)) if len(values) == 1 else None\n\n# Initial d becomes t, and its unstressed syllable has vowel a.\ninitial = unique(dst[0] for src, dst in examples if src[0] == \"d\")\nunstressed = unique(dst[1] for src, dst in examples if src[0] == \"d\")\n\n# Medial l remains l.\nmedial = unique(dst[2] for src, dst in examples if src[2] == \"l\")\n\n# After an original voiced stop, stressed a has the grave-accent register.\nvoiced_stops = {\"b\", \"d\", \"j\", \"g\"}\nstressed = unique(\n    dst[3] for src, dst in examples\n    if src[0] in voiced_stops and src[3] == \"a\"\n)\n\n# Final m remains m.\ncoda = unique(dst[4] for src, dst in examples if src[4] == \"m\")\n\nparts = (initial, unstressed, medial, stressed, coda)\nif any(part is None for part in parts):\n    print(\"UNSUPPORTED\")\n    print(\"CHECK UNKNOWN\")\nelse:\n    expected = unicodedata.normalize(\"NFC\", \"\".join(parts))\n    claimed = unicodedata.normalize(\"NFC\", submitted.strip())\n    print(\"Masked (10) is the Phan Rang Cham word, not the meaning.\")\n    print(\"Expected:\", expected)\n    print(\"Submitted:\", claimed)\n    print(\"CHECK PASS\" if claimed == expected else \"CHECK FAIL\")\n```"}],"phase":"final_answer","role":"assistant"}],"parallel_tool_calls":true,"presence_penalty":0,"previous_response_id":null,"prompt_cache_key":null,"prompt_cache_