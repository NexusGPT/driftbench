, 3), root3_half, half),\n    (F(1, 2), one, zero),\n]\n\ndef pi_text(q):\n    if q == 0:\n        return \"0\"\n    sign = \"-\" if q < 0 else \"\"\n    q = abs(q)\n    numerator = \"pi\" if q.numerator == 1 else f\"{q.numerator}*pi\"\n    return sign + numerator + (f\"/{q.denominator}\" if q.denominator != 1 else \"\")\n\n# det(m,n) = sin(x)*(sqrt(3)*sin(x)-cos(x)).\n# sin(x)=0 gives x=0. For sin(x)>0, tan(x)=1/sqrt(3);\n# tan is strictly increasing on (0, pi/2), so there is exactly one root.\nsolutions = [\n    q for q, s, c in table\n    if mul(s, add(mul(root3, s), neg(c))) == zero\n]\nnonzero_solutions = [\n    q for q, s, c in table\n    if s != zero and mul(root3, s) == c\n]\n\n# f = C + A*sin(2x) + B*cos(2x).\nC = half\nA = root3_half\nB = neg(half)\namplitude_squared = add(mul(A, A), mul(B, B))\n\n# f = C + sin(2x-phase): cos(phase)=A, sin(phase)=-B.\nphases = [q for q, s, c in table if c == A and s == neg(B)]\n\nif amplitude_squared != one or len(phases) != 1 or len(nonzero_solutions) != 1:\n    print(json.dumps({\"final_answer\": \"UNSUPPORTED\", \"evidence\": {}}))\nelse:\n    phase = phases[0]\n    frequency = F(2)\n    period = F(2) / frequency\n    # f'(x)=2*cos(2x-phase), positive between successive cosine zeros.\n    left = (phase - F(1, 2)) / frequency\n    right = (phase + F(1, 2)) / frequency\n\n    answer = (\n        \"(1) Under the zero-determinant convention for parallel vectors, x = \"\n        + \" or \".join(pi_text(q) for q in solutions)\n        + \". If parallelism is defined only for nonzero vectors, x = \"\n        + \" or \".join(pi_text(q) for q in nonzero_solutions)\n        + \". (2) The smallest positive period is \"\n        + pi_text(period)\n        + \"; the maximal intervals of monotonic increase are [\"\n        + pi_text(left) + \" + k*pi, \"\n        + pi_text(right) + \" + k*pi], k in Z.\"\n    )\n    print(json.dumps({\n        \"final_answer\": answer,\n        \"evidence\": {\n            \"determinant\": \"sin(x)*(sqrt(3)*sin(x)-cos(x))\",\n            \"zero_vector_at\": \"x=0\",\n            \"f\": \"1/2 + sin(2*x-\" + pi_text(phase) + \")\",\n            \"derivative\": \"2*cos(2*x-\" + pi_text(phase) + \")\",\n            \"amplitude_squared\": str(amplitude_squared[0]),\n            \"period_over_pi\": str(period),\n            \"increasing_endpoints_over_pi\": [str(left), str(right)]\n        }\n    }, separators=(\",\", \":\")))\n```"}],"phase":"final_answer","role":"assistant"}],"parallel_tool_calls":true,"presence_penalty":0,"previous_response_id":null,"prompt_cache_key":null,"prompt_cache_retention":"24h","reasoning":{"context":"all_turns","effort":"medium","mode":"standard","summary":null},"safety_identifier":null,"service_tier":"default","store":false,"temperature":1,"text":{"format":{"type":"text"},"verbosity":"medium"},"tool_choice":"auto","tool_usage":{"image_gen":{"input_tokens":0,"input_tokens_details":{"image_tokens":0,"text_tokens":0},"output_tokens":0,"output_tokens_details":{"image_tokens":0,"text_tokens":0},"total_tokens":0},"web_search":{"num_requests":0}},"tools":[],"top_logprobs":0,"top_p":0.98,"truncation":"disabled","usage":{"input_tokens":266,"input_tokens_details":{"cache_write_tokens":0,"cached_tokens":0},"output_tokens":1413,"output_tokens_details":{"reasoning_tokens":435},"total_tokens":1679},"user":null,"metadata":{}}
