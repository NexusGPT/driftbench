{
  "name": "driftbench-monorepo",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "guard": "node tools/guard/guard.mjs",
    "driftbench": "tsx packages/cli/src/bin.ts",
    "guard:canary": "node tools/guard/guard.mjs --canary",
    "docs:reference": "tsx tools/docs/spec-reference.ts",
    "docs:links": "tsx tools/docs/check-links.ts",
    "docs:site": "vitepress dev docs",
    "docs:site:build": "vitepress build docs",
    "docs:site:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "exceljs": "^4.4.0",
    "playwright-core": "1.63.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitepress": "1.6.4",
    "vitest": "^5.0.3"
  }
}
