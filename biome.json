{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!coverage",
      "!benchmarks/slices",
      "!benchmarks/cassettes",
      "!benchmarks/evidence",
      "!packages/*/coverage",
      "!.worktrees",
      "!.lane-inputs",
      "!docs/lanes",
      "!docs/lane-dag.json",
      "!.github/readme",
      "!comparisons/deepeval/judge/ours-prompts.json",
      "!research/moj/results/sealed/report.json",
      "!research/moj/sealed/freeze.json",
      "!comparisons/inspect/hard/shipped/heldout-480/*-audit.json",
      "!comparisons/inspect/hard/shipped/heldout-480/*-default.json",
      "!comparisons/inspect/hard/shipped/heldout-480/*-theirs.json"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "javascript": { "formatter": { "quoteStyle": "single", "trailingCommas": "all", "semicolons": "always" } },
  "json": { "formatter": { "lineWidth": 110 } },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } }
}
